{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synthesis-finding.schema.json",
  "title": "GSLS 2.1 Synthesis Finding",
  "type": "object",
  "required": [
    "finding_id",
    "title",
    "primary_proposition",
    "primary_anchors",
    "secondary_carriers",
    "lexical_evidence",
    "local_trigger",
    "relation_edges",
    "relational_bridge",
    "primary_effect",
    "counterfactual",
    "linguistic_boundary",
    "local_sense_status",
    "activation_status",
    "lexical_evidence_strength",
    "activation_confidence",
    "narrative_role",
    "epistemic_status",
    "limitations",
    "publication_policy"
  ],
  "properties": {
    "finding_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "primary_proposition": {"type": "string", "minLength": 1},
    "primary_anchors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "secondary_carriers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "lexical_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "local_trigger": {"type": "string", "minLength": 1},
    "relation_edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["edge_type", "source", "target", "basis", "evidence_refs"],
        "properties": {
          "edge_type": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "basis": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "explicit-definition",
                "documented-derivation-or-variant",
                "shared-narrow-concrete-operation",
                "same-dimension-opposition",
                "verified-passage-contact",
                "verified-form",
                "verified-order-or-repetition",
                "verified-backward-reactivation"
              ]
            }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": true
      }
    },
    "relational_bridge": {"type": "string", "minLength": 1},
    "primary_effect": {"type": "string", "minLength": 1},
    "counterfactual": {"type": "string", "minLength": 1},
    "linguistic_boundary": {"type": "string", "minLength": 1},
    "local_sense_status": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": [
          "sense-established",
          "sense-compatible",
          "sense-underdetermined",
          "sense-disfavored",
          "sense-incompatible"
        ]
      }
    },
    "activation_status": {
      "enum": [
        "untriggered",
        "locally-triggered",
        "coalition-triggered",
        "retrospectively-triggered",
        "conditional",
        "defeated"
      ]
    },
    "lexical_evidence_strength": {"enum": ["very-high", "high", "medium", "low"]},
    "activation_confidence": {"enum": ["very-high", "high", "medium", "low"]},
    "narrative_role": {"enum": ["governing", "connective", "supporting", "incidental", "none"]},
    "epistemic_status": {"enum": ["accepted", "pattern-candidate", "conditional", "defeated"]},
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "publication_policy": {
      "enum": ["required-body", "support-only", "notebook-only", "appendix", "exclude-from-publication"]
    }
  },
  "additionalProperties": true
}

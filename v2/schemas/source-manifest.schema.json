{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-manifest.schema.json",
  "title": "GSLS Source Manifest",
  "type": "object",
  "required": [
    "workflow_id",
    "run_id",
    "created_at",
    "sources",
    "prohibited_paths",
    "gold_quarantine"
  ],
  "properties": {
    "workflow_id": {
      "const": "GSLS-3A-2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "gold_quarantine": {
      "const": true
    },
    "prohibited_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "path",
          "source_type",
          "required",
          "evidence_class",
          "version",
          "sha256",
          "access",
          "permitted_agents",
          "contamination_status"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "evidence_class": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "access": {
            "enum": [
              "read-only",
              "read-write-output",
              "prohibited"
            ]
          },
          "permitted_agents": {
            "type": "array",
            "items": {
              "enum": [
                "A",
                "B",
                "C"
              ]
            },
            "uniqueItems": true
          },
          "query_contract": {
            "type": [
              "string",
              "null"
            ]
          },
          "contamination_status": {
            "enum": [
              "clean",
              "quarantined",
              "prohibited"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

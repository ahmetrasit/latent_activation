{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "query-job.schema.json",
  "title": "GSLS Dynamic Query Job",
  "type": "object",
  "required": [
    "workflow_id",
    "run_id",
    "agent_id",
    "schema_version",
    "query_id",
    "cycle_id",
    "source_candidate_ids",
    "open_role",
    "required_relation_types",
    "eligible_scope",
    "evidence_paths",
    "status",
    "source_refs"
  ],
  "properties": {
    "workflow_id": {
      "const": "GSLS-3A-2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "const": "A"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "cycle_id": {
      "type": "integer",
      "minimum": 0
    },
    "source_candidate_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "open_role": {
      "type": "string",
      "minLength": 1
    },
    "required_relation_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "eligible_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "queued",
        "in-progress",
        "completed-no-match",
        "completed-match",
        "pending-evidence",
        "human-adjudication"
      ]
    },
    "result_candidate_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adjudication-record.schema.json",
  "title": "GSLS Agent A Adjudication Record",
  "type": "object",
  "required": [
    "workflow_id",
    "run_id",
    "agent_id",
    "schema_version",
    "action_id",
    "target_id",
    "decision",
    "reason",
    "evidence_refs",
    "candidate_versions_changed",
    "discovery_reopened",
    "resulting_artifacts",
    "source_refs"
  ],
  "properties": {
    "workflow_id": {
      "const": "GSLS-3A-2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "const": "A"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "accepted",
        "accepted-with-modification",
        "rejected",
        "human-adjudication"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "candidate_versions_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "discovery_reopened": {
      "type": "boolean"
    },
    "resulting_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}

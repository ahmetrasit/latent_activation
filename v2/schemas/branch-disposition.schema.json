{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "branch-disposition.schema.json",
  "title": "GSLS Branch Disposition",
  "type": "object",
  "required": [
    "workflow_id",
    "run_id",
    "agent_id",
    "schema_version",
    "root_norm",
    "branch_id",
    "source_id",
    "disposition",
    "reason",
    "tested_activation_channels",
    "finding_ids",
    "source_refs"
  ],
  "properties": {
    "workflow_id": {
      "const": "GSLS-3A-2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "const": "A"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "root_norm": {
      "type": "string",
      "minLength": 1
    },
    "branch_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "disposition": {
      "enum": [
        "used-in-finding",
        "support-only",
        "reviewed-no-distinct-finding",
        "inactive-under-current-evidence",
        "defeated-by-form",
        "pending-evidence",
        "source-blocked"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "tested_activation_channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "local-construction",
          "order",
          "repetition",
          "coalition",
          "role-correspondence",
          "backward-reactivation",
          "primary-anchor-first",
          "branch-seed-first",
          "same-root-transition",
          "cross-root-relation"
        ]
      }
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "inactive-under-current-evidence"
          }
        }
      },
      "then": {
        "properties": {
          "tested_activation_channels": {
            "minItems": 3
          }
        }
      }
    }
  ],
  "additionalProperties": true
}

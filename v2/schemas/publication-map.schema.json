{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "publication-map.schema.json",
  "title": "GSLS Publication Paragraph Map",
  "type": "object",
  "required": [
    "workflow_id",
    "run_id",
    "agent_id",
    "schema_version",
    "paragraph_id",
    "finding_ids",
    "primary_positions",
    "branch_sense_force",
    "activation_force",
    "epistemic_force",
    "limitations_realized",
    "new_claims",
    "source_refs"
  ],
  "properties": {
    "workflow_id": {
      "const": "GSLS-3A-2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "const": "C"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "paragraph_id": {
      "type": "string",
      "minLength": 1
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primary_positions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "branch_sense_force": {
      "type": "string",
      "minLength": 1
    },
    "activation_force": {
      "type": "string",
      "minLength": 1
    },
    "epistemic_force": {
      "type": "string",
      "minLength": 1
    },
    "limitations_realized": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "new_claims": {
      "type": "array",
      "maxItems": 0
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}

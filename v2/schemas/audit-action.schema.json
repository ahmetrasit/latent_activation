{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit-action.schema.json",
  "title": "GSLS Audit Action",
  "type": "object",
  "required": [
    "workflow_id",
    "run_id",
    "agent_id",
    "schema_version",
    "action_id",
    "target_id",
    "verdict",
    "issue_type",
    "severity",
    "required",
    "evidence_refs",
    "reason",
    "proposed_change",
    "reopen_discovery",
    "status",
    "source_refs"
  ],
  "properties": {
    "workflow_id": {
      "const": "GSLS-3A-2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "const": "B"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "keep",
        "revise",
        "split",
        "merge",
        "downgrade",
        "upgrade",
        "strike",
        "add-missed-candidate",
        "human-adjudication"
      ]
    },
    "issue_type": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "blocking",
        "major",
        "minor",
        "note"
      ]
    },
    "required": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "proposed_change": {
      "type": "string",
      "minLength": 1
    },
    "reopen_discovery": {
      "type": "boolean"
    },
    "proposed_candidate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "human_adjudication_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "open",
        "closed"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}

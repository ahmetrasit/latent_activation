{
  "language": "tr",
  "ayat": [
    {"ayah_ref":"44:1","baseline_text":"Hâ Mîm.","target_tokens":[["Hâ",["44:1:1"]],["Mîm",["44:1:1"]]]},
    {"ayah_ref":"44:2","baseline_text":"Apaçık Kitap'a andolsun.","target_tokens":[["Apaçık",["44:2:2"]],["Kitap'a",["44:2:1"]],["andolsun",["44:2:1","44:2:2"]]]},
    {"ayah_ref":"44:3","baseline_text":"Biz onu kutlu bir gecede indirdik. Biz uyarıyorduk.","target_tokens":[["Biz",["44:3:1"]],["onu",["44:3:2"]],["kutlu",["44:3:5"]],["bir",["44:3:4"]],["gecede",["44:3:3","44:3:4"]],["indirdik",["44:3:2"]],["Biz",["44:3:6"]],["uyarıyorduk",["44:3:7","44:3:8"]]]},
    {"ayah_ref":"44:4","baseline_text":"O gecede her hikmetli iş ayrılır.","target_tokens":[["O",["44:4:1"]],["gecede",["44:4:1"]],["her",["44:4:3"]],["hikmetli",["44:4:5"]],["iş",["44:4:4"]],["ayrılır",["44:4:2"]]]},
    {"ayah_ref":"44:5","baseline_text":"Katımızdan bir emir olarak. Biz gönderiyorduk.","target_tokens":[["Katımızdan",["44:5:2","44:5:3"]],["bir",["44:5:1"]],["emir",["44:5:1"]],["olarak",["44:5:1"]],["Biz",["44:5:4"]],["gönderiyorduk",["44:5:5","44:5:6"]]]},
    {"ayah_ref":"44:6","baseline_text":"Rabbinden bir rahmet olarak. Şüphesiz O, işitendir, bilendir.","target_tokens":[["Rabbinden",["44:6:2","44:6:3"]],["bir",["44:6:1"]],["rahmet",["44:6:1"]],["olarak",["44:6:1"]],["Şüphesiz",["44:6:4"]],["O",["44:6:4","44:6:5"]],["işitendir",["44:6:6"]],["bilendir",["44:6:7"]]]},
    {"ayah_ref":"44:7","baseline_text":"Göklerin, yerin ve ikisi arasındakilerin Rabbidir; kesin olarak inanıyorsanız.","target_tokens":[["Göklerin",["44:7:2"]],["yerin",["44:7:3"]],["ve",["44:7:3"]],["ikisi",["44:7:4","44:7:5"]],["arasındakilerin",["44:7:4","44:7:5"]],["Rabbidir",["44:7:1"]],["kesin",["44:7:8"]],["olarak",["44:7:8"]],["inanıyorsanız",["44:7:6","44:7:7","44:7:8"]]]},
    {"ayah_ref":"44:8","baseline_text":"O'ndan başka ilah yoktur. O diriltir ve öldürür; sizin de önceki atalarınızın da Rabbidir.","target_tokens":[["O'ndan",["44:8:3","44:8:4"]],["başka",["44:8:3"]],["ilah",["44:8:2"]],["yoktur",["44:8:1"]],["O",["44:8:4"]],["diriltir",["44:8:5"]],["ve",["44:8:6"]],["öldürür",["44:8:6"]],["sizin",["44:8:7"]],["de",["44:8:7"]],["önceki",["44:8:10"]],["atalarınızın",["44:8:9"]],["da",["44:8:8","44:8:9"]],["Rabbidir",["44:8:7","44:8:8"]]]},
    {"ayah_ref":"44:9","baseline_text":"Hayır, onlar şüphe içinde oynuyorlar.","target_tokens":[["Hayır",["44:9:1"]],["onlar",["44:9:2"]],["şüphe",["44:9:4"]],["içinde",["44:9:3"]],["oynuyorlar",["44:9:5"]]]},
    {"ayah_ref":"44:10","baseline_text":"Göğün apaçık bir duman getireceği günü gözetle.","target_tokens":[["Göğün",["44:10:4"]],["apaçık",["44:10:6"]],["bir",["44:10:5"]],["duman",["44:10:5"]],["getireceği",["44:10:3","44:10:4","44:10:5"]],["günü",["44:10:2"]],["gözetle",["44:10:1"]]]},
    {"ayah_ref":"44:11","baseline_text":"O duman insanları kaplar. Bu acı bir azaptır.","target_tokens":[["O",["44:11:1"]],["duman",["44:11:1"]],["insanları",["44:11:2"]],["kaplar",["44:11:1"]],["Bu",["44:11:3"]],["acı",["44:11:5"]],["bir",["44:11:4"]],["azaptır",["44:11:4"]]]},
    {"ayah_ref":"44:12","baseline_text":"Rabbimiz, azabı üzerimizden kaldır; biz inanıyoruz.","target_tokens":[["Rabbimiz",["44:12:1"]],["azabı",["44:12:4"]],["üzerimizden",["44:12:3"]],["kaldır",["44:12:2"]],["biz",["44:12:5"]],["inanıyoruz",["44:12:6"]]]},
    {"ayah_ref":"44:13","baseline_text":"Onlar nasıl öğüt alacaklar? Oysa kendilerine açıklayan bir elçi gelmişti.","target_tokens":[["Onlar",["44:13:2"]],["nasıl",["44:13:1"]],["öğüt",["44:13:3"]],["alacaklar",["44:13:1","44:13:2","44:13:3"]],["Oysa",["44:13:4"]],["kendilerine",["44:13:5"]],["açıklayan",["44:13:7"]],["bir",["44:13:6"]],["elçi",["44:13:6"]],["gelmişti",["44:13:4","44:13:5"]]]},
    {"ayah_ref":"44:14","baseline_text":"Sonra ondan yüz çevirdiler ve 'Öğretilmiş bir deli!' dediler.","target_tokens":[["Sonra",["44:14:1"]],["ondan",["44:14:3"]],["yüz",["44:14:2"]],["çevirdiler",["44:14:2"]],["ve",["44:14:4"]],["Öğretilmiş",["44:14:5"]],["bir",["44:14:5","44:14:6"]],["deli",["44:14:6"]],["dediler",["44:14:4"]]]},
    {"ayah_ref":"44:15","baseline_text":"Biz azabı kısa bir süre kaldıracağız; siz yine döneceksiniz.","target_tokens":[["Biz",["44:15:1"]],["azabı",["44:15:3"]],["kısa",["44:15:4"]],["bir",["44:15:4"]],["süre",["44:15:4"]],["kaldıracağız",["44:15:2"]],["siz",["44:15:5"]],["yine",["44:15:6"]],["döneceksiniz",["44:15:6"]]]},
    {"ayah_ref":"44:16","baseline_text":"En büyük yakalayışla yakalayacağımız gün, biz öç alacağız.","target_tokens":[["En",["44:16:4"]],["büyük",["44:16:4"]],["yakalayışla",["44:16:3"]],["yakalayacağımız",["44:16:2"]],["gün",["44:16:1"]],["biz",["44:16:5"]],["öç",["44:16:6"]],["alacağız",["44:16:6"]]]},
    {"ayah_ref":"44:17","baseline_text":"Onlardan önce Firavun'un halkını sınamıştık; onlara değerli bir elçi gelmişti.","target_tokens":[["Onlardan",["44:17:3"]],["önce",["44:17:3"]],["Firavun'un",["44:17:5"]],["halkını",["44:17:4"]],["sınamıştık",["44:17:1","44:17:2"]],["onlara",["44:17:6"]],["değerli",["44:17:8"]],["bir",["44:17:7"]],["elçi",["44:17:7"]],["gelmişti",["44:17:6"]]]},
    {"ayah_ref":"44:18","baseline_text":"'Allah'ın kullarını bana teslim edin. Ben size güvenilir bir elçiyim.'","target_tokens":[["Allah'ın",["44:18:5"]],["kullarını",["44:18:4"]],["bana",["44:18:3"]],["teslim",["44:18:1","44:18:2"]],["edin",["44:18:2"]],["Ben",["44:18:6"]],["size",["44:18:7"]],["güvenilir",["44:18:9"]],["bir",["44:18:8"]],["elçiyim",["44:18:8"]]]},
    {"ayah_ref":"44:19","baseline_text":"'Allah'a karşı büyüklük taslamayın. Ben size apaçık bir kanıt getiriyorum.'","target_tokens":[["Allah'a",["44:19:5"]],["karşı",["44:19:4"]],["büyüklük",["44:19:3"]],["taslamayın",["44:19:1","44:19:2","44:19:3"]],["Ben",["44:19:6"]],["size",["44:19:7"]],["apaçık",["44:19:9"]],["bir",["44:19:8"]],["kanıt",["44:19:8"]],["getiriyorum",["44:19:7"]]]},
    {"ayah_ref":"44:20","baseline_text":"'Beni taşlamanızdan Rabbime ve Rabbinize sığındım.'","target_tokens":[["Beni",["44:20:6"]],["taşlamanızdan",["44:20:5","44:20:6"]],["Rabbime",["44:20:3"]],["ve",["44:20:1","44:20:4"]],["Rabbinize",["44:20:4"]],["sığındım",["44:20:1","44:20:2"]]]},
    {"ayah_ref":"44:21","baseline_text":"'Bana inanmıyorsanız benden uzak durun.'","target_tokens":[["Bana",["44:21:4"]],["inanmıyorsanız",["44:21:1","44:21:2","44:21:3"]],["benden",["44:21:5"]],["uzak",["44:21:5"]],["durun",["44:21:5"]]]},
    {"ayah_ref":"44:22","baseline_text":"Bunun üzerine Rabbine, 'Bunlar suç işleyen bir topluluktur,' diye dua etti.","target_tokens":[["Bunun",["44:22:1"]],["üzerine",["44:22:1"]],["Rabbine",["44:22:2"]],["Bunlar",["44:22:4"]],["suç",["44:22:6"]],["işleyen",["44:22:6"]],["bir",["44:22:5"]],["topluluktur",["44:22:5"]],["diye",["44:22:3"]],["dua",["44:22:1"]],["etti",["44:22:1"]]]},
    {"ayah_ref":"44:23","baseline_text":"'Kullarımı geceleyin yola çıkar; peşinize düşülecek.'","target_tokens":[["Kullarımı",["44:23:2"]],["geceleyin",["44:23:3"]],["yola",["44:23:1"]],["çıkar",["44:23:1"]],["peşinize",["44:23:5"]],["düşülecek",["44:23:4","44:23:5"]]]},
    {"ayah_ref":"44:24","baseline_text":"'Denizi olduğu gibi bırak; onlar boğulacak bir ordudur.'","target_tokens":[["Denizi",["44:24:2"]],["olduğu",["44:24:3"]],["gibi",["44:24:3"]],["bırak",["44:24:1"]],["onlar",["44:24:4"]],["boğulacak",["44:24:6"]],["bir",["44:24:5"]],["ordudur",["44:24:5"]]]},
    {"ayah_ref":"44:25","baseline_text":"Geride nice bahçeler ve pınarlar bıraktılar!","target_tokens":[["Geride",["44:25:2"]],["nice",["44:25:1","44:25:3"]],["bahçeler",["44:25:3","44:25:4"]],["ve",["44:25:5"]],["pınarlar",["44:25:5"]],["bıraktılar",["44:25:2"]]]},
    {"ayah_ref":"44:26","baseline_text":"Ekinler ve güzel konaklar!","target_tokens":[["Ekinler",["44:26:1"]],["ve",["44:26:2"]],["güzel",["44:26:3"]],["konaklar",["44:26:2"]]]},
    {"ayah_ref":"44:27","baseline_text":"İçinde zevk sürdükleri nimetler!","target_tokens":[["İçinde",["44:27:3"]],["zevk",["44:27:4"]],["sürdükleri",["44:27:2","44:27:4"]],["nimetler",["44:27:1"]]]},
    {"ayah_ref":"44:28","baseline_text":"İşte böyle oldu. Bunları başka bir topluma miras verdik.","target_tokens":[["İşte",["44:28:1"]],["böyle",["44:28:1"]],["oldu",["44:28:1"]],["Bunları",["44:28:2"]],["başka",["44:28:4"]],["bir",["44:28:3"]],["topluma",["44:28:3"]],["miras",["44:28:2"]],["verdik",["44:28:2"]]]},
    {"ayah_ref":"44:29","baseline_text":"Gök ve yer onların ardından ağlamadı; onlara süre de verilmedi.","target_tokens":[["Gök",["44:29:4"]],["ve",["44:29:5"]],["yer",["44:29:5"]],["onların",["44:29:3"]],["ardından",["44:29:3"]],["ağlamadı",["44:29:1","44:29:2"]],["onlara",["44:29:8"]],["süre",["44:29:8"]],["de",["44:29:6"]],["verilmedi",["44:29:6","44:29:7","44:29:8"]]]},
    {"ayah_ref":"44:30","baseline_text":"İsrailoğullarını aşağılayıcı azaptan kurtarmıştık.","target_tokens":[["İsrailoğullarını",["44:30:3","44:30:4"]],["aşağılayıcı",["44:30:7"]],["azaptan",["44:30:5","44:30:6"]],["kurtarmıştık",["44:30:1","44:30:2"]]]},
    {"ayah_ref":"44:31","baseline_text":"Firavun'dan. O gerçekten üstünlük taslayan ve sınırı aşanlardandı.","target_tokens":[["Firavun'dan",["44:31:1","44:31:2"]],["O",["44:31:3"]],["gerçekten",["44:31:3"]],["üstünlük",["44:31:5"]],["taslayan",["44:31:4","44:31:5"]],["ve",["44:31:6"]],["sınırı",["44:31:7"]],["aşanlardandı",["44:31:6","44:31:7"]]]},
    {"ayah_ref":"44:32","baseline_text":"Onları bilerek bütün halklara üstün seçtik.","target_tokens":[["Onları",["44:32:2"]],["bilerek",["44:32:4"]],["bütün",["44:32:6"]],["halklara",["44:32:6"]],["üstün",["44:32:3","44:32:5"]],["seçtik",["44:32:1","44:32:2"]]]},
    {"ayah_ref":"44:33","baseline_text":"Onlara, içinde apaçık bir sınama bulunan işaretler verdik.","target_tokens":[["Onlara",["44:33:1"]],["içinde",["44:33:5"]],["apaçık",["44:33:7"]],["bir",["44:33:6"]],["sınama",["44:33:6"]],["bulunan",["44:33:4","44:33:5"]],["işaretler",["44:33:2","44:33:3"]],["verdik",["44:33:1"]]]},
    {"ayah_ref":"44:34","baseline_text":"Bunlar kesinlikle şöyle diyorlar:","target_tokens":[["Bunlar",["44:34:2"]],["kesinlikle",["44:34:1","44:34:3"]],["şöyle",["44:34:3"]],["diyorlar",["44:34:3"]]]},
    {"ayah_ref":"44:35","baseline_text":"'İlk ölümümüzden başkası yok; biz yeniden diriltilecek değiliz.'","target_tokens":[["İlk",["44:35:5"]],["ölümümüzden",["44:35:4"]],["başkası",["44:35:1","44:35:2","44:35:3"]],["yok",["44:35:1","44:35:3"]],["biz",["44:35:7"]],["yeniden",["44:35:8"]],["diriltilecek",["44:35:8"]],["değiliz",["44:35:6","44:35:8"]]]},
    {"ayah_ref":"44:36","baseline_text":"'Doğru söylüyorsanız atalarımızı geri getirin.'","target_tokens":[["Doğru",["44:36:5"]],["söylüyorsanız",["44:36:3","44:36:4"]],["atalarımızı",["44:36:2"]],["geri",["44:36:1","44:36:2"]],["getirin",["44:36:1"]]]},
    {"ayah_ref":"44:37","baseline_text":"Onlar mı daha üstün, yoksa Tubba halkı ve onlardan öncekiler mi? Onları yok ettik; çünkü suç işliyorlardı.","target_tokens":[["Onlar",["44:37:1"]],["mı",["44:37:1"]],["daha",["44:37:2"]],["üstün",["44:37:2"]],["yoksa",["44:37:3"]],["Tubba",["44:37:5"]],["halkı",["44:37:4"]],["ve",["44:37:6"]],["onlardan",["44:37:8"]],["öncekiler",["44:37:6","44:37:7","44:37:8"]],["mi",["44:37:1","44:37:3"]],["Onları",["44:37:9"]],["yok",["44:37:9"]],["ettik",["44:37:9"]],["çünkü",["44:37:10"]],["suç",["44:37:12"]],["işliyorlardı",["44:37:11","44:37:12"]]]},
    {"ayah_ref":"44:38","baseline_text":"Gökleri, yeri ve ikisi arasındakileri oyun oynayarak yaratmadık.","target_tokens":[["Gökleri",["44:38:3"]],["yeri",["44:38:4"]],["ve",["44:38:4"]],["ikisi",["44:38:6"]],["arasındakileri",["44:38:5","44:38:6"]],["oyun",["44:38:7"]],["oynayarak",["44:38:7"]],["yaratmadık",["44:38:1","44:38:2"]]]},
    {"ayah_ref":"44:39","baseline_text":"İkisini ancak gerçek bir amaçla yarattık; fakat çoğu bilmiyor.","target_tokens":[["İkisini",["44:39:2"]],["ancak",["44:39:3"]],["gerçek",["44:39:4"]],["bir",["44:39:4"]],["amaçla",["44:39:4"]],["yarattık",["44:39:1","44:39:2"]],["fakat",["44:39:5"]],["çoğu",["44:39:6"]],["bilmiyor",["44:39:7","44:39:8"]]]},
    {"ayah_ref":"44:40","baseline_text":"Karar günü hepsinin belirlenmiş vaktidir.","target_tokens":[["Karar",["44:40:3"]],["günü",["44:40:2"]],["hepsinin",["44:40:5"]],["belirlenmiş",["44:40:4"]],["vaktidir",["44:40:1","44:40:4"]]]},
    {"ayah_ref":"44:41","baseline_text":"O gün hiçbir dost başka bir dosta hiçbir fayda sağlayamaz ve onlara yardım edilmez.","target_tokens":[["O",["44:41:1"]],["gün",["44:41:1"]],["hiçbir",["44:41:2","44:41:4"]],["dost",["44:41:4"]],["başka",["44:41:6"]],["bir",["44:41:6"]],["dosta",["44:41:5","44:41:6"]],["hiçbir",["44:41:7"]],["fayda",["44:41:3","44:41:7"]],["sağlayamaz",["44:41:2","44:41:3"]],["ve",["44:41:8"]],["onlara",["44:41:9"]],["yardım",["44:41:10"]],["edilmez",["44:41:8","44:41:10"]]]},
    {"ayah_ref":"44:42","baseline_text":"Ancak Allah'ın merhamet ettiği kimse bunun dışındadır. Şüphesiz O güçlüdür, merhametlidir.","target_tokens":[["Ancak",["44:42:1"]],["Allah'ın",["44:42:4"]],["merhamet",["44:42:3"]],["ettiği",["44:42:3"]],["kimse",["44:42:2"]],["bunun",["44:42:1"]],["dışındadır",["44:42:1"]],["Şüphesiz",["44:42:5"]],["O",["44:42:5","44:42:6"]],["güçlüdür",["44:42:7"]],["merhametlidir",["44:42:8"]]]},
    {"ayah_ref":"44:43","baseline_text":"Şüphesiz zakkum ağacı","target_tokens":[["Şüphesiz",["44:43:1"]],["zakkum",["44:43:3"]],["ağacı",["44:43:2"]]]},
    {"ayah_ref":"44:44","baseline_text":"günahkârın yemeğidir.","target_tokens":[["günahkârın",["44:44:2"]],["yemeğidir",["44:44:1"]]]},
    {"ayah_ref":"44:45","baseline_text":"Erimiş maden gibi karınlarda kaynar,","target_tokens":[["Erimiş",["44:45:1"]],["maden",["44:45:1"]],["gibi",["44:45:1"]],["karınlarda",["44:45:3","44:45:4"]],["kaynar",["44:45:2"]]]},
    {"ayah_ref":"44:46","baseline_text":"kaynar suyun kaynaması gibi.","target_tokens":[["kaynar",["44:46:2"]],["suyun",["44:46:2"]],["kaynaması",["44:46:1"]],["gibi",["44:46:1"]]]},
    {"ayah_ref":"44:47","baseline_text":"'Onu tutun ve cehennemin ortasına sürükleyin.'","target_tokens":[["Onu",["44:47:1"]],["tutun",["44:47:1"]],["ve",["44:47:2"]],["cehennemin",["44:47:5"]],["ortasına",["44:47:4"]],["sürükleyin",["44:47:2","44:47:3"]]]},
    {"ayah_ref":"44:48","baseline_text":"'Sonra başının üstüne azap verici kaynar sudan dökün.'","target_tokens":[["Sonra",["44:48:1"]],["başının",["44:48:4"]],["üstüne",["44:48:3"]],["azap",["44:48:6"]],["verici",["44:48:6"]],["kaynar",["44:48:7"]],["sudan",["44:48:5","44:48:7"]],["dökün",["44:48:2"]]]},
    {"ayah_ref":"44:49","baseline_text":"'Tat! Gerçekten sen güçlüsün, saygınsın.'","target_tokens":[["Tat",["44:49:1"]],["Gerçekten",["44:49:2"]],["sen",["44:49:2","44:49:3"]],["güçlüsün",["44:49:4"]],["saygınsın",["44:49:5"]]]},
    {"ayah_ref":"44:50","baseline_text":"'İşte bu, hakkında şüphe ettiğiniz şeydir.'","target_tokens":[["İşte",["44:50:1","44:50:2"]],["bu",["44:50:2"]],["hakkında",["44:50:5"]],["şüphe",["44:50:6"]],["ettiğiniz",["44:50:4","44:50:6"]],["şeydir",["44:50:3"]]]},
    {"ayah_ref":"44:51","baseline_text":"Allah'a karşı gelmekten sakınanlar güvenli bir yerdedir.","target_tokens":[["Allah'a",["44:51:2"]],["karşı",["44:51:2"]],["gelmekten",["44:51:2"]],["sakınanlar",["44:51:2"]],["güvenli",["44:51:5"]],["bir",["44:51:4"]],["yerdedir",["44:51:1","44:51:3","44:51:4"]]]},
    {"ayah_ref":"44:52","baseline_text":"Bahçeler ve pınarlar içindedirler.","target_tokens":[["Bahçeler",["44:52:2"]],["ve",["44:52:3"]],["pınarlar",["44:52:3"]],["içindedirler",["44:52:1"]]]},
    {"ayah_ref":"44:53","baseline_text":"Karşılıklı olarak ince ve kalın ipek giyerler.","target_tokens":[["Karşılıklı",["44:53:5"]],["olarak",["44:53:5"]],["ince",["44:53:3"]],["ve",["44:53:4"]],["kalın",["44:53:4"]],["ipek",["44:53:2","44:53:3","44:53:4"]],["giyerler",["44:53:1"]]]},
    {"ayah_ref":"44:54","baseline_text":"İşte böyle. Onları iri gözlü hurilerle eşleştirdik.","target_tokens":[["İşte",["44:54:1"]],["böyle",["44:54:1"]],["Onları",["44:54:2"]],["iri",["44:54:4"]],["gözlü",["44:54:4"]],["hurilerle",["44:54:3"]],["eşleştirdik",["44:54:2"]]]},
    {"ayah_ref":"44:55","baseline_text":"Orada güven içinde her türlü meyveyi isterler.","target_tokens":[["Orada",["44:55:2"]],["güven",["44:55:5"]],["içinde",["44:55:5"]],["her",["44:55:3"]],["türlü",["44:55:3"]],["meyveyi",["44:55:4"]],["isterler",["44:55:1"]]]},
    {"ayah_ref":"44:56","baseline_text":"Orada ilk ölümlerinden başka ölüm tatmazlar. Ve O, onları cehennem azabından korumuştur.","target_tokens":[["Orada",["44:56:3"]],["ilk",["44:56:7"]],["ölümlerinden",["44:56:6","44:56:7"]],["başka",["44:56:5"]],["ölüm",["44:56:4"]],["tatmazlar",["44:56:1","44:56:2"]],["Ve",["44:56:8"]],["O",["44:56:8"]],["onları",["44:56:8"]],["cehennem",["44:56:10"]],["azabından",["44:56:9","44:56:10"]],["korumuştur",["44:56:8"]]]},
    {"ayah_ref":"44:57","baseline_text":"Rabbinden bir lütuf olarak. İşte bu büyük başarıdır.","target_tokens":[["Rabbinden",["44:57:2","44:57:3"]],["bir",["44:57:1"]],["lütuf",["44:57:1"]],["olarak",["44:57:1"]],["İşte",["44:57:4"]],["bu",["44:57:4","44:57:5"]],["büyük",["44:57:7"]],["başarıdır",["44:57:6"]]]},
    {"ayah_ref":"44:58","baseline_text":"Onu senin dilinle kolaylaştırdık ki öğüt alsınlar.","target_tokens":[["Onu",["44:58:2"]],["senin",["44:58:3"]],["dilinle",["44:58:3"]],["kolaylaştırdık",["44:58:1","44:58:2"]],["ki",["44:58:4"]],["öğüt",["44:58:5"]],["alsınlar",["44:58:4","44:58:5"]]]},

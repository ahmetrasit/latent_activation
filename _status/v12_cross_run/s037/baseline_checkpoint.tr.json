    {"ayah_ref":"37:53","baseline_text":"Ölüp toprak ve kemik olduğumuzda gerçekten hesaba mı çekileceğiz?", "target_tokens":[["Ölüp",["37:53:1","37:53:2"]],["toprak",["37:53:4"]],["ve",["37:53:3","37:53:5"]],["kemik",["37:53:5"]],["olduğumuzda",["37:53:1","37:53:3"]],["gerçekten",["37:53:6","37:53:7"]],["hesaba",["37:53:7"]],["mı",["37:53:6"]],["çekileceğiz",["37:53:7"]]]},

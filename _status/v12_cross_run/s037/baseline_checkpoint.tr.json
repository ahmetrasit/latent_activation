    {"ayah_ref":"37:27","baseline_text":"Birbirlerine dönüp karşılıklı sorular sorarlar.","target_tokens":[["Birbirlerine",["37:27:2","37:27:3","37:27:4"]],["dönüp",["37:27:1"]],["karşılıklı",["37:27:5"]],["sorular",["37:27:5"]],["sorarlar",["37:27:5"]]]},
    {"ayah_ref":"37:28","baseline_text":"Siz bize sağ taraftan gelirdiniz, derler.","target_tokens":[["Siz",["37:28:2"]],["bize",["37:28:4"]],["sağ",["37:28:6"]],["taraftan",["37:28:5","37:28:6"]],["gelirdiniz",["37:28:3","37:28:4"]],["derler",["37:28:1"]]]},

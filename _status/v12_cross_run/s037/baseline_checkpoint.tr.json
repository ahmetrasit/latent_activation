    {"ayah_ref":"37:2","baseline_text":"Ardından güçlü biçimde engelleyenlere andolsun.","target_tokens":[["Ardından",["37:2:1"]],["güçlü",["37:2:2"]],["biçimde",["37:2:2"]],["engelleyenlere",["37:2:1"]],["andolsun",["37:2:1"]]]},
    {"ayah_ref":"37:3","baseline_text":"Ardından anmayı okuyanlara andolsun.","target_tokens":[["Ardından",["37:3:1"]],["anmayı",["37:3:2"]],["okuyanlara",["37:3:1"]],["andolsun",["37:3:1"]]]},
    {"ayah_ref":"37:4","baseline_text":"Sizin ilahınız kesinlikle birdir.","target_tokens":[["Sizin",["37:4:2"]],["ilahınız",["37:4:2"]],["kesinlikle",["37:4:1","37:4:3"]],["birdir",["37:4:3"]]]},
    {"ayah_ref":"37:5","baseline_text":"O, göklerin, yerin, ikisi arasındakilerin ve doğuş yerlerinin Rabbidir.","target_tokens":[["O",["37:5:1"]],["göklerin",["37:5:2"]],["yerin",["37:5:3"]],["ikisi",["37:5:5"]],["arasındakilerin",["37:5:4","37:5:5"]],["ve",["37:5:6"]],["doğuş",["37:5:7"]],["yerlerinin",["37:5:7"]],["Rabbidir",["37:5:1","37:5:6"]]]},

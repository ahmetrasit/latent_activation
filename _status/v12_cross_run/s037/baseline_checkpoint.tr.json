    {"ayah_ref":"37:15","baseline_text":"Bu apaçık bir büyüden başka bir şey değil, dediler.","target_tokens":[["Bu",["37:15:3"]],["apaçık",["37:15:6"]],["bir",["37:15:5"]],["büyüden",["37:15:5"]],["başka",["37:15:2","37:15:4"]],["bir",["37:15:2","37:15:4"]],["şey",["37:15:2","37:15:4"]],["değil",["37:15:2","37:15:4"]],["dediler",["37:15:1"]]]},
    {"ayah_ref":"37:16","baseline_text":"Ölüp toprak ve kemik olduğumuzda gerçekten yeniden diriltilecek miyiz?", "target_tokens":[["Ölüp",["37:16:1","37:16:2"]],["toprak",["37:16:4"]],["ve",["37:16:3","37:16:5"]],["kemik",["37:16:5"]],["olduğumuzda",["37:16:1","37:16:3"]],["gerçekten",["37:16:6","37:16:7"]],["yeniden",["37:16:7"]],["diriltilecek",["37:16:7"]],["miyiz",["37:16:6"]]]},

    {"ayah_ref":"37:34","baseline_text":"Biz suç işleyenlere böyle yaparız.","target_tokens":[["Biz",["37:34:1"]],["suç",["37:34:4"]],["işleyenlere",["37:34:4"]],["böyle",["37:34:2"]],["yaparız",["37:34:3"]]]},
    {"ayah_ref":"37:35","baseline_text":"Onlara, Allah'tan başka ilah yoktur, denildiğinde büyüklük taslarlardı.","target_tokens":[["Onlara",["37:35:5"]],["Allah'tan",["37:35:9"]],["başka",["37:35:8"]],["ilah",["37:35:7"]],["yoktur",["37:35:6"]],["denildiğinde",["37:35:3","37:35:4"]],["büyüklük",["37:35:10"]],["taslarlardı",["37:35:1","37:35:2","37:35:10"]]]},
    {"ayah_ref":"37:36","baseline_text":"Deli bir şair uğruna ilahlarımızı mı bırakacağız, diyorlardı.","target_tokens":[["Deli",["37:36:6"]],["bir",["37:36:5"]],["şair",["37:36:5"]],["uğruna",["37:36:5"]],["ilahlarımızı",["37:36:4"]],["mı",["37:36:2"]],["bırakacağız",["37:36:3"]],["diyorlardı",["37:36:1"]]]},

    {"ayah_ref":"37:11","baseline_text":"Onlara sor: Yaratılışça kendileri mi daha güçlü, yoksa bizim yarattıklarımız mı? Biz onları yapışkan bir çamurdan yarattık.","target_tokens":[["Onlara",["37:11:1"]],["sor",["37:11:1"]],["Yaratılışça",["37:11:4"]],["kendileri",["37:11:2"]],["mi",["37:11:2"]],["daha",["37:11:3"]],["güçlü",["37:11:3"]],["yoksa",["37:11:5"]],["bizim",["37:11:7"]],["yarattıklarımız",["37:11:6","37:11:7"]],["mı",["37:11:5"]],["Biz",["37:11:8"]],["onları",["37:11:9"]],["yapışkan",["37:11:12"]],["bir",["37:11:11"]],["çamurdan",["37:11:10","37:11:11"]],["yarattık",["37:11:9"]]]},
    {"ayah_ref":"37:12","baseline_text":"Aksine sen şaşırdın, onlar ise alay ediyorlar.","target_tokens":[["Aksine",["37:12:1"]],["sen",["37:12:2"]],["şaşırdın",["37:12:2"]],["onlar",["37:12:3"]],["ise",["37:12:3"]],["alay",["37:12:3"]],["ediyorlar",["37:12:3"]]]},

    {"ayah_ref":"37:58","baseline_text":"Artık biz ölmeyecek miyiz?", "target_tokens":[["Artık",["37:58:1"]],["biz",["37:58:2"]],["ölmeyecek",["37:58:1","37:58:3"]],["miyiz",["37:58:1"]]]},
    {"ayah_ref":"37:59","baseline_text":"Yalnızca ilk ölümümüzü yaşadık ve azaba uğratılmayacağız, öyle mi?", "target_tokens":[["Yalnızca",["37:59:1"]],["ilk",["37:59:3"]],["ölümümüzü",["37:59:2"]],["yaşadık",["37:59:1","37:59:2"]],["ve",["37:59:4"]],["azaba",["37:59:6"]],["uğratılmayacağız",["37:59:4","37:59:5","37:59:6"]],["öyle",["37:59:5"]],["mi",["37:59:5"]]]},
    {"ayah_ref":"37:60","baseline_text":"Şüphesiz bu, büyük başarıdır.","target_tokens":[["Şüphesiz",["37:60:1","37:60:3"]],["bu",["37:60:2"]],["büyük",["37:60:5"]],["başarıdır",["37:60:4"]]]},
    {"ayah_ref":"37:61","baseline_text":"Çalışanlar böylesi için çalışsın.","target_tokens":[["Çalışanlar",["37:61:4"]],["böylesi",["37:61:1","37:61:2"]],["için",["37:61:1"]],["çalışsın",["37:61:3"]]]},
    {"ayah_ref":"37:62","baseline_text":"Konukluk olarak bu mu daha iyidir, yoksa zakkum ağacı mı?", "target_tokens":[["Konukluk",["37:62:3"]],["olarak",["37:62:3"]],["bu",["37:62:1"]],["mu",["37:62:1"]],["daha",["37:62:2"]],["iyidir",["37:62:2"]],["yoksa",["37:62:4"]],["zakkum",["37:62:6"]],["ağacı",["37:62:5"]],["mı",["37:62:4"]]]},
    {"ayah_ref":"37:63","baseline_text":"Biz onu haksızlık edenler için bir sınama yaptık.","target_tokens":[["Biz",["37:63:1"]],["onu",["37:63:2"]],["haksızlık",["37:63:4"]],["edenler",["37:63:4"]],["için",["37:63:4"]],["bir",["37:63:3"]],["sınama",["37:63:3"]],["yaptık",["37:63:2"]]]},
    {"ayah_ref":"37:64","baseline_text":"O, cehennemin dibinden çıkan bir ağaçtır.","target_tokens":[["O",["37:64:1"]],["cehennemin",["37:64:6"]],["dibinden",["37:64:4","37:64:5"]],["çıkan",["37:64:3"]],["bir",["37:64:2"]],["ağaçtır",["37:64:2"]]]},
    {"ayah_ref":"37:65","baseline_text":"Tomurcukları sanki şeytanların başlarıdır.","target_tokens":[["Tomurcukları",["37:65:1"]],["sanki",["37:65:2"]],["şeytanların",["37:65:4"]],["başlarıdır",["37:65:3"]]]},
    {"ayah_ref":"37:66","baseline_text":"Onlar ondan mutlaka yiyecek ve karınlarını onunla dolduracaklar.","target_tokens":[["Onlar",["37:66:1"]],["ondan",["37:66:3"]],["mutlaka",["37:66:2"]],["yiyecek",["37:66:2"]],["ve",["37:66:4"]],["karınlarını",["37:66:6"]],["onunla",["37:66:5"]],["dolduracaklar",["37:66:4"]]]},
    {"ayah_ref":"37:67","baseline_text":"Sonra bunun üzerine onlar için kaynar sudan bir karışım vardır.","target_tokens":[["Sonra",["37:67:1"]],["bunun",["37:67:4"]],["üzerine",["37:67:4"]],["onlar",["37:67:3"]],["için",["37:67:2","37:67:3"]],["kaynar",["37:67:7"]],["sudan",["37:67:6","37:67:7"]],["bir",["37:67:5"]],["karışım",["37:67:5"]],["vardır",["37:67:2"]]]},
    {"ayah_ref":"37:68","baseline_text":"Sonra dönüşleri kesinlikle cehennemedir.","target_tokens":[["Sonra",["37:68:1"]],["dönüşleri",["37:68:3"]],["kesinlikle",["37:68:2","37:68:4"]],["cehennemedir",["37:68:4","37:68:5"]]]},
    {"ayah_ref":"37:69","baseline_text":"Çünkü onlar atalarını sapmış halde buldular.","target_tokens":[["Çünkü",["37:69:1"]],["onlar",["37:69:1"]],["atalarını",["37:69:3"]],["sapmış",["37:69:4"]],["halde",["37:69:4"]],["buldular",["37:69:2"]]]},
    {"ayah_ref":"37:70","baseline_text":"Bunun üzerine onların izlerinden hızla götürülüyorlar.","target_tokens":[["Bunun",["37:70:1"]],["üzerine",["37:70:1"]],["onların",["37:70:3"]],["izlerinden",["37:70:2","37:70:3"]],["hızla",["37:70:4"]],["götürülüyorlar",["37:70:4"]]]},
    {"ayah_ref":"37:71","baseline_text":"Onlardan önce, eskilerin çoğu da sapmıştı.","target_tokens":[["Onlardan",["37:71:3"]],["önce",["37:71:3"]],["eskilerin",["37:71:5"]],["çoğu",["37:71:4"]],["da",["37:71:1"]],["sapmıştı",["37:71:2"]]]},
    {"ayah_ref":"37:72","baseline_text":"Biz onların arasına uyarıcılar göndermiştik.","target_tokens":[["Biz",["37:72:2"]],["onların",["37:72:3"]],["arasına",["37:72:3"]],["uyarıcılar",["37:72:4"]],["göndermiştik",["37:72:1","37:72:2"]]]},
    {"ayah_ref":"37:73","baseline_text":"Uyarılanların sonunun nasıl olduğuna bak.","target_tokens":[["Uyarılanların",["37:73:5"]],["sonunun",["37:73:4"]],["nasıl",["37:73:2"]],["olduğuna",["37:73:3"]],["bak",["37:73:1"]]]},
    {"ayah_ref":"37:74","baseline_text":"Ancak Allah'ın içten bağlı kulları hariç.","target_tokens":[["Ancak",["37:74:1"]],["Allah'ın",["37:74:3"]],["içten",["37:74:4"]],["bağlı",["37:74:4"]],["kulları",["37:74:2"]],["hariç",["37:74:1"]]]},
    {"ayah_ref":"37:75","baseline_text":"Nuh bize seslenmişti; ona ne güzel karşılık verdik!", "target_tokens":[["Nuh",["37:75:3"]],["bize",["37:75:2"]],["seslenmişti",["37:75:1","37:75:2"]],["ona",["37:75:5"]],["ne",["37:75:4"]],["güzel",["37:75:4"]],["karşılık",["37:75:5"]],["verdik",["37:75:5"]]]},
    {"ayah_ref":"37:76","baseline_text":"Onu ve ailesini büyük sıkıntıdan kurtardık.","target_tokens":[["Onu",["37:76:1"]],["ve",["37:76:2"]],["ailesini",["37:76:2"]],["büyük",["37:76:5"]],["sıkıntıdan",["37:76:3","37:76:4"]],["kurtardık",["37:76:1"]]]},
    {"ayah_ref":"37:77","baseline_text":"Yalnız onun soyunu kalıcı kıldık.","target_tokens":[["Yalnız",["37:77:3"]],["onun",["37:77:2"]],["soyunu",["37:77:2"]],["kalıcı",["37:77:4"]],["kıldık",["37:77:1"]]]},
    {"ayah_ref":"37:78","baseline_text":"Sonrakiler arasında onun için bir anma bıraktık.","target_tokens":[["Sonrakiler",["37:78:4"]],["arasında",["37:78:3","37:78:4"]],["onun",["37:78:2"]],["için",["37:78:2"]],["bir",["37:78:1"]],["anma",["37:78:1"]],["bıraktık",["37:78:1"]]]},
    {"ayah_ref":"37:79","baseline_text":"Bütün varlıklar arasında Nuh'a selam olsun.","target_tokens":[["Bütün",["37:79:5"]],["varlıklar",["37:79:5"]],["arasında",["37:79:4"]],["Nuh'a",["37:79:2","37:79:3"]],["selam",["37:79:1"]],["olsun",["37:79:1"]]]},
    {"ayah_ref":"37:80","baseline_text":"İyilik yapanları işte böyle ödüllendiririz.","target_tokens":[["İyilik",["37:80:4"]],["yapanları",["37:80:4"]],["işte",["37:80:2"]],["böyle",["37:80:2"]],["ödüllendiririz",["37:80:1","37:80:3"]]]},
    {"ayah_ref":"37:81","baseline_text":"Çünkü o, inanan kullarımızdandı.","target_tokens":[["Çünkü",["37:81:1"]],["o",["37:81:1"]],["inanan",["37:81:4"]],["kullarımızdandı",["37:81:2","37:81:3"]]]},
    {"ayah_ref":"37:82","baseline_text":"Sonra diğerlerini suda boğduk.","target_tokens":[["Sonra",["37:82:1"]],["diğerlerini",["37:82:3"]],["suda",["37:82:2"]],["boğduk",["37:82:2"]]]},
    {"ayah_ref":"37:83","baseline_text":"Şüphesiz İbrahim de onun yolundan gidenlerdendi.","target_tokens":[["Şüphesiz",["37:83:1","37:83:4"]],["İbrahim",["37:83:4"]],["de",["37:83:1"]],["onun",["37:83:3"]],["yolundan",["37:83:3"]],["gidenlerdendi",["37:83:2","37:83:3"]]]},
    {"ayah_ref":"37:84","baseline_text":"Hani Rabbine temiz bir kalple gelmişti.","target_tokens":[["Hani",["37:84:1"]],["Rabbine",["37:84:3"]],["temiz",["37:84:5"]],["bir",["37:84:4"]],["kalple",["37:84:4"]],["gelmişti",["37:84:2"]]]},
    {"ayah_ref":"37:85","baseline_text":"Hani babasına ve halkına, Neye kulluk ediyorsunuz, demişti.","target_tokens":[["Hani",["37:85:1"]],["babasına",["37:85:3"]],["ve",["37:85:4"]],["halkına",["37:85:4"]],["Neye",["37:85:5"]],["kulluk",["37:85:6"]],["ediyorsunuz",["37:85:6"]],["demişti",["37:85:2"]]]},
    {"ayah_ref":"37:86","baseline_text":"Allah'ın dışında uydurma tanrılar mı istiyorsunuz?", "target_tokens":[["Allah'ın",["37:86:4"]],["dışında",["37:86:3"]],["uydurma",["37:86:1"]],["tanrılar",["37:86:2"]],["mı",["37:86:1"]],["istiyorsunuz",["37:86:5"]]]},
    {"ayah_ref":"37:87","baseline_text":"Bütün varlıkların Rabbi hakkında ne sanıyorsunuz?", "target_tokens":[["Bütün",["37:87:4"]],["varlıkların",["37:87:4"]],["Rabbi",["37:87:3"]],["hakkında",["37:87:3"]],["ne",["37:87:1"]],["sanıyorsunuz",["37:87:2"]]]},
    {"ayah_ref":"37:88","baseline_text":"Sonra yıldızlara bir kez baktı.","target_tokens":[["Sonra",["37:88:1"]],["yıldızlara",["37:88:3","37:88:4"]],["bir",["37:88:2"]],["kez",["37:88:2"]],["baktı",["37:88:1"]]]},
    {"ayah_ref":"37:89","baseline_text":"Ben hastayım, dedi.","target_tokens":[["Ben",["37:89:2"]],["hastayım",["37:89:3"]],["dedi",["37:89:1"]]]},
    {"ayah_ref":"37:90","baseline_text":"Bunun üzerine sırt çevirip ondan uzaklaştılar.","target_tokens":[["Bunun",["37:90:1"]],["üzerine",["37:90:1"]],["sırt",["37:90:3"]],["çevirip",["37:90:3"]],["ondan",["37:90:2"]],["uzaklaştılar",["37:90:1"]]]},
    {"ayah_ref":"37:91","baseline_text":"Sonra gizlice tanrılarına yönelip, Yemiyor musunuz, dedi.","target_tokens":[["Sonra",["37:91:1"]],["gizlice",["37:91:1"]],["tanrılarına",["37:91:2","37:91:3"]],["yönelip",["37:91:1"]],["Yemiyor",["37:91:5","37:91:6"]],["musunuz",["37:91:5"]],["dedi",["37:91:4"]]]},
    {"ayah_ref":"37:92","baseline_text":"Size ne oldu da konuşmuyorsunuz?", "target_tokens":[["Size",["37:92:2"]],["ne",["37:92:1"]],["oldu",["37:92:1","37:92:2"]],["da",["37:92:2"]],["konuşmuyorsunuz",["37:92:3","37:92:4"]]]},
    {"ayah_ref":"37:93","baseline_text":"Sonra sağ eliyle vurarak üzerlerine yürüdü.","target_tokens":[["Sonra",["37:93:1"]],["sağ",["37:93:4"]],["eliyle",["37:93:4"]],["vurarak",["37:93:3"]],["üzerlerine",["37:93:2"]],["yürüdü",["37:93:1"]]]},
    {"ayah_ref":"37:94","baseline_text":"Bunun üzerine koşarak ona geldiler.","target_tokens":[["Bunun",["37:94:1"]],["üzerine",["37:94:1"]],["koşarak",["37:94:3"]],["ona",["37:94:2"]],["geldiler",["37:94:1"]]]},
    {"ayah_ref":"37:95","baseline_text":"Yonttuğunuz şeylere mi kulluk ediyorsunuz, dedi.","target_tokens":[["Yonttuğunuz",["37:95:4"]],["şeylere",["37:95:3"]],["mi",["37:95:2"]],["kulluk",["37:95:2"]],["ediyorsunuz",["37:95:2"]],["dedi",["37:95:1"]]]},
    {"ayah_ref":"37:96","baseline_text":"Oysa sizi de yaptıklarınızı da Allah yarattı.","target_tokens":[["Oysa",["37:96:1"]],["sizi",["37:96:2"]],["de",["37:96:2"]],["yaptıklarınızı",["37:96:3","37:96:4"]],["da",["37:96:3"]],["Allah",["37:96:1"]],["yarattı",["37:96:2"]]]},
    {"ayah_ref":"37:97","baseline_text":"Onun için bir yapı kurun, sonra onu alevli ateşe atın, dediler.","target_tokens":[["Onun",["37:97:3"]],["için",["37:97:3"]],["bir",["37:97:4"]],["yapı",["37:97:4"]],["kurun",["37:97:2"]],["sonra",["37:97:5"]],["onu",["37:97:5"]],["alevli",["37:97:7"]],["ateşe",["37:97:6","37:97:7"]],["atın",["37:97:5"]],["dediler",["37:97:1"]]]},
    {"ayah_ref":"37:98","baseline_text":"Ona bir tuzak kurmak istediler; biz de onları en aşağıdakiler yaptık.","target_tokens":[["Ona",["37:98:2"]],["bir",["37:98:3"]],["tuzak",["37:98:3"]],["kurmak",["37:98:1"]],["istediler",["37:98:1"]],["biz",["37:98:4"]],["de",["37:98:4"]],["onları",["37:98:4"]],["en",["37:98:5"]],["aşağıdakiler",["37:98:5"]],["yaptık",["37:98:4"]]]},
    {"ayah_ref":"37:99","baseline_text":"Ben Rabbime gidiyorum; o bana yol gösterecek, dedi.","target_tokens":[["Ben",["37:99:2"]],["Rabbime",["37:99:4","37:99:5"]],["gidiyorum",["37:99:3"]],["o",["37:99:6"]],["bana",["37:99:6"]],["yol",["37:99:6"]],["gösterecek",["37:99:6"]],["dedi",["37:99:1"]]]},
    {"ayah_ref":"37:100","baseline_text":"Rabbim, bana iyilerden birini bağışla.","target_tokens":[["Rabbim",["37:100:1"]],["bana",["37:100:3"]],["iyilerden",["37:100:4","37:100:5"]],["birini",["37:100:4","37:100:5"]],["bağışla",["37:100:2"]]]},
    {"ayah_ref":"37:101","baseline_text":"Biz de ona yumuşak huylu bir oğlan müjdeledik.","target_tokens":[["Biz",["37:101:1"]],["de",["37:101:1"]],["ona",["37:101:1"]],["yumuşak",["37:101:3"]],["huylu",["37:101:3"]],["bir",["37:101:2"]],["oğlan",["37:101:2"]],["müjdeledik",["37:101:1"]]]},
    {"ayah_ref":"37:102","baseline_text":"Çocuk onunla birlikte çalışabilecek çağa gelince, Oğlum, rüyamda seni boğazladığımı görüyorum; bak, ne düşünürsün, dedi. O da, Babacığım, emredildiğin şeyi yap. Allah isterse beni sabredenlerden bulacaksın, dedi.","target_tokens":[["Çocuk",["37:102:2"]],["onunla",["37:102:3"]],["birlikte",["37:102:3"]],["çalışabilecek",["37:102:4"]],["çağa",["37:102:4"]],["gelince",["37:102:1","37:102:2"]],["Oğlum",["37:102:6"]],["rüyamda",["37:102:9","37:102:10"]],["seni",["37:102:12"]],["boğazladığımı",["37:102:11","37:102:12"]],["görüyorum",["37:102:7","37:102:8"]],["bak",["37:102:13"]],["ne",["37:102:14"]],["düşünürsün",["37:102:15"]],["dedi",["37:102:5"]],["O",["37:102:16"]],["da",["37:102:16"]],["Babacığım",["37:102:17"]],["emredildiğin",["37:102:20"]],["şeyi",["37:102:19"]],["yap",["37:102:18"]],["Allah",["37:102:24"]],["isterse",["37:102:22","37:102:23"]],["beni",["37:102:21"]],["sabredenlerden",["37:102:25","37:102:26"]],["bulacaksın",["37:102:21"]],["dedi",["37:102:16"]]]},
    {"ayah_ref":"37:103","baseline_text":"İkisi teslim olup onu alnı üzerine yatırınca...", "target_tokens":[["İkisi",["37:103:2"]],["teslim",["37:103:2"]],["olup",["37:103:1","37:103:2"]],["onu",["37:103:3"]],["alnı",["37:103:4"]],["üzerine",["37:103:4"]],["yatırınca",["37:103:3"]]]},
    {"ayah_ref":"37:104","baseline_text":"Ona şöyle seslendik: Ey İbrahim!", "target_tokens":[["Ona",["37:104:1"]],["şöyle",["37:104:2"]],["seslendik",["37:104:1"]],["Ey",["37:104:3"]],["İbrahim",["37:104:3"]]]},
    {"ayah_ref":"37:105","baseline_text":"Rüyayı doğruladın. Biz iyilik yapanları işte böyle ödüllendiririz.","target_tokens":[["Rüyayı",["37:105:3"]],["doğruladın",["37:105:1","37:105:2"]],["Biz",["37:105:4"]],["iyilik",["37:105:7"]],["yapanları",["37:105:7"]],["işte",["37:105:5"]],["böyle",["37:105:5"]],["ödüllendiririz",["37:105:6"]]]},
    {"ayah_ref":"37:106","baseline_text":"Bu, apaçık sınamanın ta kendisiydi.","target_tokens":[["Bu",["37:106:2"]],["apaçık",["37:106:5"]],["sınamanın",["37:106:4"]],["ta",["37:106:1","37:106:3"]],["kendisiydi",["37:106:1","37:106:3"]]]},
    {"ayah_ref":"37:107","baseline_text":"Onu büyük bir kurbanlıkla kurtardık.","target_tokens":[["Onu",["37:107:1"]],["büyük",["37:107:3"]],["bir",["37:107:2"]],["kurbanlıkla",["37:107:2"]],["kurtardık",["37:107:1"]]]},
    {"ayah_ref":"37:108","baseline_text":"Sonrakiler arasında onun için bir anma bıraktık.","target_tokens":[["Sonrakiler",["37:108:4"]],["arasında",["37:108:3","37:108:4"]],["onun",["37:108:2"]],["için",["37:108:2"]],["bir",["37:108:1"]],["anma",["37:108:1"]],["bıraktık",["37:108:1"]]]},
    {"ayah_ref":"37:109","baseline_text":"İbrahim'e selam olsun.","target_tokens":[["İbrahim'e",["37:109:2","37:109:3"]],["selam",["37:109:1"]],["olsun",["37:109:1"]]]},
    {"ayah_ref":"37:110","baseline_text":"İyilik yapanları işte böyle ödüllendiririz.","target_tokens":[["İyilik",["37:110:3"]],["yapanları",["37:110:3"]],["işte",["37:110:1"]],["böyle",["37:110:1"]],["ödüllendiririz",["37:110:2"]]]},
    {"ayah_ref":"37:111","baseline_text":"Çünkü o, inanan kullarımızdandı.","target_tokens":[["Çünkü",["37:111:1"]],["o",["37:111:1"]],["inanan",["37:111:4"]],["kullarımızdandı",["37:111:2","37:111:3"]]]},
    {"ayah_ref":"37:112","baseline_text":"Ona, iyilerden bir peygamber olacak İshak'ı müjdeledik.","target_tokens":[["Ona",["37:112:1"]],["iyilerden",["37:112:4","37:112:5"]],["bir",["37:112:3"]],["peygamber",["37:112:3"]],["olacak",["37:112:3"]],["İshak'ı",["37:112:2"]],["müjdeledik",["37:112:1"]]]},
    {"ayah_ref":"37:113","baseline_text":"Ona ve İshak'a bereket verdik. İkisinin soyundan iyilik yapan da kendisine açıkça haksızlık eden de vardır.","target_tokens":[["Ona",["37:113:2"]],["ve",["37:113:3"]],["İshak'a",["37:113:4"]],["bereket",["37:113:1"]],["verdik",["37:113:1"]],["İkisinin",["37:113:6"]],["soyundan",["37:113:5","37:113:6"]],["iyilik",["37:113:7"]],["yapan",["37:113:7"]],["da",["37:113:8"]],["kendisine",["37:113:9"]],["açıkça",["37:113:10"]],["haksızlık",["37:113:8","37:113:9"]],["eden",["37:113:8"]],["de",["37:113:8"]],["vardır",["37:113:7","37:113:8"]]]},

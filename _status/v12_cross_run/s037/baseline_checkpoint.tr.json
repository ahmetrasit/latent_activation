    {"ayah_ref":"37:177","baseline_text":"Azap alanlarına indiğinde, uyarılanların sabahı ne kötü olur!", "target_tokens":[["Azap",["37:177:2"]],["alanlarına",["37:177:3"]],["indiğinde",["37:177:1","37:177:2"]],["uyarılanların",["37:177:6"]],["sabahı",["37:177:5"]],["ne",["37:177:4"]],["kötü",["37:177:4"]],["olur",["37:177:4"]]]},
    {"ayah_ref":"37:178","baseline_text":"Bir süreye kadar onlardan yüz çevir.","target_tokens":[["Bir",["37:178:4"]],["süreye",["37:178:4"]],["kadar",["37:178:3"]],["onlardan",["37:178:2"]],["yüz",["37:178:1"]],["çevir",["37:178:1"]]]},
    {"ayah_ref":"37:179","baseline_text":"Gözetle; yakında onlar da görecekler.","target_tokens":[["Gözetle",["37:179:1"]],["yakında",["37:179:2"]],["onlar",["37:179:3"]],["da",["37:179:3"]],["görecekler",["37:179:3"]]]},
    {"ayah_ref":"37:180","baseline_text":"Senin Rabbin, güç sahibi Rab, onların nitelediklerinden uzaktır.","target_tokens":[["Senin",["37:180:2"]],["Rabbin",["37:180:2"]],["güç",["37:180:4"]],["sahibi",["37:180:4"]],["Rab",["37:180:3"]],["onların",["37:180:6"]],["nitelediklerinden",["37:180:5","37:180:6"]],["uzaktır",["37:180:1"]]]},
    {"ayah_ref":"37:181","baseline_text":"Gönderilen elçilere selam olsun.","target_tokens":[["Gönderilen",["37:181:3"]],["elçilere",["37:181:2","37:181:3"]],["selam",["37:181:1"]],["olsun",["37:181:1"]]]},
    {"ayah_ref":"37:182","baseline_text":"Övgü, bütün varlıkların Rabbi Allah'a aittir.","target_tokens":[["Övgü",["37:182:1"]],["bütün",["37:182:4"]],["varlıkların",["37:182:4"]],["Rabbi",["37:182:3"]],["Allah'a",["37:182:2"]],["aittir",["37:182:1","37:182:2"]]]}

    {"ayah_ref":"37:18","baseline_text":"De ki: Evet, hem de aşağılanmış olarak.","target_tokens":[["De",["37:18:1"]],["ki",["37:18:1"]],["Evet",["37:18:2"]],["hem",["37:18:3"]],["de",["37:18:3"]],["aşağılanmış",["37:18:4"]],["olarak",["37:18:4"]]]},
    {"ayah_ref":"37:19","baseline_text":"O yalnızca tek bir haykırıştır; birdenbire bakakalırlar.","target_tokens":[["O",["37:19:2"]],["yalnızca",["37:19:1"]],["tek",["37:19:4"]],["bir",["37:19:3"]],["haykırıştır",["37:19:3"]],["birdenbire",["37:19:5"]],["bakakalırlar",["37:19:6","37:19:7"]]]},
    {"ayah_ref":"37:20","baseline_text":"Eyvah bize! Bu, karşılık günüdür, derler.","target_tokens":[["Eyvah",["37:20:2"]],["bize",["37:20:2"]],["Bu",["37:20:3"]],["karşılık",["37:20:5"]],["günüdür",["37:20:4"]],["derler",["37:20:1"]]]},

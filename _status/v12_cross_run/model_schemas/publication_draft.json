{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {"const": "v12-cross-run-publication-draft-v2"},
    "surah": {"type": "integer", "minimum": 1, "maximum": 114},
    "ayat": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ayah_ref": {"type": "string", "pattern": "^[1-9][0-9]*:[0-9]+$"},
          "findings": {
            "type": "array",
            "items": {"$ref": "#/$defs/finding"}
          }
        },
        "required": ["ayah_ref", "findings"]
      }
    }
  },
  "required": ["protocol", "surah", "ayat"],
  "$defs": {
    "anchorKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^a-s[0-9]{3}-[0-9]{4}$"}
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "grade": {"enum": ["strong", "weak", "reject"]},
        "anchors": {"$ref": "#/$defs/anchorKeys"}
      },
      "required": ["text", "grade", "anchors"]
    }
  }
}

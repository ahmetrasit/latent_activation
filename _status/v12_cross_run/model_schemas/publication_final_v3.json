{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {"const": "v12-cross-run-publication-v3"},
    "language": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "surah": {"type": "integer", "minimum": 1, "maximum": 114},
    "ayat": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ayah_ref": {"type": "string", "pattern": "^[1-9][0-9]*:[0-9]+$"},
          "baseline": {"$ref": "#/$defs/baseline"},
          "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
        },
        "required": ["ayah_ref", "baseline", "findings"]
      }
    }
  },
  "required": ["protocol", "language", "surah", "ayat"],
  "$defs": {
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ref": {"type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"},
        "text": {"type": "string", "minLength": 1},
        "target_tokens": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/targetToken"}
        }
      },
      "required": [
        "source_ref",
        "text",
        "target_tokens"
      ]
    },
    "targetToken": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"type": "string", "minLength": 1},
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[1-9][0-9]*:[1-9][0-9]*:[1-9][0-9]*$"
          }
        }
      ],
      "items": false
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "string", "pattern": "^[1-9][0-9]*:[0-9]+:[0-9]+$"},
          {"type": "string", "pattern": "^root_[0-9]{6}$"},
          {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^B[0-9]{3}$"}
          }
        ],
        "items": false,
        "minItems": 3,
        "maxItems": 3
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "grade": {"enum": ["strong", "weak", "reject"]},
        "anchors": {"$ref": "#/$defs/anchors"}
      },
      "required": ["text", "grade", "anchors"]
    }
  }
}

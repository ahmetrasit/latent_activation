{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {"const": "v12-cross-run-publication-v2"},
    "surah": {"type": "integer", "minimum": 1, "maximum": 114},
    "ayat": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ayah_ref": {"type": "string", "pattern": "^[1-9][0-9]*:[0-9]+$"},
          "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
        },
        "required": ["ayah_ref", "findings"]
      }
    }
  },
  "required": ["protocol", "surah", "ayat"],
  "$defs": {
    "anchors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "string", "pattern": "^[1-9][0-9]*:[0-9]+:[0-9]+$"},
          {"type": "string", "pattern": "^root_[0-9]{6}$"},
          {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^B[0-9]{3}$"}
          }
        ],
        "items": false,
        "minItems": 3,
        "maxItems": 3
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "grade": {"enum": ["strong", "weak", "reject"]},
        "anchors": {"$ref": "#/$defs/anchors"}
      },
      "required": ["text", "grade", "anchors"]
    }
  }
}

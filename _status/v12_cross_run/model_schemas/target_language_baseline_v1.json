{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "ayat": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/ayah"}
    }
  },
  "required": ["language", "ayat"],
  "$defs": {
    "qacWordRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]*:[1-9][0-9]*:[1-9][0-9]*$"
      }
    },
    "targetToken": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"type": "string", "minLength": 1},
        {"$ref": "#/$defs/qacWordRefs"}
      ],
      "items": false
    },
    "ayah": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ayah_ref": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "baseline_text": {"type": "string", "minLength": 1},
        "target_tokens": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/targetToken"}
        }
      },
      "required": ["ayah_ref", "baseline_text", "target_tokens"]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "publication_role": {
            "type": "string",
            "enum": ["primary", "secondary", "exploratory", "evidence_only", "none"]
          },
          "disposition": {
            "type": "string",
            "enum": ["accepted", "evidence_only", "deferred", "rejected", "conflict"]
          },
          "decision_reason": {"type": "string", "minLength": 1}
        },
        "required": [
          "claim_id",
          "publication_role",
          "disposition",
          "decision_reason"
        ]
      }
    }
  },
  "required": ["decisions"]
}

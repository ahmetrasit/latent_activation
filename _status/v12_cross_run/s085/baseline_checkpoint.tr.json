{"language":"tr","ayat":[{"ayah_ref":"85:1","baseline_text":"Burçlu göğe andolsun.","target_tokens":[["Burçlu",["85:1:2","85:1:3"]],["göğe",["85:1:1"]],["andolsun",["85:1:1"]]]},{"ayah_ref":"85:2","baseline_text":"Vadedilmiş güne andolsun.","target_tokens":[["Vadedilmiş",["85:2:2"]],["güne",["85:2:1"]],["andolsun",["85:2:1"]]]},{"ayah_ref":"85:3","baseline_text":"Tanıklık edene ve tanıklık edilene andolsun.","target_tokens":[["Tanıklık",["85:3:1"]],["edene",["85:3:1"]],["ve",["85:3:2"]],["tanıklık",["85:3:2"]],["edilene",["85:3:2"]],["andolsun",["85:3:1","85:3:2"]]]},{"ayah_ref":"85:4","baseline_text":"Hendek sahipleri öldürüldü.","target_tokens":[["Hendek",["85:4:3"]],["sahipleri",["85:4:2"]],["öldürüldü",["85:4:1"]]]},{"ayah_ref":"85:5","baseline_text":"Yakıt dolu ateşin.","target_tokens":[["Yakıt",["85:5:3"]],["dolu",["85:5:2","85:5:3"]],["ateşin",["85:5:1"]]]},{"ayah_ref":"85:6","baseline_text":"Hani onlar onun başında oturuyorlardı.","target_tokens":[["Hani",["85:6:1"]],["onlar",["85:6:2"]],["onun",["85:6:3"]],["başında",["85:6:3"]],["oturuyorlardı",["85:6:4"]]]},{"ayah_ref":"85:7","baseline_text":"Onlar da inananlara yaptıklarına tanıktılar.","target_tokens":[["Onlar",["85:7:1"]],["da",["85:7:1"]],["inananlara",["85:7:5"]],["yaptıklarına",["85:7:2","85:7:3","85:7:4"]],["tanıktılar",["85:7:6"]]]},{"ayah_ref":"85:8","baseline_text":"Onlardan sırf güçlü ve övgüye layık Allah'a inandıkları için öç aldılar.","target_tokens":[["Onlardan",["85:8:3"]],["sırf",["85:8:1","85:8:4"]],["güçlü",["85:8:8"]],["ve",["85:8:8","85:8:9"]],["övgüye",["85:8:9"]],["layık",["85:8:9"]],["Allah'a",["85:8:7"]],["inandıkları",["85:8:5","85:8:6"]],["için",["85:8:5"]],["öç",["85:8:2"]],["aldılar",["85:8:2"]]]},{"ayah_ref":"85:9","baseline_text":"Göklerin ve yerin egemenliği O'nundur; Allah her şeye tanıktır.","target_tokens":[["Göklerin",["85:9:4"]],["ve",["85:9:5"]],["yerin",["85:9:5"]],["egemenliği",["85:9:3"]],["O'nundur",["85:9:1","85:9:2"]],["Allah",["85:9:6"]],["her",["85:9:8"]],["şe
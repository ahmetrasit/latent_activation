85:15:3"]]]},{"ayah_ref":"85:16","baseline_text":"Dilediğini yapar.","target_tokens":[["Dilediğini",["85:16:2","85:16:3"]],["yapar",["85:16:1"]]]},{"ayah_ref":"85:17","baseline_text":"Orduların haberi sana geldi mi?","target_tokens":[["Orduların",["85:17:4"]],["haberi",["85:17:3"]],["sana",["85:17:2"]],["geldi",["85:17:2"]],["mi",["85:17:1"]]]},{"ayah_ref":"85:18","baseline_text":"Firavun'un ve Semud'un?","target_tokens":[["Firavun'un",["85:18:1"]],["ve",["85:18:2"]],["Semud'un",["85:18:2"]]]},{"ayah_ref":"85:19","baseline_text":"Hayır, inkâr edenler yalanlama içindedir.","target_tokens":[["Hayır",["85:19:1"]],["inkâr",["85:19:3"]],["edenler",["85:19:2","85:19:3"]],["yalanlama",["85:19:5"]],["içindedir",["85:19:4"]]]},{"ayah_ref":"85:20","baseline_text":"Allah ise onları arkalarından kuşatmıştır.","target_tokens":[["Allah",["85:20:1"]],["ise",["85:20:1"]],["onları",["85:20:3"]],["arkalarından",["85:20:2","85:20:3"]],["kuşatmıştır",["85:20:4"]]]},{"ayah_ref":"85:21","baseline_text":"Aksine, o yüce bir Kur'an'dır.","target_tokens":[["Aksine",["85:21:1"]],["o",["85:21:2"]],["yüce",["85:21:4"]],["bir",["85:21:3"]],["Kur'an'dır",["85:21:3"]]]},{"ayah_ref":"85:22","baseline_text":"Korunmuş bir levhadadır.","target_tokens":[["Korunmuş",["85:22:3"]],["bir",["85:22:2"]],["levhadadır",["85:22:1","85:22:2"]]]}]}

{"language":"tr","ayat":[{"ayah_ref":"70:1","baseline_text":"Bir soran, gerçekleşecek azabı sordu.","target_tokens":[["Bir",["70:1:2"]],["soran",["70:1:2"]],["gerçekleşecek",["70:1:4"]],["azabı",["70:1:3"]],["sordu",["70:1:1"]]]},{"ayah_ref":"70:2","baseline_text":"İnkâr edenler için; onu savan yoktur.","target_tokens":[["İnkâr",["70:2:1"]],["edenler",["70:2:1"]],["için",["70:2:1"]],["onu",["70:2:3"]],["savan",["70:2:4"]],["yoktur",["70:2:2"]]]},{"ayah_ref":"70:3","baseline_text":"Yükseliş yollarının sahibi Allah'tandır.","target_tokens":[["Yükseliş",["70:3:4"]],["yollarının",["70:3:4"]],["sahibi",["70:3:3"]],["Allah'tandır",["70:3:1","70:3:2"]]]},{"ayah_ref":"70:4","baseline_text":"Melekler ve Ruh O'na, süresi elli bin yıl olan bir günde yükselir.","target_tokens":[["Melekler",["70:4:2"]],["ve",["70:4:3"]],["Ruh",["70:4:3"]],["O'na",["70:4:4"]],["süresi",["70:4:7","70:4:8"]],["elli",["70:4:9"]],["bin",["70:4:10"]],["yıl",["70:4:11"]],["olan",["70:4:7"]],["bir",["70:4:6"]],["günde",["70:4:5","70:4:6"]],["yükselir",["70:4:1"]]]},{"ayah_ref":"70:5","baseline_text":"Öyleyse güzelce sabret.","target_tokens":[["Öyleyse",["70:5:1"]],["güzelce",["70:5:2","70:5:3"]],["sabret",["70:5:1","70:5:2"]]]},{"ayah_ref":"70:6","baseline_text":"Onlar onu uzak görürler.","target_tokens":[["Onlar",["70:6:1"]],["onu",["70:6:2"]],["uzak",["70:6:3"]],["görürler",["70:6:2"]]]},{"ayah_ref":"70:7","baseline_text":"Biz ise onu yakın görürüz.","target_tokens":[["Biz",["70:7:1"]],["ise",["70:7:1"]],["onu",["70:7:1"]],["yakın",["70:7:2"]],["görürüz",["70:7:1"]]]},{"ayah_ref":"70:8","baseline_text":"O gün gök erimiş maden gibi olur.","target_tokens":[["O",["70:8:1"]],["gün",["70:8:1"]],["gök",["70:8:3"]],["erimiş",["70:8:4"]],["maden",["70:8:4"]],["gibi",["70:8:4"]],["olur",["70:8:2"]]]},{"ayah_ref":"70:9","baseline_text":"Dağlar da renkli yün gibi olur.","target_tokens":[["Dağlar",["70:9:2"]],["da",["70:9:1"]],["renkli",["70:9:3"]],["yün",["70:9:3"]],["gibi",["70:9:3"]],["olur",["70:9:1"]]]},{"ayah_ref":"70:10","baseline_text":"Yakın bir dost, yakın dostunu sormaz.","target_tokens":[["Yakın",["70:10:3"]],["bir",["70:10:3"]],["dost",["70:10:3"]],["yakın",["70:10:4"]],["dostunu",["70:10:4"]],["sormaz",["70:10:1","70:10:2"]]]},{"ayah_ref":"70:11","baseline_text":"Birbirlerine gösterilirler. Suçlu, o günün azabından kendini oğullarıyla kurtarmayı ister.","target_tokens":[["Birbirlerine",["70:11:1"]],["gösterilirler",["70:11:1"]],["Suçlu",["70:11:3"]],["o",["70:11:8"]],["günün",["70:11:8"]],["azabından",["70:11:6","70:11:7"]],["kendini",["70:11:5"]],["oğullarıyla",["70:11:9"]],["kurtarmayı",["70:11:5"]],["ister",["70:11:2","70:11:4"]]]},{"ayah_ref":"70:12","baseline_text":"Eşini ve kardeşini de,","target_tokens":[["Eşini",["70:12:1"]],["ve",["70:12:2"]],["kardeşini",["70:12:2"]],["de",["70:12:1","70:12:2"]]]},{"ayah_ref":"70:13","baseline_text":"kendisini barındıran ailesini de,","target_tokens":[["kendisini",["70:13:3"]],["barındıran",["70:13:2","70:13:3"]],["ailesini",["70:13:1"]],["de",["70:13:1"]]]},{"ayah_ref":"70:14","baseline_text":"ve yeryüzündeki herkesi; sonra bu onu kurtarsa.","target_tokens":[["ve",["70:14:1"]],["yeryüzündeki",["70:14:2","70:14:3"]],["herkesi",["70:14:1","70:14:4"]],["sonra",["70:14:5"]],["bu",["70:14:5"]],["onu",["70:14:6"]],["kurtarsa",["70:14:6"]]]},{"ayah_ref":"70:15","baseline_text":"Hayır! O, kavurucu bir ateştir.","target_tokens":[["Hayır",["70:15:1"]],["O",["70:15:2"]],["kavurucu",["70:15:3"]],["bir",["70:15:3"]],["ateştir",["70:15:3"]]]},{"ayah_ref":"70:16","baseline_text":"Uzuvları söküp çıkarır.","target_tokens":[["Uzuvları",["70:16:2"]],["söküp",["70:16:1"]],["çıkarır",["70:16:1"]]]},{"ayah_ref":"70:17","baseline_text":"Arkasını dönüp yüz çevireni çağırır.","target_tokens":[["Arkasını",["70:17:3"]],["dönüp",["70:17:3"]],["yüz",["70:17:4"]],["çevireni",["70:17:4"]],["çağırır",["70:17:1","70:17:2"]]]},{"ayah_ref":"70:18","baseline_text":"Toplayıp yığanı da.","target_tokens":[["Toplayıp",["70:18:1"]],["yığanı",["70:18:2"]],[
{"language":"tr","ayat":[{"ayah_ref":"72:1","baseline_text":"De ki: Bana, cinlerden bir topluluğun dinlediği vahyedildi. Onlar şöyle dediler: Biz gerçekten şaşırtıcı bir Kur'an dinledik.","target_tokens":[["De",["72:1:1"]],["ki",["72:1:1"]],["Bana",["72:1:3"]],["cinlerden",["72:1:7","72:1:8"]],["bir",["72:1:6"]],["topluluğun",["72:1:6"]],["dinlediği",["72:1:5"]],["vahyedildi",["72:1:2","72:1:4"]],["Onlar",["72:1:9"]],["şöyle",["72:1:9"]],["dediler",["72:1:9"]],["Biz",["72:1:10"]],["gerçekten",["72:1:10"]],["şaşırtıcı",["72:1:13"]],["bir",["72:1:12"]],["Kur'an",["72:1:12"]],["dinledik",["72:1:11"]]]},{"ayah_ref":"72:2","baseline_text":"O, doğru yola iletiyor; biz de ona inandık. Rabbimize asla hiç kimseyi ortak koşmayacağız.","target_tokens":[["O",["72:2:1"]],["doğru",["72:2:3"]],["yola",["72:2:2","72:2:3"]],["iletiyor",["72:2:1"]],["biz",["72:2:4"]],["de",["72:2:4"]],["ona",["72:2:5"]],["inandık",["72:2:4"]],["Rabbimize",["72:2:8"]],["asla",["72:2:6"]],["hiç",["72:2:6","72:2:9"]],["kimseyi",["72:2:9"]],["ortak",["72:2:7"]],["koşmayacağız",["72:2:6","72:2:7"]]]},{"ayah_ref":"72:3","baseline_text":"Rabbimizin yüceliği çok üstündür. O, ne bir eş ne de bir çocuk edinmiştir.","target_tokens":[["Rabbimizin",["72:3:4"]],["yüceliği",["72:3:3"]],["çok",["72:3:2"]],["üstündür",["72:3:1","72:3:2"]],["O",["72:3:1"]],["ne",["72:3:5"]],["bir",["72:3:7"]],["eş",["72:3:7"]],["ne",["72:3:8"]],["de",["72:3:8"]],["bir",["72:3:9"]],["çocuk",["72:3:9"]],["edinmiştir",["72:3:6"]]]},{"ayah_ref":"72:4","baseline_text":"Bizim akılsızımız Allah hakkında haddi aşan sözler söylüyordu.","target_tokens":[["Bizim",["72:4:4"]],["akılsızımız",["72:4:4"]],["Allah",["72:4:6"]],["hakkında",["72:4:5"]],["haddi",["72:4:7"]],["aşan",["72:4:7"]],["sözler",["72:4:3","72:4:7"]],["söylüyordu",["72:4:1","72:4:2","72:4:3"]]]},{"ayah_ref":"72:5","baseline_text":"Biz, insanların ve cinlerin Allah hakkında asla yalan söylemeyeceğini sanmıştık.","target_tokens":[["Biz",["72:5:1"]],["insanların",["72:5:6"]],["ve",["72:5:7"]],["cinlerin",["72:5:7"]],["Allah",["72:5:9"]],["hakkında",["72:5:8"]],["asla",["72:5:4"]],["yalan",["72:5:10"]],["söylemeyeceğini",["72:5:3","72:5:4","72:5:5"]],["sanmıştık",["72:5:1","72:5:2"]]]},{"ayah_ref":"72:6","baseline_text":"İnsanlardan bazı erkekler cinlerden bazı erkeklere sığınıyor, cinler de onların sıkıntısını artırıyordu.","target_tokens":[["İnsanlardan",["72:6:4","72:6:5"]],["bazı",["72:6:3"]],["erkekler",["72:6:3"]],["cinlerden",["72:6:8","72:6:9"]],["bazı",["72:6:7"]],["erkeklere",["72:6:7"]],["sığınıyor",["72:6:1","72:6:2","72:6:6"]],["cinler",["72:6:9"]],["de",["72:6:10"]],["onların",["72:6:10"]],["sıkıntısını",["72:6:11"]],["artırıyordu",["72:6:10"]]]},{"ayah_ref":"72:7","baseline_text":"Onlar da sizin sandığınız gibi Allah'ın hiç kimseyi göndermeyeceğini sanmışlardı.","target_tokens":[["Onlar",["72:7:1","72:7:2"]],["da",["72:7:1"]],["sizin",["72:7:4"]],["sandığınız",["72:7:4"]],["gibi",["72:7:3"]],["Allah'ın",["72:7:8"]],["hiç",["72:7:6"]],["kimseyi",["72:7:9"]],["göndermeyeceğini",["72:7:5","72:7:6","72:7:7"]],["sanmışlardı",["72:7:2"]]]},{"ayah_ref":"72:8","baseline_text":"Göğe erişmeye çalıştık ve onu güçlü bekçilerle ve alevlerle doldurulmuş bulduk.","target_tokens":[["Göğe",["72:8:3"]],["erişmeye",["72:8:2"]],["çalıştık",["72:8:1","72:8:2"]],["ve",["72:8:4"]],["onu",["72:8:4"]],["güçlü",["72:8:7"]],["bekçilerle",["72:8:6"]],["ve",["72:8:8"]],["alevlerle",["72:8:8"]],["doldurulmuş",["72:8:5"]],["bulduk",["72:8:4"]]]},{"ayah_ref":"72:9","baseline_text":"Dinlemek için oradaki oturma yerlerine otururduk. Ama şimdi kim dinlemeye kalksa kendisini pusuda bekleyen bir alev bulur.","target_tokens":[["Dinlemek",["72:9:6"]],["için",["72:9:6"]],["oradaki",["72:9:4"]],["oturma",["72:9:5"]],["yerlerine",["72:9:5"]],["otururduk",["72:9:1","72:9:2","72:9:3"]],["Ama",["72:9:7"]],["şimdi",["72:9:9"]],["kim",["72:9:7"]],["dinlemeye",["72:9:8"]],["kalksa",["72:9:8"]],["kendisini",["72:9:11"]],["pusuda",["72:9:13"]],["bekleyen",["72:9:13"]],["bir",["72:9:12"]],["alev",["72:9:12"]],["bulur",["72:9:10"]]]},{"ayah_ref":"72:10","baseline_text":"Yeryüzündekilere kötülük mü istendi, yoksa Rableri onlar için doğruluk mu istedi, bilmiyoruz.","target_tokens":[["Yeryüzündekilere",["72:10:6","72:10:7","72:10:8"]],["kötülük",["72:10:4"]],["mü",["72:10:4"]],["istendi",["72:10:5"]],["yoksa",["72:10:9"]],["Rableri",["72:10:12"]],["onlar",["72:10:11"]],["için",["72:10:11"]],["doğruluk",["72:10:13"]],["mu",["72:10:9"]],["istedi",["72:10:10"]],["bilmiyoruz",["72:10:1","72:10:2","72:10:3"]]]},{"ayah_ref":"72:11","baseline_text":"İçimizde iyi olanlar da bunun dışında olanlar da var. Biz farklı farklı yollar üzerindeydik.","target_tokens":[["İçimizde",["72:11:1","72:11:2"]],["iyi",["72:11:3"]],["olanlar",["72:11:3"]],["da",["72:11:4"]],["bunun",["72:11:6"]],["dışında",["72:11:5"]],["olanlar",["72:11:4","72:11:5"]],["da",["72:11:4"]],["var",["72:11:1"]],["Biz",["72:11:7"]],["farklı",["72:11:9"]],["farklı",["72:11:9"]],["yollar",["72:11:8"]],["üzerindeydik",["72:11:7","72:11:8"]]]},{"ayah_ref":"72:12","baseline_text":"Yeryüzünde Allah'ı aciz bırakamayacağımızı ve kaçarak da O'nu aciz bırakamayacağımızı düşündük.","target_tokens":[["Yeryüzünde",["72:12:7","72:12:8"]],["Allah'ı",["72:12:6"]],["aciz",["72:12:5"]],["bırakamayacağımızı",["72:12:3","72:12:4","72:12:5"]],["ve",["72:12:9"]],["kaçarak",["72:12:11"]],["da",["72:12:9"]],["O'nu",["72:12:10"]],["aciz",["72:12:10"]],["bırakamayacağımızı",["72:12:9","72:12:10"]],["düşündük",["72:12:1","72:12:2"]]]},{"ayah_ref":"72:13","baseline_text":"Doğru yolu duyduğumuzda ona inandık. Kim Rabbine inanırsa ne hakkının eksiltilmesinden ne de haksızlığa uğramaktan korkar.","target_tokens":[["Doğru",["72:13:4"]],["yolu",["72:13:4"]],["duyduğumuzda",["72:13:1","72:13:2","72:13:3"]],["ona",["72:13:6"]],["inandık",["72:13:5"]],["Kim",["72:13:7"]],["Rabbine",["72:13:9"]],["inanırsa",["72:13:8"]],["ne",["72:13:10"]],["hakkının",["72:13:12"]],["eksiltilmesinden",["72:13:12"]],["ne",["72:13:13"]],["de",["72:13:13"]],["haksızlığa",["72:13:14"]],["uğramaktan",["72:13:14"]],["korkar",["72:13:10","72:13:11"]]]},{"ayah_ref":"72:14","baseline_text":"İçimizde teslim olanlar da haktan sapanlar da var. Kim teslim olursa işte onlar doğru yolu aramışlardır.","target_tokens":[["İçimizde",["72:14:1","72:14:2"]],["teslim",["72:14:3"]],["olanlar",["72:14:3"]],["da",["72:14:4"]],["haktan",["72:14:5"]],["sapanlar",["72:14:5"]],["da",["72:14:4"]],["var",["72:14:1"]],["Kim",["72:14:6"]],["teslim",["72:14:7"]],["olursa",["72:14:7"]],["işte",["72:14:8"]],["onlar",["72:14:8"]],["doğru",["72:14:10"]],["yolu",["72:14:10"]],["aramışlardır",["72:14:9"]]]},{"ayah_ref":"72:15","baseline_text":"Haktan sapanlar ise cehenneme odun oldular.","target_tokens":[["Haktan",["72:15:2"]],["sapanlar",["72:15:2"]],["ise",["72:15:1"]],["cehenneme",["72:15:4"]],["odun",["72:15:5"]],["oldular",["72:15:3"]]]},{"ayah_ref":"72:16","baseline_text":"Eğer onlar yol üzerinde kararlı kalsalardı, onlara bol su verirdik.","target_tokens":[["Eğer",["72:16:1"]],["onlar",["72:16:2"]],["yol",["72:16:4"]],["üzerinde",["72:16:3"]],["kararlı",["72:16:2"]],["kalsalardı",["72:16:1","72:16:2"]],["onlara",["72:16:5"]],["bol",["72:16:7"]],["su",["72:16:6"]],["verirdik",["72:16:5"]]]},{"ayah_ref":"72:17","baseline_text":"Bununla onları sınamak için. Kim Rabbinin anılmasından yüz çevirirse O, onu çetin bir azaba sokar.","target_tokens":[["Bununla",["72:17:2"]],["onları",["72:17:1"]],["sınamak",["72:17:1"]],["için",["72:17:1"]],["Kim",["72:17:3"]],["Rabbinin",["72:17:7"]],["anılmasından",["72:17:5","72:17:6"]],["yüz",["72:17:4"]],["çevirirse",["72:17:4"]],["O",["72:17:8"]],["onu",["72:17:8"]],["çetin",["72:17:10"]],["bir",["72:17:9"]],["azaba",["72:17:9"]],["sokar",["72:17:8"]]]},{"ayah_ref":"72:18","baseline_text":"Mescitler Allah'a aittir; öyleyse Allah ile birlikte hiç kimseye yakarmayın.","target_tokens":[["Mescitler",["72:18:1","72:18:2"]],["Allah'a",["72:18:3"]],["aittir",["72:18:3"]],["öyleyse",["72:18:4"]],["Allah",["72:18:7"]],["ile",["72:18:6"]],["birlikte",["72:18:6"]],["hiç",["72:18:8"]],["kimseye",["72:18:8"]],["yakarmayın",["72:18:4","72:18:5"]]]},{"ayah_ref":"72:19","baseline_text":"Allah'ın kulu O'na yakarmak için kalktığında, neredeyse onun üzerine yığılacaklardı.","target_tokens":[["Allah'ın",["72:19:5"]],["kulu",["72:19:4"]],["O'na",["72:19:6"]],["yakarmak",["72:19:6"]],["için",["72:19:6"]],["kalktığında",["72:19:1","72:19:2","72:19:3"]],["neredeyse",["72:19:7"]],["onun",["72:19:9"]],["üzerine",["72:19:9"]],["yığılacaklardı",["72:19:7","72:19:8","72:19:10"]]]},{"ayah_ref":"72:20","baseline_text":"De ki: Ben yalnız Rabbime yakarırım ve hiç kimseyi O'na ortak koşmam.","target_tokens":[["De",["72:20:1"]],["ki",["72:20:1"]],["Ben",["72:20:2"]],["yalnız",["72:20:2"]],["Rabbime",["72:20:4"]],["yakarırım",["72:20:3"]],["ve",["72:20:5"]],["hiç",["72:20:5","72:20:8"]],["kimseyi",["72:20:8"]],["O'na",["72:20:7"]],["ortak",["72:20:6"]],["koşmam",["72:20:5","72:20:6"]]]},{"ayah_ref":"72:21","baseline_text":"De ki: Size zarar vermeye de sizi doğru yola iletmeye de gücüm yetmez.","target_tokens":[["De",["72:21:1"]],["ki",["72:21:1"]],["Size",["72:21:5"]],["zarar",["72:21:6"]],["vermeye",["72:21:4","72:21:6"]],["de",["72:21:7"]],["sizi",["72:21:5"]],["doğru",["72:21:8"]],["yola",["72:21:8"]],["iletmeye",["72:21:8"]],["de",["72:21:7"]],["gücüm",["72:21:2","72:21:4"]],["yetmez",["72:21:2","72:21:3","72:21:4"]]]},{"ayah_ref":"72:22","baseline_text":"De ki: Allah'a karşı hiç kimse beni koruyamaz ve O'ndan başka sığınacak bir yer bulamam.","target_tokens":[["De",["72:22:1"]],["ki",["72:22:1"]],["Allah'a",["72:22:6"]],["karşı",["72:22:5","72:22:6"]],["hiç",["72:22:3","72:22:7"]],["kimse",["72:22:7"]],["beni",["72:22:4"]],["koruyamaz",["72:22:2","72:22:3","72:22:4"]],["ve",["72:22:8"]],["O'ndan",["72:22:11"]],["başka",["72:22:10","72:22:11"]],["sığınacak",["72:22:12"]],["bir",["72:22:12"]],["yer",["72:22:12"]],["bulamam",["72:22:8","72:22:9"]]]},{"ayah_ref":"72:23","baseline_text":"Ancak Allah'tan geleni ve O'nun mesajlarını iletebilirim. Kim Allah'a ve elçisine karşı gelirse, onun için cehennem ateşi vardır; böyleleri orada sonsuza kadar kalacaklardır.","target_tokens":[["Ancak",["72:23:1"]],["Allah'tan",["72:23:3","72:23:4"]],["geleni",["72:23:2","72:23:3"]],["ve",["72:23:5"]],["O'nun",["72:23:5"]],["mesajlarını",["72:23:5"]],["iletebilirim",["72:23:2"]],["Kim",["72:23:6"]],["Allah'a",["72:23:8"]],["ve",["72:23:9"]],["elçisine",["72:23:9"]],["karşı",["72:23:7"]],["gelirse",["72:23:7"]],["onun",["72:23:11"]],["için",["72:23:11"]],["cehennem",["72:23:13"]],["ateşi",["72:23:12"]],["vardır",["72:23:10","72:23:11"]],["böyleleri",["72:23:14"]],["orada",["72:23:15"]],["sonsuza",["72:23:16"]],["kadar",["72:23:16"]],["kalacaklardır",["72:23:14","72:23:15"]]]},{"ayah_ref":"72:24","baseline_text":"Sonunda, kendilerine vaat edileni gördüklerinde kimin yardımcısının daha zayıf ve sayısının daha az olduğunu bilecekler.","target_tokens":[["Sonunda",["72:24:1"]],["kendilerine",["72:24:5"]],["vaat",["72:24:5"]],["edileni",["72:24:4","72:24:5"]],["gördüklerinde",["72:24:2","72:24:3"]],["kimin",["72:24:7"]],["yardımcısının",["72:24:9"]],["daha",["72:24:8"]],["zayıf",["72:24:8"]],["ve",["72:24:10"]],["sayısının",["72:24:11"]],["daha",["72:24:10"]],["az",["72:24:10"]],["olduğunu",["72:24:7"]],["bilecekler",["72:24:6"]]]},{"ayah_ref":"72:25","baseline_text":"De ki: Size vaat edilen yakın mı, yoksa Rabbim onun için bir süre mi belirleyecek, bilmiyorum.","target_tokens":[["De",["72:25:1"]],["ki",["72:25:1"]],["Size",["72:25:6"]],["vaat",["72:25:6"]],["edilen",["72:25:5","72:25:6"]],["yakın",["72:25:4"]],["mı",["72:25:4"]],["yoksa",["72:25:7"]],["Rabbim",["72:25:10"]],["onun",["72:25:9"]],["için",["72:25:9"]],["bir",["72:25:11"]],["süre",["72:25:11"]],["mi",["72:25:7"]],["belirleyecek",["72:25:8"]],["bilmiyorum",["72:25:2","72:25:3"]]]},{"ayah_ref":"72:26","baseline_text":"O, görünmeyeni bilendir; görünmeyene dair bilgisini hiç kimseye açıklamaz.","target_tokens":[["O",["72:26:1"]],["görünmeyeni",["72:26:2"]],["bilendir",["72:26:1"]],["görünmeyene",["72:26:6"]],["dair",["72:26:5","72:26:6"]],["bilgisini",["72:26:6"]],["hiç",["72:26:3","72:26:7"]],["kimseye",["72:26:7"]],["açıklamaz",["72:26:3","72:26:4"]]]},{"ayah_ref":"72:27","baseline_text":"Ancak seçip hoşnut olduğu bir elçi bunun dışındadır. O, elçinin önüne de arkasına da gözcüler yerleştirir.","target_tokens":[["Ancak",["72:27:1"]],["seçip",["72:27:3"]],["hoşnut",["72:27:3"]],["olduğu",["72:27:3"]],["bir",["72:27:5"]],["elçi",["72:27:4","72:27:5"]],["bunun",["72:27:2"]],["dışındadır",["72:27:1","72:27:2"]],["O",["72:27:6"]],["elçinin",["72:27:10"]],["önüne",["72:27:8","72:27:9","72:27:10"]],["de",["72:27:8"]],["arkasına",["72:27:11","72:27:12"]],["da",["72:27:11"]],["gözcüler",["72:27:13"]],["yerleştirir",["72:27:6","72:27:7"]]]},{"ayah_ref":"72:28","baseline_text":"Onların Rablerinin mesajlarını gerçekten ilettiklerini bilsin diye. O, onların yanında olan her şeyi kuşatmış ve her şeyi tek tek saymıştır.","target_tokens":[["Onların",["72:28:4"]],["Rablerinin",["72:28:6"]],["mesajlarını",["72:28:5"]],["gerçekten",["72:28:3"]],["ilettiklerini",["72:28:4"]],["bilsin",["72:28:1"]],["diye",["72:28:1","72:28:2"]],["O",["72:28:7"]],["onların",["72:28:9"]],["yanında",["72:28:9"]],["olan",["72:28:8","72:28:9"]],["her",["72:28:8"]],["şeyi",["72:28:8"]],["kuşatmış",["72:28:7"]],["ve",["72:28:10"]],["her",["72:28:11"]],["şeyi",["72:28:12"]],["tek",["72:28:13"]],["tek",["72:28:13"]],["saymıştır",["72:28:10","72:28:13"]]]}]}

{"language":"tr","ayat":[{"ayah_ref":"15:1","baseline_text":"Elif Lâm Râ. Bunlar kitabın ve apaçık bir Kur'an'ın ayetleridir.","target_tokens":[["Elif",["15:1:1"]],["Lâm",["15:1:1"]],["Râ",["15:1:1"]],["Bunlar",["15:1:2"]],["kitabın",["15:1:4"]],["ve",["15:1:5"]],["apaçık",["15:1:6"]],["bir",["15:1:5","15:1:6"]],["Kur'an'ın",["15:1:5"]],["ayetleridir",["15:1:3"]]]},{"ayah_ref":"15:2","baseline_text":"İnkâr edenler zaman zaman, keşke Müslüman olsaydık diye arzu edecekler.","target_tokens":[["İnkâr",["15:2:4"]],["edenler",["15:2:3","15:2:4"]],["zaman",["15:2:1"]],["zaman",["15:2:1"]],["keşke",["15:2:5"]],["Müslüman",["15:2:7"]],["olsaydık",["15:2:6"]],["diye",["15:2:5"]],["arzu",["15:2:2"]],["edecekler",["15:2:2"]]]},{"ayah_ref":"15:3","baseline_text":"Bırak onları; yesinler, yararlansınlar ve umut onları oyalasın. Yakında bilecekler.","target_tokens":[["Bırak",["15:3:1"]],["onları",["15:3:1"]],["yesinler",["15:3:2"]],["yararlansınlar",["15:3:3"]],["ve",["15:3:3","15:3:4"]],["umut",["15:3:5"]],["onları",["15:3:4"]],["oyalasın",["15:3:4"]],["Yakında",["15:3:6"]],["bilecekler",["15:3:7"]]]},{"ayah_ref":"15:4","baseline_text":"Biz hiçbir şehri, kendisi için belirlenmiş bir kayıt olmadan yok etmedik.","target_tokens":[["Biz",["15:4:2"]],["hiçbir",["15:4:1","15:4:3"]],["şehri",["15:4:4"]],["kendisi",["15:4:6"]],["için",["15:4:6"]],["belirlenmiş",["15:4:8"]],["bir",["15:4:7"]],["kayıt",["15:4:7"]],["olmadan",["15:4:5","15:4:6"]],["yok",["15:4:2"]],["etmedik",["15:4:1","15:4:2"]]]},{"ayah_ref":"15:5","baseline_text":"Hiçbir toplum belirlenmiş süresini ne öne alabilir ne de erteleyebilir.","target_tokens":[["Hiçbir",["15:5:1","15:5:3"]],["toplum",["15:5:4"]],["belirlenmiş",["15:5:5"]],["süresini",["15:5:5"]],["ne",["15:5:1"]],["öne",["15:5:2"]],["alabilir",["15:5:2"]],["ne",["15:5:6"]],["de",["15:5:6"]],["erteleyebilir",["15:5:7"]]]},{"ayah_ref":"15:6","baseline_text":"Dediler ki: 'Ey kendisine öğüt indirilen kişi! Sen kesinlikle delisin.'","target_tokens":[["Dediler",["15:6:
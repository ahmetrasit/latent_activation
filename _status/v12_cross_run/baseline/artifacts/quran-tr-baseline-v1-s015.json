12:2"]],["suçluların",["15:12:5"]],["kalplerine",["15:12:3","15:12:4"]],["işte",["15:12:1"]],["böyle",["15:12:1"]],["sokarız",["15:12:2"]]]},{"ayah_ref":"15:13","baseline_text":"Ona inanmazlar; öncekilerin düzeni daha önce de işledi.","target_tokens":[["Ona",["15:13:3"]],["inanmazlar",["15:13:1","15:13:2"]],["öncekilerin",["15:13:7"]],["düzeni",["15:13:6"]],["daha",["15:13:4","15:13:5"]],["önce",["15:13:4","15:13:5"]],["de",["15:13:4"]],["işledi",["15:13:5"]]]},{"ayah_ref":"15:14","baseline_text":"Onlara gökten bir kapı açsak ve oradan yükselmeyi sürdürseler bile,","target_tokens":[["Onlara",["15:14:3"]],["gökten",["15:14:5","15:14:6"]],["bir",["15:14:4"]],["kapı",["15:14:4"]],["açsak",["15:14:1","15:14:2"]],["ve",["15:14:7"]],["oradan",["15:14:8"]],["yükselmeyi",["15:14:9"]],["sürdürseler",["15:14:7","15:14:9"]],["bile",["15:14:1"]]]},{"ayah_ref":"15:15","baseline_text":"'Gözlerimiz perdelendi; hayır, biz büyülenmiş bir topluluğuz' derlerdi.","target_tokens":[["Gözlerimiz",["15:15:4"]],["perdelendi",["15:15:2","15:15:3"]],["hayır",["15:15:5"]],["biz",["15:15:6"]],["büyülenmiş",["15:15:8"]],["bir",["15:15:7"]],["topluluğuz",["15:15:7"]],["derlerdi",["15:15:1"]]]},{"ayah_ref":"15:16","baseline_text":"Gökte burçlar oluşturduk ve onu bakanlar için süsledik.","target_tokens":[["Gökte",["15:16:3","15:16:4"]],["burçlar",["15:16:5"]],["oluşturduk",["15:16:1","15:16:2"]],["ve",["15:16:6"]],["onu",["15:16:6"]],["bakanlar",["15:16:7"]],["için",["15:16:7"]],["süsledik",["15:16:6"]]]},{"ayah_ref":"15:17","baseline_text":"Onu kovulmuş her şeytandan koruduk.","target_tokens":[["Onu",["15:17:1"]],["kovulmuş",["15:17:5"]],["her",["15:17:3"]],["şeytandan",["15:17:2","15:17:4"]],["koruduk",["15:17:1"]]]},{"ayah_ref":"15:18","baseline_text":"Ancak gizlice kulak verenin peşine parlak bir alev düşer.","target_tokens":[["Ancak",["15:18:1"]],["gizlice",["15:18:3"]],["kulak",["15:18:4"]],["verenin",["15:18:2","15:18:3"]],["peşine",["15:18:5"]],["parlak",["15:18:7"]],["bir",["15:18:6"]],["a
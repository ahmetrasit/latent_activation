{"language":"tr","ayat":[{"ayah_ref":"76:1","baseline_text":"İnsanın üzerinden, anılan bir şey olmadığı bir zaman dilimi geçti mi?","target_tokens":[["İnsanın",["76:1:4"]],["üzerinden",["76:1:3"]],["anılan",["76:1:11"]],["bir",["76:1:10"]],["şey",["76:1:10"]],["olmadığı",["76:1:8","76:1:9"]],["bir",["76:1:6"]],["zaman",["76:1:7"]],["dilimi",["76:1:5"]],["geçti",["76:1:2"]],["mi",["76:1:1"]]]},{"ayah_ref":"76:2","baseline_text":"Biz insanı karışık bir damladan, onu sınamak üzere yarattık; ardından onu işiten ve gören kıldık.","target_tokens":[["Biz",["76:2:1"]],["insanı",["76:2:3"]],["karışık",["76:2:6"]],["bir",["76:2:5"]],["damladan",["76:2:4","76:2:5"]],["onu",["76:2:7"]],["sınamak",["76:2:7"]],["üzere",["76:2:7"]],["yarattık",["76:2:2"]],["ardından",["76:2:8"]],["onu",["76:2:8"]],["işiten",["76:2:9"]],["ve",["76:2:9","76:2:10"]],["gören",["76:2:10"]],["kıldık",["76:2:8"]]]},{"ayah_ref":"76:3","baseline_text":"Biz ona yolu gösterdik; ister şükreden ister nankör olsun.","target_tokens":[["Biz",["76:3:1"]],["ona",["76:3:2"]],["yolu",["76:3:3"]],["gösterdik",["76:3:2"]],["ister",["76:3:4"]],["şükreden",["76:3:5"]],["ister",["76:3:6"]],["nankör",["76:3:7"]],["olsun",["76:3:5","76:3:7"]]]},{"ayah_ref":"76:4","baseline_text":"Biz inkâr edenler için zincirler, boyunduruklar ve alevli bir ateş hazırladık.","target_tokens":[["Biz",["76:4:1"]],["inkâr",["76:4:3"]],["edenler",["76:4:3"]],["için",["76:4:3"]],["zincirler",["76:4:4"]],["boyunduruklar",["76:4:5"]],["ve",["76:4:5","76:4:6"]],["alevli",["76:4:6"]],["bir",["76:4:6"]],["ateş",["76:4:6"]],["hazırladık",["76:4:2"]]]},{"ayah_ref":"76:5","baseline_text":"İyiler, karışımı kâfur olan bir kadehten içerler.","target_tokens":[["İyiler",["76:5:1","76:5:2"]],["karışımı",["76:5:7"]],["kâfur",["76:5:8"]],["olan",["76:5:6"]],["bir",["76:5:5"]],["kadehten",["76:5:4","76:5:5"]],["içerler",["76:5:3"]]]},{"ayah_ref":"76:6","baseline_text":"Allah'ın kulları bir pınardan içer ve onu bol bol akıtırlar.","target_tokens":[["Allah'ın",["76:6:5"]],["kulları",["76:6:4"]],["bir",["76:6:1"]],["pınardan",["76:6:1","76:6:3"]],["içer",["76:6:2"]],["ve",["76:6:6"]],["onu",["76:6:6"]],["bol",["76:6:7"]],["bol",["76:6:7"]],["akıtırlar",["76:6:6"]]]},{"ayah_ref":"76:7","baseline_text":"Onlar adaklarını yerine getirir ve kötülüğü her yana yayılan bir günden korkarlar.","target_tokens":[["Onlar",["76:7:1"]],["adaklarını",["76:7:2"]],["yerine",["76:7:1"]],["getirir",["76:7:1"]],["ve",["76:7:3"]],["kötülüğü",["76:7:6"]],["her",["76:7:7"]],["yana",["76:7:7"]],["yayılan",["76:7:5","76:7:7"]],["bir",["76:7:4"]],["günden",["76:7:4"]],["korkarlar",["76:7:3"]]]},{"ayah_ref":"76:8","baseline_text":"Yemeği, sevdikleri hâlde yoksula, yetime ve esire yedirirler.","target_tokens":[["Yemeği",["76:8:2"]],["sevdikleri",["76:8:4"]],["hâlde",["76:8:3","76:8:4"]],["yoksula",["76:8:5"]],["yetime",["76:8:6"]],["ve",["76:8:7"]],["esire",["76:8:7"]],["yedirirler",["76:8:1"]]]},{"ayah_ref":"76:9","baseline_text":"Sizi yalnız Allah için doyuruyoruz. Sizden ne bir karşılık ne de teşekkür istiyoruz.","target_tokens":[["Sizi",["76:9:2"]],["yalnız",["76:9:1"]],["Allah",["76:9:4"]],["için",["76:9:3"]],["doyuruyoruz",["76:9:2"]],["Sizden",["76:9:7"]],["ne",["76:9:5"]],["bir",["76:9:8"]],["karşılık",["76:9:8"]],["ne",["76:9:9"]],["de",["76:9:9"]],["teşekkür",["76:9:10"]],["istiyoruz",["76:9:6"]]]},{"ayah_ref":"76:10","baseline_text":"Biz, Rabbimizden gelecek asık yüzlü ve çetin bir günden korkuyoruz.","target_tokens":[["Biz",["76:10:1"]],["Rabbimizden",["76:10:3","76:10:4"]],["gelecek",["76:10:3"]],["asık",["76:10:6"]],["yüzlü",["76:10:6"]],["ve",["76:10:6","76:10:7"]],["çetin",["76:10:7"]],["bir",["76:10:5"]],["günden",["76:10:5"]],["korkuyoruz",["76:10:2"]]]},{"ayah_ref":"76:11","baseline_text":"Bu yüzden Allah onları o günün kötülüğünden korudu ve onlara aydınlık ve sevinç verdi.","target_tokens":[["Bu",["76:11:1"]],["yüzden",["76:11:1"]],["Allah",["76:11:2"]],["onları",["76:11:1"]],["o",["76:11:4"]],["günün",["76:11:5"]],["kötülüğünden",["7
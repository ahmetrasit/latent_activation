,["76:17:3"]],["kadehten",["76:17:3"]],["içirilir",["76:17:1"]]]},{"ayah_ref":"76:18","baseline_text":"Orada Selsebil diye adlandırılan bir pınar vardır.","target_tokens":[["Orada",["76:18:2"]],["Selsebil",["76:18:4"]],["diye",["76:18:3"]],["adlandırılan",["76:18:3"]],["bir",["76:18:1"]],["pınar",["76:18:1"]],["vardır",["76:18:1"]]]},{"ayah_ref":"76:19","baseline_text":"Çevrelerinde hep genç kalan çocuklar dolaşır; onları görünce saçılmış inciler sanırsın.","target_tokens":[["Çevrelerinde",["76:19:2"]],["hep",["76:19:4"]],["genç",["76:19:4"]],["kalan",["76:19:4"]],["çocuklar",["76:19:3"]],["dolaşır",["76:19:1"]],["onları",["76:19:6"]],["görünce",["76:19:5","76:19:6"]],["saçılmış",["76:19:9"]],["inciler",["76:19:8"]],["sanırsın",["76:19:7"]]]},{"ayah_ref":"76:20","baseline_text":"Oraya baktığında nimet ve büyük bir egemenlik görürsün.","target_tokens":[["Oraya",["76:20:3"]],["baktığında",["76:20:1","76:20:2"]],["nimet",["76:20:5"]],["ve",["76:20:6"]],["büyük",["76:20:7"]],["bir",["76:20:6"]],["egemenlik",["76:20:6"]],["görürsün",["76:20:4"]]]},{"ayah_ref":"76:21","baseline_text":"Üzerlerinde yeşil ince ipekten ve kalın ipekten giysiler vardır. Gümüş bileziklerle süslenmişlerdir. Rableri onlara tertemiz bir içecek içirmiştir.","target_tokens":[["Üzerlerinde",["76:21:1"]],["yeşil",["76:21:4"]],["ince",["76:21:3"]],["ipekten",["76:21:3"]],["ve",["76:21:5"]],["kalın",["76:21:5"]],["ipekten",["76:21:5"]],["giysiler",["76:21:2"]],["vardır",["76:21:1","76:21:2"]],["Gümüş",["76:21:9"]],["bileziklerle",["76:21:7","76:21:8","76:21:9"]],["süslenmişlerdir",["76:21:6"]],["Rableri",["76:21:11"]],["onlara",["76:21:10"]],["tertemiz",["76:21:13"]],["bir",["76:21:12"]],["içecek",["76:21:12"]],["içirmiştir",["76:21:10"]]]},{"ayah_ref":"76:22","baseline_text":"Gerçekten bu sizin ödülünüzdür ve çabanız takdir edilmiştir.","target_tokens":[["Gerçekten",["76:22:1"]],["bu",["76:22:2"]],["sizin",["76:22:4"]],["ödülünüzdür",["76:22:3","76:22:5"]],["ve",["76:22:6"]],["çabanız",["76:22:7"]],["takdir",["76:22:8"]],["edilmiştir",["76:22:6","76:22:8"]]]},{"ayah_ref":"76:23","baseline_text":"Gerçekten Kur'an'ı sana biz indirdik.","target_tokens":[["Gerçekten",["76:23:1"]],["Kur'an'ı",["76:23:5"]],["sana",["76:23:4"]],["biz",["76:23:2"]],["indirdik",["76:23:3","76:23:6"]]]},{"ayah_ref":"76:24","baseline_text":"Bu yüzden Rabbinin hükmü karşısında sabırlı ol ve onlardan günahkâr ya da nankör olana itaat etme.","target_tokens":[["Bu",["76:24:1"]],["yüzden",["76:24:1"]],["Rabbinin",["76:24:3"]],["hükmü",["76:24:2"]],["karşısında",["76:24:2"]],["sabırlı",["76:24:1"]],["ol",["76:24:1"]],["ve",["76:24:4"]],["onlardan",["76:24:6"]],["günahkâr",["76:24:7"]],["ya",["76:24:8"]],["da",["76:24:8"]],["nankör",["76:24:9"]],["olana",["76:24:7","76:24:9"]],["itaat",["76:24:5"]],["etme",["76:24:4","76:24:5"]]]},{"ayah_ref":"76:25","baseline_text":"Rabbinin adını sabah ve akşam an.","target_tokens":[["Rabbinin",["76:25:3"]],["adını",["76:25:2"]],["sabah",["76:25:4"]],["ve",["76:25:5"]],["akşam",["76:25:5"]],["an",["76:25:1"]]]},{"ayah_ref":"76:26","baseline_text":"Gecenin bir kısmında O'na secde et ve uzun gece boyunca O'nu yücelt.","target_tokens":[["Gecenin",["76:26:2"]],["bir",["76:26:1"]],["kısmında",["76:26:1","76:26:2"]],["O'na",["76:26:4"]],["secde",["76:26:3"]],["et",["76:26:3"]],["ve",["76:26:5"]],["uzun",["76:26:7"]],["gece",["76:26:6"]],["boyunca",["76:26:6"]],["O'nu",["76:26:5"]],["yücelt",["76:26:5"]]]},{"ayah_ref":"76:27","baseline_text":"Bunlar çabuk geleni seviyor ve arkalarında ağır bir gün bırakıyorlar.","target_tokens":[["Bunlar",["76:27:1","76:27:2"]],["çabuk",["76:27:4"]],["geleni",["76:27:4"]],["seviyor",["76:27:3"]],["ve",["76:27:5"]],["arkalarında",["76:27:6"]],["ağır",["76:27:8"]],["bir",["76:27:7"]],["gün",["76:27:7"]],["bırakıyorlar",["76:27:5"]]]},{"ayah_ref":"76:28","baseline_text":"Onları biz yarattık ve bağlarını güçlendirdik. Dilediğimizde onları benzerleriyle bütünüyle değiştiririz.","target_tokens":[["Onları",["76:28:2"]],["biz",["76:28:1"]],["y
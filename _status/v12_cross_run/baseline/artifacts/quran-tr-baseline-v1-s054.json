{"language":"tr","ayat":[{"ayah_ref":"54:1","baseline_text":"Saat yaklaştı ve ay yarıldı.","target_tokens":[["Saat",["54:1:2"]],["yaklaştı",["54:1:1"]],["ve",["54:1:3"]],["ay",["54:1:4"]],["yarıldı",["54:1:3"]]]},{"ayah_ref":"54:2","baseline_text":"Onlar bir ayet görürlerse yüz çevirir ve “Sürüp giden bir büyü” derler.","target_tokens":[["Onlar",["54:2:2"]],["bir",["54:2:3"]],["ayet",["54:2:3"]],["görürlerse",["54:2:1","54:2:2"]],["yüz",["54:2:4"]],["çevirir",["54:2:4"]],["ve",["54:2:5"]],["Sürüp",["54:2:7"]],["giden",["54:2:7"]],["bir",["54:2:6"]],["büyü",["54:2:6"]],["derler",["54:2:5"]]]},{"ayah_ref":"54:3","baseline_text":"Yalanladılar ve arzularına uydular; her iş yerini bulur.","target_tokens":[["Yalanladılar",["54:3:1"]],["ve",["54:3:2"]],["arzularına",["54:3:3"]],["uydular",["54:3:2","54:3:3"]],["her",["54:3:4"]],["iş",["54:3:5"]],["yerini",["54:3:6"]],["bulur",["54:3:6"]]]},{"ayah_ref":"54:4","baseline_text":"Onlara, içinde caydırıcı uyarılar bulunan haberler geldi.","target_tokens":[["Onlara",["54:4:2"]],["içinde",["54:4:6"]],["caydırıcı",["54:4:7"]],["uyarılar",["54:4:7"]],["bulunan",["54:4:5","54:4:6"]],["haberler",["54:4:3","54:4:4"]],["geldi",["54:4:1","54:4:2"]]]},{"ayah_ref":"54:5","baseline_text":"Üstün bir bilgeliktir; ama uyarılar fayda vermiyor.","target_tokens":[["Üstün",["54:5:2"]],["bir",["54:5:1"]],["bilgeliktir",["54:5:1"]],["ama",["54:5:3"]],["uyarılar",["54:5:5"]],["fayda",["54:5:4"]],["vermiyor",["54:5:3","54:5:4"]]]},{"ayah_ref":"54:6","baseline_text":"Öyleyse onlardan yüz çevir; çağıranın korkunç bir şeye çağıracağı gün...","target_tokens":[["Öyleyse",["54:6:1"]],["onlardan",["54:6:2"]],["yüz",["54:6:1"]],["çevir",["54:6:1"]],["çağıranın",["54:6:5"]],["korkunç",["54:6:8"]],["bir",["54:6:7"]],["şeye",["54:6:6","54:6:7"]],["çağıracağı",["54:6:4"]],["gün",["54:6:3"]]]},{"ayah_ref":"54:7","baseline_text":"Gözleri yere eğik, yayılmış çekirgeler gibi mezarlardan çıkarlar.","target_tokens":[["Gözleri",["54:7:2"]],["yere",["54:7:1"]],["eğik",["
{"language":"tr","ayat":[{"ayah_ref":"111:1","baseline_text":"Ebu Leheb'in iki eli yok olsun; kendisi de yok oldu.","target_tokens":[["Ebu",["111:1:3"]],["Leheb'in",["111:1:4"]],["iki",["111:1:2"]],["eli",["111:1:2"]],["yok",["111:1:1"]],["olsun",["111:1:1"]],["kendisi",["111:1:5"]],["de",["111:1:5"]],["yok",["111:1:5"]],["oldu",["111:1:5"]]]},{"ayah_ref":"111:2","baseline_text":"Malı ve kazandığı şey ona yarar sağlamadı.","target_tokens":[["Malı",["111:2:4"]],["ve",["111:2:5"]],["kazandığı",["111:2:6"]],["şey",["111:2:5"]],["ona",["111:2:3"]],["yarar",["111:2:2"]],["sağlamadı",["111:2:1","111:2:2"]]]},{"ayah_ref":"111:3","baseline_text":"Alevli bir ateşte yanacak.","target_tokens":[["Alevli",["111:3:3","111:3:4"]],["bir",["111:3:2"]],["ateşte",["111:3:2"]],["yanacak",["111:3:1"]]]},{"ayah_ref":"111:4","baseline_text":"Odun taşıyan karısı da.","target_tokens":[["Odun",["111:4:3"]],["taşıyan",["111:4:2"]],["karısı",["111:4:1"]],["da",["111:4:1"]]]},{"ayah_ref":"111:5","baseline_text":"Boynunda liften bir ip vardır.","target_tokens":[["Boynunda",["111:5:1","111:5:2"]],["liften",["111:5:4","111:5:5"]],["bir",["111:5:3"]],["ip",["111:5:3"]],["vardır",["111:5:3"]]]}]}

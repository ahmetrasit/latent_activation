{"language":"tr","ayat":[{"ayah_ref":"87:1","baseline_text":"En yüce Rabbinin adını yücelt.","target_tokens":[["En",["87:1:4"]],["yüce",["87:1:4"]],["Rabbinin",["87:1:3"]],["adını",["87:1:2"]],["yücelt",["87:1:1"]]]},{"ayah_ref":"87:2","baseline_text":"O yarattı ve düzene koydu.","target_tokens":[["O",["87:2:1"]],["yarattı",["87:2:2"]],["ve",["87:2:3"]],["düzene",["87:2:3"]],["koydu",["87:2:3"]]]},{"ayah_ref":"87:3","baseline_text":"O ölçüyü belirledi, ardından yol gösterdi.","target_tokens":[["O",["87:3:1"]],["ölçüyü",["87:3:2"]],["belirledi",["87:3:2"]],["ardından",["87:3:3"]],["yol",["87:3:3"]],["gösterdi",["87:3:3"]]]},{"ayah_ref":"87:4","baseline_text":"O, otlağı ortaya çıkardı.","target_tokens":[["O",["87:4:1"]],["otlağı",["87:4:3"]],["ortaya",["87:4:2"]],["çıkardı",["87:4:2"]]]},{"ayah_ref":"87:5","baseline_text":"Sonra onu kapkara bir çerçöpe çevirdi.","target_tokens":[["Sonra",["87:5:1"]],["onu",["87:5:1"]],["kapkara",["87:5:3"]],["bir",["87:5:2"]],["çerçöpe",["87:5:2"]],["çevirdi",["87:5:1"]]]},{"ayah_ref":"87:6","baseline_text":"Sana okutacağız; böylece unutmayacaksın.","target_tokens":[["Sana",["87:6:1"]],["okutacağız",["87:6:1"]],["böylece",["87:6:2"]],["unutmayacaksın",["87:6:2","87:6:3"]]]},{"ayah_ref":"87:7","baseline_text":"Ancak Allah'ın dilediği dışında. Kuşkusuz O, açık olanı ve gizli kalanı bilir.","target_tokens":[["Ancak",["87:7:1"]],["Allah'ın",["87:7:4"]],["dilediği",["87:7:2","87:7:3"]],["dışında",["87:7:1"]],["Kuşkusuz",["87:7:5"]],["O",["87:7:5"]],["açık",["87:7:7"]],["olanı",["87:7:7"]],["ve",["87:7:8"]],["gizli",["87:7:9"]],["kalanı",["87:7:8","87:7:9"]],["bilir",["87:7:6"]]]},{"ayah_ref":"87:8","baseline_text":"Ve seni kolay olana yönelteceğiz.","target_tokens":[["Ve",["87:8:1"]],["seni",["87:8:1"]],["kolay",["87:8:2"]],["olana",["87:8:2"]],["yönelteceğiz",["87:8:1","87:8:2"]]]},{"ayah_ref":"87:9","baseline_text":"Öyleyse öğüt yarar sağlarsa öğüt ver.","target_tokens":[["Öyleyse",["87:9:1"]],["öğüt",["87:9:4"]],["yarar",["87:9:3"]],["sağlarsa",["87:9:2","87:9:3"]],["öğüt",["87:9:1","87:9:4"]],["ver",["87:9:1"]]]},{"ayah_ref":"87:10","baseline_text":"Korkan kişi öğüt alacaktır.","target_tokens":[["Korkan",["87:10:3"]],["kişi",["87:10:2"]],["öğüt",["87:10:1"]],["alacaktır",["87:10:1"]]]},{"ayah_ref":"87:11","baseline_text":"En bahtsız olan ise ondan kaçınacaktır.","target_tokens":[["En",["87:11:2"]],["bahtsız",["87:11:2"]],["olan",["87:11:2"]],["ise",["87:11:1"]],["ondan",["87:11:1"]],["kaçınacaktır",["87:11:1"]]]},{"ayah_ref":"87:12","baseline_text":"O, büyük ateşte yanacaktır.","target_tokens":[["O",["87:12:1"]],["büyük",["87:12:4"]],["ateşte",["87:12:3"]],["yanacaktır",["87:12:2"]]]},{"ayah_ref":"87:13","baseline_text":"Sonra orada ne ölecek ne de yaşayacaktır.","target_tokens":[["Sonra",["87:13:1"]],["orada",["87:13:4"]],["ne",["87:13:2"]],["ölecek",["87:13:2","87:13:3"]],["ne",["87:13:5"]],["de",["87:13:5"]],["yaşayacaktır",["87:13:5","87:13:6"]]]},{"ayah_ref":"87:14","baseline_text":"Arınan kişi gerçekten kurtuluşa ermiştir.","target_tokens":[["Arınan",["87:14:4"]],["kişi",["87:14:3"]],["gerçekten",["87:14:1"]],["kurtuluşa",["87:14:2"]],["ermiştir",["87:14:2"]]]},{"ayah_ref":"87:15","baseline_text":"Ve Rabbinin adını andı, ardından namaz kıldı.","target_tokens":[["Ve",["87:15:1"]],["Rabbinin",["87:15:3"]],["adını",["87:15:2"]],["andı",["87:15:1"]],["ardından",["87:15:4"]],["namaz",["87:15:4"]],["kıldı",["87:15:4"]]]},{"ayah_ref":"87:16","baseline_text":"Fakat siz dünya hayatını tercih ediyorsunuz.","target_tokens":[["Fakat",["87:16:1"]],["siz",["87:16:2"]],["dünya",["87:16:4"]],["hayatını",["87:16:3"]],["tercih",["87:16:2"]],["ediyorsunuz",["87:16:2"]]]},{"ayah_ref":"87:17","baseline_text":"Oysa ahiret daha iyi ve daha kalıcıdır.","target_tokens":[["Oysa",["87:17:1"]],["ahiret",["87:17:1"]],["daha",["87:17:2"]],["iyi",["87:17:2"]],["ve",["87:17:3"]],["daha",["87:17:3"]],["kalıcıdır",["87:17:3"]]]},{"ayah_ref":"87:18","baseline_text":"Kuşkusuz bu, önceki sayfalarda yer alır.","target_tokens":[
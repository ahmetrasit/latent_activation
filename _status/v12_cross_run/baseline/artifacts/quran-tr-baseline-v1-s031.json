met",["31:27:21"]],["sahibidir",["31:27:18","31:27:21"]]]},{"ayah_ref":"31:28","baseline_text":"Sizin yaratılmanız da diriltilmeniz de tek bir canınki gibidir. Allah işitendir, görendir.","target_tokens":[["Sizin",["31:28:2"]],["yaratılmanız",["31:28:1","31:28:2"]],["da",["31:28:3"]],["diriltilmeniz",["31:28:3","31:28:4"]],["de",["31:28:3"]],["tek",["31:28:7"]],["bir",["31:28:7"]],["canınki",["31:28:6"]],["gibidir",["31:28:5"]],["Allah",["31:28:9"]],["işitendir",["31:28:10"]],["görendir",["31:28:8","31:28:11"]]]},{"ayah_ref":"31:29","baseline_text":"Allah'ın geceyi gündüzün içine kattığını, gündüzü de gecenin içine kattığını; güneşi ve ayı buyruğu altına verdiğini görmedin mi? Her biri belirlenmiş bir süreye kadar akıp gider. Allah yaptıklarınızdan haberdardır.","target_tokens":[["Allah'ın",["31:29:4"]],["geceyi",["31:29:6"]],["gündüzün",["31:29:8"]],["içine",["31:29:7"]],["kattığını",["31:29:3","31:29:5"]],["gündüzü",["31:29:10"]],["de",["31:29:9"]],["gecenin",["31:29:12"]],["içine",["31:29:11"]],["kattığını",["31:29:9"]],["güneşi",["31:29:14"]],["ve",["31:29:15"]],["ayı",["31:29:15"]],["buyruğu",["31:29:13"]],["altına",["31:29:13"]],["verdiğini",["31:29:13"]],["görmedin",["31:29:1","31:29:2"]],["mi",["31:29:1"]],["Her",["31:29:16"]],["biri",["31:29:16"]],["belirlenmiş",["31:29:20"]],["bir",["31:29:19"]],["süreye",["31:29:19"]],["kadar",["31:29:18"]],["akıp",["31:29:17"]],["gider",["31:29:17"]],["Allah",["31:29:22"]],["yaptıklarınızdan",["31:29:23","31:29:24"]],["haberdardır",["31:29:21","31:29:25"]]]},{"ayah_ref":"31:30","baseline_text":"Bu böyledir; çünkü Allah gerçektir, O'nun dışında çağırdıkları ise asılsızdır. Allah yücedir, büyüktür.","target_tokens":[["Bu",["31:30:1"]],["böyledir",["31:30:1"]],["çünkü",["31:30:2"]],["Allah",["31:30:3"]],["gerçektir",["31:30:4","31:30:5"]],["O'nun",["31:30:10"]],["dışında",["31:30:9","31:30:10"]],["çağırdıkları",["31:30:8"]],["ise",["31:30:6"]],["asılsızdır",["31:30:7","31:30:11"]],["Allah",["31:30:13"]],["yücedir",["31:30:15"]],["büyüktür",["31:30:12","31:30:14","31:30:16"]]]},{"ayah_ref":"31:31","baseline_text":"Gemilerin, size ayetlerinden bazısını göstermek için Allah'ın nimetiyle denizde akıp gittiğini görmedin mi? Bunda çok sabırlı ve çok şükreden herkes için işaretler vardır.","target_tokens":[["Gemilerin",["31:31:4"]],["size",["31:31:10"]],["ayetlerinden",["31:31:12"]],["bazısını",["31:31:11"]],["göstermek",["31:31:10"]],["için",["31:31:10"]],["Allah'ın",["31:31:9"]],["nimetiyle",["31:31:8"]],["denizde",["31:31:6","31:31:7"]],["akıp",["31:31:5"]],["gittiğini",["31:31:5"]],["görmedin",["31:31:1","31:31:2"]],["mi",["31:31:1"]],["Bunda",["31:31:14","31:31:15"]],["çok",["31:31:18"]],["sabırlı",["31:31:18"]],["ve",["31:31:19"]],["çok",["31:31:19"]],["şükreden",["31:31:19"]],["herkes",["31:31:17"]],["için",["31:31:17"]],["işaretler",["31:31:16"]],["vardır",["31:31:3","31:31:13","31:31:16"]]]},{"ayah_ref":"31:32","baseline_text":"Dağlar gibi dalgalar onları kapladığında, dini yalnız O'na özgü kılarak Allah'a yalvarırlar. Allah onları karaya çıkarıp kurtardığında içlerinden kimi orta yolu tutar. Ayetlerimizi ancak çok hain ve çok nankör olanlar inkâr eder.","target_tokens":[["Dağlar",["31:32:4"]],["gibi",["31:32:4"]],["dalgalar",["31:32:3"]],["onları",["31:32:2"]],["kapladığında",["31:32:1","31:32:2"]],["dini",["31:32:9"]],["yalnız",["31:32:7"]],["O'na",["31:32:8"]],["özgü",["31:32:7"]],["kılarak",["31:32:7"]],["Allah'a",["31:32:6"]],["yalvarırlar",["31:32:5"]],["Allah",["31:32:11"]],["onları",["31:32:11"]],["karaya",["31:32:12","31:32:13"]],["çıkarıp",["31:32:11"]],["kurtardığında",["31:32:10","31:32:11"]],["içlerinden",["31:32:14"]],["kimi",["31:32:15"]],["orta",["31:32:15"]],["yolu",["31:32:15"]],["tutar",["31:32:15"]],["Ayetlerimizi",["31:32:18"]],["ancak",["31:32:19"]],["çok",["31:32:21"]],["hain",["31:32:21"]],["ve",["31:32:22"]],["çok",["31:32:22"]],["nankör",["31:32:22"]],["olanlar",["31:32:20"]],["inkâr",["31:32:17"]],["eder",["31:32:16","31:32:17"]]]},{"ayah_ref":"31:33","baseline_text":"Ey insanlar, Rabbinize karşı gelmekten sakının ve hiçbir babanın çocuğu adına bir karşılık veremeyeceği, hiçbir çocuğun da babası adına hiçbir karşılık veremeyeceği günden korkun. Allah'ın vaadi gerçektir. Dünya hayatı sizi aldatmasın; o aldatıcı da Allah hakkında sizi aldatmasın.","target_tokens":[["Ey",["31:33:1"]],["insanlar",["31:33:2"]],["Rabbinize",["31:33:4"]],["karşı",["31:33:3"]],["gelmekten",["31:33:3"]],["sakının",["31:33:3"]],["ve",["31:33:5"]],["hiçbir",["31:33:9"]],["babanın",["31:33:9"]],["çocuğu",["31:33:11"]],["adına",["31:33:10"]],["bir",["31:33:18"]],["karşılık",["31:33:8"]],["veremeyeceği",["31:33:7","31:33:8"]],["hiçbir",["31:33:13"]],["çocuğun",["31:33:13"]],["da",["31:33:12"]],["babası",["31:33:17"]],["adına",["31:33:16"]],["hiçbir",["31:33:18"]],["karşılık",["31:33:18"]],["veremeyeceği",["31:33:14","31:33:15"]],["günden",["31:33:6"]],["korkun",["31:33:5"]],["Allah'ın",["31:33:21"]],["vaadi",["31:33:20"]],["gerçektir",["31:33:19","31:33:22"]],["Dünya",["31:33:26"]],["hayatı",["31:33:25"]],["sizi",["31:33:24"]],["aldatmasın",["31:33:23","31:33:24"]],["o",["31:33:30"]],["aldatıcı",["31:33:30"]],["da",["31:33:27"]],["Allah",["31:33:29"]],["hakkında",["31:33:29"]],["sizi",["31:33:28"]],["aldatmasın",["31:33:27","31:33:28"]]]},{"ayah_ref":"31:34","baseline_text":"Kıyametin bilgisi Allah'ın katındadır. Yağmuru O indirir ve rahimlerde olanı O bilir. Hiç kimse yarın ne kazanacağını bilmez; hiç kimse hangi yerde öleceğini bilmez. Allah bilendir, haberdardır.","target_tokens":[["Kıyametin",["31:34:5"]],["bilgisi",["31:34:4"]],["Allah'ın",["31:34:2"]],["katındadır",["31:34:1","31:34:3"]],["Yağmuru",["31:34:7"]],["O",["31:34:2"]],["indirir",["31:34:6"]],["ve",["31:34:8"]],["rahimlerde",["31:34:10","31:34:11"]],["olanı",["31:34:9"]],["O",["31:34:2"]],["bilir",["31:34:8"]],["Hiç",["31:34:14"]],["kimse",["31:34:14"]],["yarın",["31:34:17"]],["ne",["31:34:15"]],["kazanacağını",["31:34:16"]],["bilmez",["31:34:12","31:34:13"]],["hiç",["31:34:20"]],[
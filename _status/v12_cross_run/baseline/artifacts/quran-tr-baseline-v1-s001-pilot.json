{"language":"tr","ayat":[{"ayah_ref":"1:1","baseline_text":"Merhameti sınırsız, merhamet eden Allah'ın adıyla.","target_tokens":[["Merhameti",["1:1:3"]],["sınırsız",["1:1:3"]],["merhamet",["1:1:4"]],["eden",["1:1:4"]],["Allah'ın",["1:1:2"]],["adıyla",["1:1:1"]]]},{"ayah_ref":"1:2","baseline_text":"Her türlü övgü Allah'a, bütün varlıkların Rabbine aittir.","target_tokens":[["Her",["1:2:1"]],["türlü",["1:2:1"]],["övgü",["1:2:1"]],["Allah'a",["1:2:2"]],["bütün",["1:2:4"]],["varlıkların",["1:2:4"]],["Rabbine",["1:2:3"]],["aittir",["1:2:2"]]]},{"ayah_ref":"1:3","baseline_text":"Merhameti sınırsızdır, merhamet edendir.","target_tokens":[["Merhameti",["1:3:1"]],["sınırsızdır",["1:3:1"]],["merhamet",["1:3:2"]],["edendir",["1:3:2"]]]},{"ayah_ref":"1:4","baseline_text":"Hesap gününün sahibidir.","target_tokens":[["Hesap",["1:4:3"]],["gününün",["1:4:2"]],["sahibidir",["1:4:1"]]]},{"ayah_ref":"1:5","baseline_text":"Yalnız sana kulluk ederiz ve yalnız senden yardım isteriz.","target_tokens":[["Yalnız",["1:5:1"]],["sana",["1:5:1"]],["kulluk",["1:5:2"]],["ederiz",["1:5:2"]],["ve",["1:5:3"]],["yalnız",["1:5:3"]],["senden",["1:5:3"]],["yardım",["1:5:4"]],["isteriz",["1:5:4"]]]},{"ayah_ref":"1:6","baseline_text":"Bizi doğru yola ilet.","target_tokens":[["Bizi",["1:6:1"]],["doğru",["1:6:3"]],["yola",["1:6:2"]],["ilet",["1:6:1"]]]},{"ayah_ref":"1:7","baseline_text":"Kendilerine iyilikte bulunduğun kimselerin yoluna; öfkeye uğrayanların ve sapmışların yoluna değil.","target_tokens":[["Kendilerine",["1:7:4"]],["iyilikte",["1:7:3"]],["bulunduğun",["1:7:3"]],["kimselerin",["1:7:2"]],["yoluna",["1:7:1"]],["öfkeye",["1:7:6"]],["uğrayanların",["1:7:6","1:7:7"]],["ve",["1:7:8"]],["sapmışların",["1:7:9"]],["yoluna",["1:7:1"]],["değil",["1:7:5","1:7:8"]]]}]}

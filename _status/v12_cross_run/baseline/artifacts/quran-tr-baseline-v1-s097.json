{"language":"tr","ayat":[{"ayah_ref":"97:1","baseline_text":"Şüphesiz biz onu Kadir Gecesi'nde indirdik.","target_tokens":[["Şüphesiz",["97:1:1"]],["biz",["97:1:1","97:1:2"]],["onu",["97:1:2"]],["Kadir",["97:1:5"]],["Gecesi'nde",["97:1:3","97:1:4","97:1:5"]],["indirdik",["97:1:2"]]]},{"ayah_ref":"97:2","baseline_text":"Ve Kadir Gecesi'nin ne olduğunu sana ne bildirdi?","target_tokens":[["Ve",["97:2:1"]],["Kadir",["97:2:5"]],["Gecesi'nin",["97:2:4","97:2:5"]],["ne",["97:2:3"]],["olduğunu",["97:2:3","97:2:4","97:2:5"]],["sana",["97:2:2"]],["ne",["97:2:1"]],["bildirdi",["97:2:2"]]]},{"ayah_ref":"97:3","baseline_text":"Kadir Gecesi bin aydan daha iyidir.","target_tokens":[["Kadir",["97:3:2"]],["Gecesi",["97:3:1","97:3:2"]],["bin",["97:3:5"]],["aydan",["97:3:4","97:3:6"]],["daha",["97:3:3","97:3:4"]],["iyidir",["97:3:3"]]]},{"ayah_ref":"97:4","baseline_text":"Melekler ve Ruh, Rablerinin izniyle onda her iş için inerler.","target_tokens":[["Melekler",["97:4:2"]],["ve",["97:4:3"]],["Ruh",["97:4:3"]],["Rablerinin",["97:4:6"]],["izniyle",["97:4:5","97:4:6"]],["onda",["97:4:4"]],["her",["97:4:8"]],["iş",["97:4:9"]],["için",["97:4:7","97:4:8","97:4:9"]],["inerler",["97:4:1","97:4:2","97:4:3"]]]},{"ayah_ref":"97:5","baseline_text":"O, şafağın doğuşuna kadar esenliktir.","target_tokens":[["O",["97:5:2"]],["şafağın",["97:5:5"]],["doğuşuna",["97:5:4","97:5:5"]],["kadar",["97:5:3"]],["esenliktir",["97:5:1"]]]}]}

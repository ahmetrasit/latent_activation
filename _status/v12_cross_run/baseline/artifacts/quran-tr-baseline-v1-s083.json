{"language":"tr","ayat":[{"ayah_ref":"83:1","baseline_text":"Eksik verenlerin vay haline!","target_tokens":[["Eksik",["83:1:2"]],["verenlerin",["83:1:2"]],["vay",["83:1:1"]],["haline",["83:1:1","83:1:2"]]]},{"ayah_ref":"83:2","baseline_text":"Onlar insanlardan ölçüp aldıkları zaman tam alırlar.","target_tokens":[["Onlar",["83:2:1"]],["insanlardan",["83:2:4","83:2:5"]],["ölçüp",["83:2:3"]],["aldıkları",["83:2:3"]],["zaman",["83:2:2"]],["tam",["83:2:6"]],["alırlar",["83:2:6"]]]},{"ayah_ref":"83:3","baseline_text":"Onlara ölçtüklerinde veya tarttıklarında ise eksik verirler.","target_tokens":[["Onlara",["83:3:2"]],["ölçtüklerinde",["83:3:1","83:3:2"]],["veya",["83:3:3"]],["tarttıklarında",["83:3:4"]],["ise",["83:3:1"]],["eksik",["83:3:5"]],["verirler",["83:3:5"]]]},{"ayah_ref":"83:4","baseline_text":"Onlar, diriltileceklerini sanmıyorlar mı?","target_tokens":[["Onlar",["83:4:3"]],["diriltileceklerini",["83:4:4","83:4:5"]],["sanmıyorlar",["83:4:1","83:4:2"]],["mı",["83:4:1"]]]},{"ayah_ref":"83:5","baseline_text":"Büyük bir gün için;","target_tokens":[["Büyük",["83:5:2"]],["bir",["83:5:1"]],["gün",["83:5:1"]],["için",["83:5:1"]]]},{"ayah_ref":"83:6","baseline_text":"İnsanların âlemlerin Rabbi için ayağa kalkacağı gün.","target_tokens":[["İnsanların",["83:6:3"]],["âlemlerin",["83:6:5"]],["Rabbi",["83:6:4"]],["için",["83:6:4"]],["ayağa",["83:6:2"]],["kalkacağı",["83:6:2"]],["gün",["83:6:1"]]]},{"ayah_ref":"83:7","baseline_text":"Hayır! Kötülerin kaydı kesinlikle Siccîn'dedir.","target_tokens":[["Hayır",["83:7:1"]],["Kötülerin",["83:7:4"]],["kaydı",["83:7:3"]],["kesinlikle",["83:7:2","83:7:5"]],["Siccîn'dedir",["83:7:5","83:7:6"]]]},{"ayah_ref":"83:8","baseline_text":"Peki Siccîn'in ne olduğunu sana ne bildirdi?","target_tokens":[["Peki",["83:8:1"]],["Siccîn'in",["83:8:4"]],["ne",["83:8:3"]],["olduğunu",["83:8:3","83:8:4"]],["sana",["83:8:2"]],["ne",["83:8:1"]],["bildirdi",["83:8:2"]]]},{"ayah_ref":"83:9","baseline_text":"Yazılı bir kayıt.","target_tokens":[["Yazılı",["83:9
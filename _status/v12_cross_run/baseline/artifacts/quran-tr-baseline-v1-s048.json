ildi",["48:18:10"]],["üzerlerine",["48:18:16"]],["huzur",["48:18:15"]],["indirdi",["48:18:14"]],["ve",["48:18:17"]],["onları",["48:18:17"]],["yakın",["48:18:19"]],["bir",["48:18:18"]],["fetihle",["48:18:18"]],["ödüllendirdi",["48:18:17"]]]},{"ayah_ref":"48:19","baseline_text":"Bir de alacakları birçok ganimetle ödüllendirdi. Allah güçlüdür ve bilgece hükmedendir.","target_tokens":[["Bir",["48:19:1"]],["de",["48:19:1"]],["alacakları",["48:19:3"]],["birçok",["48:19:2"]],["ganimetle",["48:19:1"]],["ödüllendirdi",["48:19:3"]],["Allah",["48:19:5"]],["güçlüdür",["48:19:6"]],["ve",["48:19:4"]],["bilgece",["48:19:7"]],["hükmedendir",["48:19:4","48:19:7"]]]},{"ayah_ref":"48:20","baseline_text":"Allah size alacağınız birçok ganimet vadetti ve bunu size hemen verdi. İnsanların ellerini sizden çekti ki bu, inananlar için bir işaret olsun ve sizi dosdoğru bir yola iletsin.","target_tokens":[["Allah",["48:20:2"]],["size",["48:20:1"]],["alacağınız",["48:20:5"]],["birçok",["48:20:4"]],["ganimet",["48:20:3"]],["vadetti",["48:20:1"]],["ve",["48:20:6"]],["bunu",["48:20:8"]],["size",["48:20:7"]],["hemen",["48:20:6"]],["verdi",["48:20:6"]],["İnsanların",["48:20:11"]],["ellerini",["48:20:10"]],["sizden",["48:20:12"]],["çekti",["48:20:9"]],["ki",["48:20:13"]],["bu",["48:20:8","48:20:14"]],["inananlar",["48:20:15"]],["için",["48:20:15"]],["bir",["48:20:14"]],["işaret",["48:20:14"]],["olsun",["48:20:13"]],["ve",["48:20:16"]],["sizi",["48:20:16"]],["dosdoğru",["48:20:18"]],["bir",["48:20:17"]],["yola",["48:20:17"]],["iletsin",["48:20:16"]]]},{"ayah_ref":"48:21","baseline_text":"Henüz elde edemediğiniz başka ganimetler de vardır; Allah onları kuşatmıştır. Allah her şeye gücü yetendir.","target_tokens":[["Henüz",["48:21:2"]],["elde",["48:21:3","48:21:4"]],["edemediğiniz",["48:21:2","48:21:3"]],["başka",["48:21:1"]],["ganimetler",["48:21:1"]],["de",["48:21:1"]],["vardır",["48:21:1"]],["Allah",["48:21:7"]],["onları",["48:21:8"]],["kuşatmıştır",["48:21:5","48:21:6"]],["Allah",["48:21:10"]],["her",["48:21:12"]],["şeye",["48:21:13"]],["gücü",["48:21:14"]],["yetendir",["48:21:9","48:21:11","48:21:14"]]]},{"ayah_ref":"48:22","baseline_text":"İnkâr edenler sizinle savaşsaydı arkalarını dönüp kaçarlardı; sonra ne bir koruyucu ne de bir yardımcı bulabilirlerdi.","target_tokens":[["İnkâr",["48:22:4"]],["edenler",["48:22:3","48:22:4"]],["sizinle",["48:22:2"]],["savaşsaydı",["48:22:1","48:22:2"]],["arkalarını",["48:22:6"]],["dönüp",["48:22:5"]],["kaçarlardı",["48:22:5"]],["sonra",["48:22:7"]],["ne",["48:22:8"]],["bir",["48:22:10"]],["koruyucu",["48:22:10"]],["ne",["48:22:11"]],["de",["48:22:11"]],["bir",["48:22:12"]],["yardımcı",["48:22:12"]],["bulabilirlerdi",["48:22:9"]]]},{"ayah_ref":"48:23","baseline_text":"Bu, Allah'ın daha önce de sürüp gelmiş yasasıdır. Allah'ın yasasında hiçbir değişiklik bulamazsın.","target_tokens":[["Bu",["48:23:1"]],["Allah'ın",["48:23:2"]],["daha",["48:23:6"]],["önce",["48:23:7"]],["de",["48:23:4"]],["sürüp",["48:23:5"]],["gelmiş",["48:23:3","48:23:4","48:23:5"]],["yasasıdır",["48:23:1"]],["Allah'ın",["48:23:11"]],["yasasında",["48:23:10"]],["hiçbir",["48:23:8"]],["değişiklik",["48:23:12"]],["bulamazsın",["48:23:8","48:23:9"]]]},{"ayah_ref":"48:24","baseline_text":"Sizi onlara üstün getirdikten sonra Mekke'nin ortasında onların ellerini sizden, sizin ellerinizi de onlardan çeken O'dur. Allah yaptıklarınızı görmektedir.","target_tokens":[["Sizi",["48:24:13"]],["onlara",["48:24:14"]],["üstün",["48:24:13"]],["getirdikten",["48:24:10","48:24:11","48:24:12"]],["sonra",["48:24:11"]],["Mekke'nin",["48:24:9"]],["ortasında",["48:24:8"]],["onların",["48:24:4"]],["ellerini",["48:24:4"]],["sizden",["48:24:5"]],["sizin",["48:24:6"]],["ellerinizi",["48:24:6"]],["de",["48:24:6"]],["onlardan",["48:24:7"]],["çeken",["48:24:3"]],["O'dur",["48:24:1","48:24:2"]],["Allah",["48:24:16"]],["yaptıklarınızı",["48:24:17","48:24:18"]],["görmektedir",["48:24:15","48:24:19"]]]},{"ayah_ref":"48:25","baseline_text":"İnkâr eden, sizi Mescid-i Haram'dan alıkoyan ve kurbanlıkları varacakları yere ulaşmaktan engelleyenler onlardır. Tanımadığınız inanan erkeklerle inanan kadınları bilmeden ezip onlar yüzünden bir vebale uğramayasınız ve Allah dilediğini rahmetine koysun diye ellerinizi onlardan çekti. Eğer birbirlerinden ayrılmış olsalardı, içlerinden inkâr edenlere acı veren bir azap ederdik.","target_tokens":[["İnkâr",["48:25:3"]],["eden",["48:25:2","48:25:3"]],["sizi",["48:25:4"]],["Mescid-i",["48:25:6"]],["Haram'dan",["48:25:5","48:25:7"]],["alıkoyan",["48:25:4"]],["ve",["48:25:8"]],["kurbanlıkları",["48:25:8"]],["varacakları",["48:25:12"]],["yere",["48:25:12"]],["ulaşmaktan",["48:25:10","48:25:11"]],["engelleyenler",["48:25:9"]],["onlardır",["48:25:1"]],["Tanımadığınız",["48:25:18","48:25:19"]],["inanan",["48:25:15"]],["erkeklerle",["48:25:14"]],["inanan",["48:25:17"]],["kadınları",["48:25:16","48:25:17"]],["bilmeden",["48:25:25","48:25:26"]],["ezip",["48:25:20","48:25:21"]],["onlar",["48:25:23"]],["yüzünden",["48:25:23"]],["bir",["48:25:24"]],["vebale",["48:25:24"]],["uğramayasınız",["48:25:13","48:25:22"]],["ve",["48:25:27"]],["Allah",["48:25:28"]],["dilediğini",["48:25:31","48:25:32"]],["rahmetine",["48:25:29","48:25:30"]],["koysun",["48:25:27"]],["diye",["48:25:27"]],["ellerinizi",["48:25:21"]],["onlardan",["48:25:23"]],["çekti",["48:25:13"]],["Eğer",["48:25:33"]],["birbirlerinden",["48:25:34"]],["ayrılmış",["48:25:34"]],["olsalardı",["48:25:33","48:25:34"]],["içlerinden",["48:25:38"]],["inkâr",["48:25:37"]],["edenlere",["48:25:36","48:25:37"]],["acı",["48:25:40"]],["veren",["48:25:40"]],["bir",["48:25:39"]],["azap",["48:25:39"]],["ederdik",["48:25:35"]]]},{"ayah_ref":"48:26","baseline_text":"İnkâr edenler kalplerine bağnazlığı, bilgisizlik döneminin bağnazlığını yerleştirdiklerinde Allah elçisine ve inananlara huzurunu indirdi, onları Allah'a karşı gelmekten sakınma sözüne bağlı kıldı. Onlar buna daha layık ve ehildi. Allah her şeyi bilendir.","target_tokens":[["İnkâr",["48:26:4"]],["edenler",["48:26:3","48:26:4"]],["kalplerine",["48:26:5","48:26:6"]],["bağnazlığı",["48:26:7"]],["bilgisizlik",["48:26:9"]],["döneminin",["48:26:9"]],["bağnazlığını",["48:26:8"]],["yerleştirdiklerinde",["48:26:1","48:26:2"]],["Allah",["48:26:11"]],["elçisine",["48:26:13","48:26:14"]],["ve",["48:26:15"]],["inananlara",["48:26:15","48:26:16"]],["huzurunu",["48:26:12"]],["indirdi",["48:26:10"]],["onları",["48:26:17"]],["Allah'a",["48:26:19"]],["karşı",["48:26:19"]],["gelmekten",["48:26:19"]],["sakınma",["48:26:19"]],["sözüne",["48:26:18"]],["bağlı",["48:26:17"]],["kıldı",["48:26:17"]],["Onlar",["48:26:20"]],["buna",["48:26:22"]],["daha",["48:26:21"]],["layık",["48:26:21"]],["ve",["48:26:23"]],["ehildi",["48:26:20","48:26:23"]],["Allah",["48:26:25"]],["her",["48:26:26"]],["şeyi",["48:26:27"]],["bilendir",["48:26:24","48:26:28"]]]},{"ayah_ref":"48:27","baseline_text":"Allah elçisine rüyayı kesinlikle doğru gösterdi: Allah dilerse Mescid-i Haram'a güven içinde, başlarınızı tıraş etmiş veya saçlarınızı kısaltmış olarak, korkmadan mutlaka gireceksiniz. Allah sizin bilmediğinizi bildi ve bundan önce yakın bir fetih verdi.","target_tokens":[["Allah",["48:27:3"]],["elçisine",["48:27:4"]],["rüyayı",["48:27:5"]],["kesinlikle",["48:27:1"]],["doğru",["48:27:6"]],["gösterdi",["48:27:2"]],["Allah",["48:27:12"]],["dilerse",["48:27:10","48:27:11"]],["Mescid-i",["48:27:8"]],["Haram'a",["48:27:9"]],["güven",["48:27:13"]],["içinde",["48:27:13"]],["başlarınızı",["48:27:15"]],["tıraş",["48:27:14"]],["etmiş",["48:27:14"]],["veya",["48:27:16"]],["saçlarınızı",["48:27:15","48:27:16"]],["kısaltmış",["48:27:16"]],["olarak",["48:27:13"]],["korkmadan",["48:27:17","48:27:18"]],["mutlaka",["48:27:7"]],["gireceksiniz",["48:27:7"]],["Allah",["48:27:19"]],["sizin",["48:27:22"]],["bilmediğinizi",["48:27:20","48:27:21","48:27:22"]],["bildi",["48:27:19"]],["ve",["48:27:23"]],["bundan",["48:27:26"]],["önce",["48:27:24","48:27:25"]],["yakın",["48:27:28"]],["bir",["48:27:27"]],["fetih",["48:27:27"]],["verdi",["48:27:23"]]]},{"ayah_ref":"48:28","baseline_text":"Elçisini doğru yol ve hak dinle gönderen O'dur; böylece onu bütün dinlere üstün kılsın. Tanık olarak Allah yeter.","target_tokens":[["Elçisini",["48:28:4"]],["doğru",["48:28:5"]],["yol",["48:28:5"]],["ve",["48:28:6"]],["hak",["48:28:7"]],["dinle",["48:28:6","48:28:7"]],["gönderen",["48:28:3"]],["O'dur",["48:28:1","48:28:2"]],["böylece",["48:28:8"]],["onu",["48:28:8"]],["bütün",["48:28:11"]],["dinlere",["48:28:9","48:28:10"]],["üstün",["48:28:8"]],["kılsın",["48:28:8"]],["Tanık",["48:28:14"]],["olarak",["48:28:14"]],["Allah",["48:28:13"]],["yeter",["48:28:12"]]]},{"ayah_ref":"48:29","baseline_text":"Muhammed Allah'ın elçisidir. Onunla birlikte olanlar inkârcılara karşı sert, kendi aralarında merhametlidir. Onları eğilip yere kapanırken, Allah'tan lütuf ve hoşnutluk isterken görürsün. Yere kapanmanın etkisinden doğan belirtileri yüzlerindedir. Tevrat'taki örnekleri budur. İncil'deki örnekleri ise filizini çıkarıp onu güçlendiren, sonra kalınlaşıp gövdesi üzerinde doğrulan ve ekincilerin hoşuna giden bir ekin gibidir. Bu, onlar aracılığıyla inkârcıları öfkelendirmek içindir. Allah, onlardan inanıp iyi işler yapanlara bağışlanma ve büyük bir ödül vadetmiştir.","target_tokens":[["Muhammed",["48:29:1"]],["Allah'ın",["48:29:3"]],["elçisidir",["48:29:2"]],["Onunla",["48:29:5"]],["birlikte",["48:29:5"]],["olanlar",["48:29:4"]],["inkârcılara",["48:29:8"]],["karşı",["48:29:7"]],["sert",["48:29:6"]],["kendi",["48:29:10"]],["aralarında",["48:29:10"]],["merhametlidir",["48:29:9"]],["Onları",["48:29:11"]],["eğilip",["48:29:12"]],["yere",["48:29:13"]],["kapanırken",["48:29:13"]],["Allah'tan",["48:29:16","48:29:17"]],["lütuf",["48:29:15"]],["ve",["48:29:18"]],["hoşnutluk",["48:29:18"]],["isterken",["48:29:14"]],["görürsün",["48:29:11"]],["Yere",["48:29:24"]],["kapanmanın",["48:29:24"]],["etkisinden",["48:29:22","48:29:23"]],["doğan",["48:29:23"]],["belirtileri",["48:29:19"]],["yüzlerindedir",["48:29:20","48:29:21"]],["Tevrat'taki",["48:29:27","48:29:28"]],["örnekleri",
ne_text":"Onlar için gemiye benzer binecekleri başka şeyler de yarattık.","target_tokens":[["Onlar",["36:42:1"]],["için",["36:42:1"]],["gemiye",["36:42:2"]],["benzer",["36:42:3"]],["binecekleri",["36:42:3"]],["başka",["36:42:4"]],["şeyler",["36:42:5"]],["de",["36:42:5"]],["yarattık",["36:42:6"]]]},{"ayah_ref":"36:43","baseline_text":"Dilersek onları boğarız; o zaman yardım çağrılarına koşan olmaz ve kurtarılamazlar.","target_tokens":[["Dilersek",["36:43:1"]],["onları",["36:43:1"]],["boğarız",["36:43:2"]],["o",["36:43:3"]],["zaman",["36:43:4"]],["yardım",["36:43:5"]],["çağrılarına",["36:43:5"]],["koşan",["36:43:6"]],["olmaz",["36:43:7"]],["ve",["36:43:8"]],["kurtarılamazlar",["36:43:9"]]]},{"ayah_ref":"36:44","baseline_text":"Ancak tarafımızdan bir merhamet ve bir süreye kadar yararlanma vardır.","target_tokens":[["Ancak",["36:44:1"]],["tarafımızdan",["36:44:1"]],["bir",["36:44:2"]],["merhamet",["36:44:2"]],["ve",["36:44:3"]],["bir",["36:44:4"]],["süreye",["36:44:4"]],["kadar",["36:44:5"]],["yararlanma",["36:44:5"]],["vardır",["36:44:6"]]]},{"ayah_ref":"36:45","baseline_text":"Onlara, 'Merhamet görebilmeniz için önünüzdekinden ve arkanızdakinden sakının' denildiğinde yüz çevirirler.","target_tokens":[["Onlara",["36:45:1"]],["Merhamet",["36:45:2"]],["görebilmeniz",["36:45:3"]],["için",["36:45:4"]],["önünüzdekinden",["36:45:5"]],["ve",["36:45:6"]],["arkanızdakinden",["36:45:7"]],["sakının",["36:45:8"]],["denildiğinde",["36:45:9"]],["yüz",["36:45:10"]],["çevirirler",["36:45:11"]]]},{"ayah_ref":"36:46","baseline_text":"Rablerinin işaretlerinden hangi işaret kendilerine gelse ondan mutlaka yüz çevirirler.","target_tokens":[["Rablerinin",["36:46:1"]],["işaretlerinden",["36:46:2"]],["hangi",["36:46:3"]],["işaret",["36:46:4"]],["kendilerine",["36:46:5"]],["gelse",["36:46:6"]],["ondan",["36:46:7"]],["mutlaka",["36:46:8"]],["yüz",["36:46:9"]],["çevirirler",["36:46:10","36:46:11"]]]},{"ayah_ref":"36:47","baseline_text":"Onlara, 'Allah'ın size verdiği rızıktan harcayın' denildiğ
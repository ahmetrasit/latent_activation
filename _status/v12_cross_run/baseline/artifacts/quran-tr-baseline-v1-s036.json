"]]]},{"ayah_ref":"36:57","baseline_text":"Orada onlar için meyveler ve istedikleri her şey vardır.","target_tokens":[["Orada",["36:57:1"]],["onlar",["36:57:1"]],["için",["36:57:2"]],["meyveler",["36:57:3"]],["ve",["36:57:3"]],["istedikleri",["36:57:4"]],["her",["36:57:5"]],["şey",["36:57:5"]],["vardır",["36:57:6"]]]},{"ayah_ref":"36:58","baseline_text":"Merhametli Rabden söz olarak onlara 'Esenlik' denir.","target_tokens":[["Merhametli",["36:58:1"]],["Rabden",["36:58:1"]],["söz",["36:58:2"]],["olarak",["36:58:3"]],["onlara",["36:58:3"]],["Esenlik",["36:58:4"]],["denir",["36:58:5"]]]},{"ayah_ref":"36:59","baseline_text":"Ey suçlular, bugün siz ayrılın.","target_tokens":[["Ey",["36:59:1"]],["suçlular",["36:59:1"]],["bugün",["36:59:2"]],["siz",["36:59:3"]],["ayrılın",["36:59:4"]]]},{"ayah_ref":"36:60","baseline_text":"Ey Âdemoğulları! Size, 'Şeytana kulluk etmeyin; o sizin apaçık düşmanınızdır' diye buyurmadım mı?","target_tokens":[["Ey",["36:60:1"]],["Âdemoğulları",["36:60:2"]],["Size",["36:60:3"]],["Şeytana",["36:60:4"]],["kulluk",["36:60:5"]],["etmeyin",["36:60:6"]],["o",["36:60:7"]],["sizin",["36:60:8"]],["apaçık",["36:60:9"]],["düşmanınızdır",["36:60:10"]],["diye",["36:60:11"]],["buyurmadım",["36:60:12"]],["mı",["36:60:13"]]]},{"ayah_ref":"36:61","baseline_text":"Bir de, 'Bana kulluk edin; doğru yol budur' demedim mi?","target_tokens":[["Bir",["36:61:1"]],["de",["36:61:1"]],["Bana",["36:61:2"]],["kulluk",["36:61:2"]],["edin",["36:61:3"]],["doğru",["36:61:3"]],["yol",["36:61:4"]],["budur",["36:61:4"]],["demedim",["36:61:5"]],["mi",["36:61:5"]]]},{"ayah_ref":"36:62","baseline_text":"O, sizden pek çok topluluğu saptırdı. Hiç aklınızı kullanmıyor muydunuz?","target_tokens":[["O",["36:62:1"]],["sizden",["36:62:1"]],["pek",["36:62:2"]],["çok",["36:62:3"]],["topluluğu",["36:62:4"]],["saptırdı",["36:62:5"]],["Hiç",["36:62:5"]],["aklınızı",["36:62:6"]],["kullanmıyor",["36:62:7"]],["muydunuz",["36:62:8"]]]},{"ayah_ref":"36:63","baseline_text":"İşte size vaat edilen cehennem budur.","target_tokens":[["İşte",["36:63:1"]],["size",["36:63:1"]],["vaat",["36:63:2"]],["edilen",["36:63:3"]],["cehennem",["36:63:4"]],["budur",["36:63:5"]]]},{"ayah_ref":"36:64","baseline_text":"İnkâr ettiğiniz için bugün oraya girip yanın.","target_tokens":[["İnkâr",["36:64:1"]],["ettiğiniz",["36:64:1"]],["için",["36:64:2"]],["bugün",["36:64:3"]],["oraya",["36:64:3"]],["girip",["36:64:4"]],["yanın",["36:64:5"]]]},{"ayah_ref":"36:65","baseline_text":"O gün ağızlarını mühürleriz; elleri bizimle konuşur, ayakları da kazandıklarına tanıklık eder.","target_tokens":[["O",["36:65:1"]],["gün",["36:65:1"]],["ağızlarını",["36:65:2"]],["mühürleriz",["36:65:3"]],["elleri",["36:65:4"]],["bizimle",["36:65:5"]],["konuşur",["36:65:6"]],["ayakları",["36:65:7"]],["da",["36:65:8"]],["kazandıklarına",["36:65:9"]],["tanıklık",["36:65:10"]],["eder",["36:65:11"]]]},{"ayah_ref":"36:66","baseline_text":"Dileseydik gözlerini silip kör ederdik; sonra yola koşarlardı ama nasıl göreceklerdi?","target_tokens":[["Dileseydik",["36:66:1"]],["gözlerini",["36:66:1"]],["silip",["36:66:2"]],["kör",["36:66:3"]],["ederdik",["36:66:4"]],["sonra",["36:66:5"]],["yola",["36:66:5"]],["koşarlardı",["36:66:6"]],["ama",["36:66:7"]],["nasıl",["36:66:8"]],["göreceklerdi",["36:66:9"]]]},{"ayah_ref":"36:67","baseline_text":"Dileseydik onları oldukları yerde biçimlerini değiştirirdik; ne ileri gidebilir ne de geri dönebilirlerdi.","target_tokens":[["Dileseydik",["36:67:1"]],["onları",["36:67:1"]],["oldukları",["36:67:2"]],["yerde",["36:67:3"]],["biçimlerini",["36:67:4"]],["değiştirirdik",["36:67:4"]],["ne",["36:67:5"]],["ileri",["36:67:6"]],["gidebilir",["36:67:7"]],["ne",["36:67:7"]],["de",["36:67:8"]],["geri",["36:67:9"]],["dönebilirlerdi",["36:67:10"]]]},{"ayah_ref":"36:68","baseline_text":"Kime uzun ömür verirsek yaratılışını tersine çeviririz. Hâlâ akıllarını kullanmayacaklar mı?","target_tokens":[["Kime",["36:68:1"]],["uzun",["36:68:1"]],["ömür",["36:68:2"]],["verirsek",["36:68:2"]],["yaratılışını",["36:68:3"]],["tersine",["36:68:4"]],["çeviririz",["36:68:4"]],["Hâlâ",["36:68:5"]],["akıllarını",["36:68:6"]],["kullanmayacaklar",["36:68:6"]],["mı",["36:68:7"]]]},{"ayah_ref":"36:69","baseline_text":"Biz ona şiir öğretmedik; bu ona uygun da değildir. Bu yalnızca bir öğüt ve apaçık bir Kur'an'dır.","target_tokens":[["Biz",["36:69:1"]],["ona",["36:69:1"]],["şiir",["36:69:2"]],["öğretmedik",["36:69:3"]],["bu",["36:69:3"]],["ona",["36:69:4"]],["uygun",["36:69:5"]],["da",["36:69:5"]],["değildir",["36:69:6"]],["Bu",["36:69:7"]],["yalnızca",["36:69:8"]],["bir",["36:69:8"]],["öğüt",["36:69:9"]],["ve",["36:69:10"]],["apaçık",["36:69:10"]],["bir",["36:69:11"]],["Kur'an'dır",["36:69:12"]]]},{"ayah_ref":"36:70","baseline_text":"Diri olanı uyarması ve inkâr edenler hakkındaki sözün gerçekleşmesi içindir.","target_tokens":[["Diri",["36:70:1"]],["olanı",["36:70:1"]],["uyarması",["36:70:2"]],["ve",["36:70:3"]],["inkâr",["36:70:4"]],["edenler",["36:70:5"]],["hakkındaki",["36:70:5"]],["sözün",["36:70:6"]],["gerçekleşmesi",["36:70:7"]],["içindir",["36:70:8"]]]},{"ayah_ref":"36:71","baseline_text":"Kendi ellerimizle yaptıklarımızdan onlar için hayvanlar yarattığımızı ve onların bunlara sahip olduğunu görmediler mi?","target_tokens":[["Kendi",["36:71:1"]],["ellerimizle",["36:71:1"]],["yaptıklarımızdan",["36:71:2"]],["onlar",["36:71:3"]],["için",["36:71:4"]],["hayvanlar",["36:71:5"]],["yarattığımızı",["36:71:6"]],["ve",["36:71:7"]],["onların",["36:71:7"]],["bunlara",["36:71:8"]],["sahip",["36:71:9"]],["olduğunu",["36:71:10"]],["görmediler",["36:71:11"]],["mi",["36:71:12"]]]},{"ayah_ref":"36:72","baseline_text":"Bu hayvanları onlara boyun eğdirdik. Bazılarına biner, bazılarından da yerler.","target_tokens":[["Bu",["36:72:1"]],["hayvanları",["36:72:1"]],["onlara",["36:72:2"]],["boyun",["36:72:2"]],["eğdirdik",["36:72:3"]],["Bazılarına",["36:72:4"]],["biner",["36:72:4"]],["bazılarından",["36:72:5"]],["da",["36:72:5"]],["yerler",["36:72:6"]]]},{"ayah_ref":"36:73","baseline_text":"Onlar için bu hayvanlarda yararlar ve içecekler vardır. Hâlâ şükretmeyecekler mi?","target_tokens":[["Onlar",["36:73:1"]],["için",["36:73:1"]],["bu",["36:73:2"]],["hayvanlarda",["36:73:2"]],["yararlar",["36:73:3"]],["ve",["36:73:3"]],["içecekler",["36:73:4"]],["vardır",["36:73:4"]],["Hâlâ",["36:73:5"]],["şükretmeyecekler",["36:73:5"]],["mi",["36:73:6"]]]},{"ayah_ref":"36:74","baseline_text":"Belki yardım görürler diye Allah'ı bırakıp başka ilahlar edindiler.","target_tokens":[["Belki",["36:74:1"]],["yardım",["36:74:1"]],["görürler",["36:74:2"]],["diye",["36:74:3"]],["Allah'ı",["36:74:4"]],["bırakıp",["36:74:4"]],["başka",["36:74:5"]],["ilahlar",["36:74:6"]],["edindiler",["36:74:7"]]]},{"ayah_ref":"36:75","baseline_text":"O ilahlar onlara yardım edemez; tersine kendileri o ilahlar için hazır edilmiş bir ordudur.","target_tokens":[["O",["36:75:1"]],["ilahlar",["36:75:1"]],["onlara",["36:75:2"]],["yardım",["36:75:2"]],["edemez",["36:75:3"]],["tersine",["36:75:3"]],["kendileri",["36:75:4"]],["o",["36:75:4"]],["ilahlar",["36:75:5"]],["için",["36:75:5"]],["hazır",["36:75:6"]],["edilmiş",["36:75:6"]],["bir",["36:75:7"]],["ordudur",["36:75:7"]]]},{"ayah_ref":"36:76","baseline_text":"Onların sözü seni üzmesin. Biz onların gizlediklerini de açığa vurduklarını da biliyoruz.","target_tokens":[["Onların",["36:76:1"]],["sözü",["36:76:1"]],["seni",["36:76:2"]],["üzmesin",["36:76:3"]],["Biz",["36:76:4"]],["onların",["36:76:4"]],["gizlediklerini",["36:76:5"]],["de",["36:76:6"]],["açığa",["36:76:7"]],["vurduklarını",["36:76:7"]],["da",["36:76:8"]],["biliyoruz",["36:76:9"]]]},{"ayah_ref":"36:77","baseline_text":"İnsan, kendisini bir damladan yarattığımızı görmedi mi? Birden apaçık bir tartışmacı kesilir.","target_tokens":[["İnsan",["36:77:1"]],["kendisini",["36:77:1"]],["bir",["36:77:2"]],["damladan",["36:77:3"]],["yarattığımızı",["36:77:4"]],["görmedi",["36:77:5"]],["mi",["36:77:6"]],["Birden",["36:77:7"]],["apaçık",["36:77:8"]],["bir",["36:77:9"]],["tartışmacı",["36:77:10"]],["kesilir",["36:77:11"]]]},{"ayah_ref":"36:78","baseline_text":"Kendi yaratılışını unutup bize örnek veriyor ve 'Çürümüş kemiklere kim hayat verecek?' diyor.","target_tokens":[["Kendi",["36:78:1"]],["yaratılışını",["36:78:1"]],["unutup",["36:78:2"]],["bize",["36:78:3"]],["örnek",["36:78:4"]],["veriyor",["36:78:5"]],["ve",["36:78:6"]],["Çürümüş",["36:78:6"]],["kemiklere",["36:78:7"]],["kim",["36:78:8"]],["hayat",["36:78:9"]],["verecek",["36:78:10"]],["diyor",["36:78:11"]]]},{"ayah_ref":"36:79","baseline_text":"De ki: 'Onlara ilk kez hayat veren, yine hayat verecektir. O, her yaratmayı bilir.'","target_tokens":[["De",["36:79:1"]],["ki",["36:79:1"]],["Onlara",["36:79:2"]],["ilk",["36:79:3"]],["kez",["36:79:3"]],["hayat",["36:79:4"]],["veren",["36:79:5"]],["yine",["36:79:6"]],["hayat",["36:79:6"]],["verecektir",["36:79:7"]],["O",["36:79:8"]],["her",["36:79:8"]],["yaratmayı",["36:79:9"]],["bilir",["36:79:10"]]]},{"ayah_ref":"36:80","baseline_text":"O, sizin için yeşil ağaçtan ateş çıkarandır; siz de ondan ateş yakarsınız.","target_tokens":[["O",["36:80:1"]],["sizin",["36:80:1"]],["için",["36:80:2"]],["yeşil",["36:80:3"]],["ağaçtan",["36:80:4"]],["ateş",["36:80:5"]],["çıkarandır",["36:80:6"]],["siz",["36:80:7"]],["de",["36:80:8"]],["ondan",["36:80:9"]],["ateş",["36:80:10"]],["yakarsınız",["36:80:11"]]]},{"ayah_ref":"36:81","baseline_text":"Gökleri ve yeri yaratan, onların benzerini yaratmaya güç yetiremez mi? Elbette yeter. O, her şeyi yaratan ve her şeyi bilendir.","target_tokens":[["Gökleri",["36:81:1"]],["ve",["36:81:1"]],["yeri",["36:81:2"]],["yaratan",["36:81:3"]],["onların",["36:81:3"]],["benzerini",["36:81:4"]],["yaratmaya",["36:81:5"]],["güç",["36:81:5"]],["yetiremez",["36:81:6"]],["mi",["36:81:7"]],["Elbette",["36:81:8"]],["yeter",["36:81:8"]],["O",["36:81:9"]],["her",["36:81:10"]],["şeyi",["36:81:10"]],["yaratan",["36:81:11"]],["ve",["36:81:12"]],["her",["36:81:12"]],["şeyi",["36:81:13"]],["bilendir",["36:81:14"]]]},{"ayah_ref":"36:82","baseline_text":"O bir şeyi dilediğinde buyruğu yalnızca ona 'Ol' demektir; o da oluverir.","target_tokens":[["O",["36:82:1"]],["bir",["36:82:1"]],["şeyi",["36:82:2"]],["dilediğinde",["36:82:3"]],["buyruğu",["36:82:4"]],["yalnızca",["36:82:5"]],["ona",["36:82:6"]],["Ol",["36:82:6"]],["demektir",["36:82:7"]],["o",["36:82:8"]],["da",["36:82:9"]],["oluverir",["36:82:10"]]]},{"ayah_ref":"36:83","baseline_text":"Her şeyin hükümranlığı elinde olan eksiklikten uzaktır. Siz ona döndürüleceksiniz.","target_tokens":[["Her",["36:83:1"]],["şeyin",["36:83:1"]],["hükümranlığı",["36:83:2"]],["elinde",["36:83:3"]],["olan",["36:83:4"]],["eksiklikten",["36:83:5"]],["uzaktır",["36:83:5"]],["Siz",["36:83:6"]],["ona",["36:83:7"]],["döndürüleceksiniz",["36:83:8"]]]}]}

16","43:51:17"]]]},{"ayah_ref":"43:52","baseline_text":"Yoksa ben, şu aşağılık ve neredeyse kendini anlatamayan adamdan daha iyi değil miyim?","target_tokens":[["Yoksa",["43:52:1"]],["ben",["43:52:2"]],["şu",["43:52:5"]],["aşağılık",["43:52:8"]],["ve",["43:52:9"]],["neredeyse",["43:52:10"]],["kendini",["43:52:11"]],["anlatamayan",["43:52:11"]],["adamdan",["43:52:6","43:52:7"]],["daha",["43:52:3","43:52:4"]],["iyi",["43:52:3"]],["değil",["43:52:1"]],["miyim",["43:52:1"]]]},{"ayah_ref":"43:53","baseline_text":"Onun üzerine altın bilezikler atılmalı veya melekler onunla birlikte gelmeli değil miydi?","target_tokens":[["Onun",["43:53:3"]],["üzerine",["43:53:3"]],["altın",["43:53:5","43:53:6"]],["bilezikler",["43:53:4"]],["atılmalı",["43:53:2"]],["veya",["43:53:7"]],["melekler",["43:53:10"]],["onunla",["43:53:9"]],["birlikte",["43:53:11"]],["gelmeli",["43:53:8"]],["değil",["43:53:1"]],["miydi",["43:53:1"]]]},{"ayah_ref":"43:54","baseline_text":"Böylece halkını küçümsedi, onlar da ona boyun eğdiler. Çünkü onlar yoldan çıkmış bir topluluktu.","target_tokens":[["Böylece",["43:54:1"]],["halkını",["43:54:2"]],["küçümsedi",["43:54:1"]],["onlar",["43:54:3"]],["da",["43:54:3"]],["ona",["43:54:3"]],["boyun",["43:54:3"]],["eğdiler",["43:54:3"]],["Çünkü",["43:54:4"]],["onlar",["43:54:4"]],["yoldan",["43:54:7"]],["çıkmış",["43:54:7"]],["bir",["43:54:6"]],["topluluktu",["43:54:5","43:54:6"]]]},{"ayah_ref":"43:55","baseline_text":"Bizi öfkelendirince onlardan öç aldık ve hepsini boğduk.","target_tokens":[["Bizi",["43:55:2"]],["öfkelendirince",["43:55:1","43:55:2"]],["onlardan",["43:55:4"]],["öç",["43:55:3"]],["aldık",["43:55:3"]],["ve",["43:55:5"]],["hepsini",["43:55:6"]],["boğduk",["43:55:5"]]]},{"ayah_ref":"43:56","baseline_text":"Böylece onları sonrakiler için öncül ve örnek yaptık.","target_tokens":[["Böylece",["43:56:1"]],["onları",["43:56:1"]],["sonrakiler",["43:56:4"]],["için",["43:56:4"]],["öncül",["43:56:2"]],["ve",["43:56:3"]],["örnek",["43:56:3"]],["yaptık",["43:56:1"]]]},{"ayah_ref":"43:57","baseline_text":"Meryem oğlu örnek verilince senin halkın bundan tepki gösterdi.","target_tokens":[["Meryem",["43:57:4"]],["oğlu",["43:57:3"]],["örnek",["43:57:5"]],["verilince",["43:57:1","43:57:2"]],["senin",["43:57:7"]],["halkın",["43:57:7"]],["bundan",["43:57:8"]],["tepki",["43:57:9"]],["gösterdi",["43:57:6","43:57:9"]]]},{"ayah_ref":"43:58","baseline_text":"'Bizim ilahlarımız mı daha iyi, yoksa o mu?' dediler. Bu örneği sana yalnızca tartışmak için verdiler. Hayır, onlar kavgacı bir topluluktur.","target_tokens":[["Bizim",["43:58:2"]],["ilahlarımız",["43:58:2"]],["mı",["43:58:2"]],["daha",["43:58:3"]],["iyi",["43:58:3"]],["yoksa",["43:58:4"]],["o",["43:58:5"]],["mu",["43:58:5"]],["dediler",["43:58:1"]],["Bu",["43:58:7"]],["örneği",["43:58:7"]],["sana",["43:58:8"]],["yalnızca",["43:58:6","43:58:9"]],["tartışmak",["43:58:10"]],["için",["43:58:10"]],["verdiler",["43:58:7"]],["Hayır",["43:58:11"]],["onlar",["43:58:12"]],["kavgacı",["43:58:14"]],["bir",["43:58:13"]],["topluluktur",["43:58:13"]]]},{"ayah_ref":"43:59","baseline_text":"O, ancak kendisine nimet verdiğimiz ve İsrailoğullarına örnek kıldığımız bir kuldur.","target_tokens":[["O",["43:59:2"]],["ancak",["43:59:1","43:59:3"]],["kendisine",["43:59:6"]],["nimet",["43:59:5"]],["verdiğimiz",["43:59:5"]],["ve",["43:59:7"]],["İsrailoğullarına",["43:59:9","43:59:10"]],["örnek",["43:59:8"]],["kıldığımız",["43:59:7"]],["bir",["43:59:4"]],["kuldur",["43:59:4"]]]},{"ayah_ref":"43:60","baseline_text":"Dileseydik sizin yerinize yeryüzünde birbirinin ardından gelen melekler yapardık.","target_tokens":[["Dileseydik",["43:60:1","43:60:2"]],["sizin",["43:60:4"]],["yerinize",["43:60:4"]],["yeryüzünde",["43:60:6","43:60:7"]],["birbirinin",["43:60:8"]],["ardından",["43:60:8"]],["gelen",["43:60:8"]],["melekler",["43:60:5"]],["yapardık",["43:60:3"]]]},{"ayah_ref":"43:61","baseline_text":"Şüphesiz o, kıyamet saatinin bilgisidir. Sakın ondan kuşku duymayın ve bana uyun. Dosdoğru yol budur.","target_tokens":[["Şüphesiz",["43:61:1"]],["o",["43:61:1"]],["kıyamet",["43:61:3"]],["saatinin",["43:61:3"]],["bilgisidir",["43:61:2"]],["Sakın",["43:61:4"]],["ondan",["43:61:6"]],["kuşku",["43:61:5"]],["duymayın",["43:61:5"]],["ve",["43:61:7"]],["bana",["43:61:7"]],["uyun",["43:61:7"]],["Dosdoğru",["43:61:10"]],["yol",["43:61:9"]],["budur",["43:61:8"]]]},{"ayah_ref":"43:62","baseline_text":"Şeytan sizi bu yoldan alıkoymasın. Şüphesiz o sizin apaçık düşmanınızdır.","target_tokens":[["Şeytan",["43:62:3"]],["sizi",["43:62:2"]],["bu",["43:62:2"]],["yoldan",["43:62:2"]],["alıkoymasın",["43:62:1","43:62:2"]],["Şüphesiz",["43:62:4"]],["o",["43:62:4"]],["sizin",["43:62:5"]],["apaçık",["43:62:7"]],["düşmanınızdır",["43:62:6"]]]},{"ayah_ref":"43:63","baseline_text":"İsa açık kanıtlarla gelince dedi ki: 'Size hikmetle geldim ve ayrılığa düştüğünüz şeylerin bir kısmını size açıklamak için geldim. Allah'a karşı gelmekten sakının ve bana itaat edin.'","target_tokens":[["İsa",["43:63:3"]],["açık",["43:63:4"]],["kanıtlarla",["43:63:4"]],["gelince",["43:63:1","43:63:2"]],["dedi",["43:63:5"]],["ki",["43:63:5"]],["Size",["43:63:7"]],["hikmetle",["43:63:8"]],["geldim",["43:63:6","43:63:7"]],["ve",["43:63:9"]],["ayrılığa",["43:63:13"]],["düştüğünüz",["43:63:13"]],["şeylerin",["43:63:12","43:63:14"]],["bir",["43:63:11"]],["kısmını",["43:63:11"]],["size",["43:63:10"]],["açıklamak",["43:63:9"]],["için",["43:63:9"]],["geldim",["43:63:7"]],["Allah'a",["43:63:16"]],["karşı",["43:63:15","43:63:16"]],["gelmekten",["43:63:15"]],["sakının",["43:63:15"]],["ve",["43:63:17"]],["bana",["43:63:17"]],["itaat",["43:63:17"]],["edin",["43:63:17"]]]},{"ayah_ref":"43:64","baseline_text":"Şüphesiz Allah benim de Rabbim, sizin de Rabbinizdir; öyleyse O'na kulluk edin. Dosdoğru yol budur.","target_tokens":[["Şüphesiz",["43:64:1"]],["Allah",["43:64:2"]],["benim",["43:64:4"]],["de",["43:64:3"]],["Rabbim",["43:64:4"]],["sizin",["43:64:5"]],["de",["43:64:5"]],["Rabbinizdir",["43:64:5"]],["öyleyse",["43:64:6"]],["O'na",["43:64:6"]],["kulluk",["43:64:6"]],["edin",["43:64:6"]],["Dosdoğru",["43:64:9"]],["yol",["43:64:8"]],["budur",["43:64:7"]]]},{"ayah_ref":"43:65","baseline_text":"Fakat aralarındaki gruplar anlaşmazlığa düştü. Acı bir günün azabı yüzünden zulmedenlerin vay hâline!","target_tokens":[["Fakat",["43:65:1"]],["aralarındaki",["43:65:3","43:65:4"]],["gruplar",["43:65:2"]],["anlaşmazlığa",["43:65:1"]],["düştü",["43:65:1"]],["Acı",["43:65:11"]],["bir",["43:65:10"]],["günün",["43:65:10"]],["azabı",["43:65:9"]],["yüzünden",["43:65:8"]],["zulmedenlerin",["43:65:6","43:65:7"]],["vay",["43:65:5"]],["hâline",["43:65:5"]]]},{"ayah_ref":"43:66","baseline_text":"Onlar farkında değillerken ansızın başlarına gelecek olan kıyamet saatinden başka neyi bekliyorlar?","target_tokens":[["Onlar",["43:66:2"]],["farkında",["43:66:10"]],["değillerken",["43:66:8","43:66:9","43:66:10"]],["ansızın",["43:66:7"]],["başlarına",["43:66:6"]],["gelecek",["43:66:5"]],["olan",["43:66:5"]],["kıyamet",["43:66:4"]],["saatinden",["43:66:4"]],["başka",["43:66:3"]],["neyi",["43:66:1"]],["bekliyorlar",["43:66:2"]]]},{"ayah_ref":"43:67","baseline_text":"O gün Allah'a karşı gelmekten sakınanlar dışında yakın dostlar birbirine düşman olacaktır.","target_tokens":[["O",["43:67:2"]],["gün",["43:67:2"]],["Allah'a",["43:67:7"]],["karşı",["43:67:7"]],["gelmekten",["43:67:7"]],["sakınanlar",["43:67:7"]],["dışında",["43:67:6"]],["yakın",["43:67:1"]],["dostlar",["43:67:1"]],["birbirine",["43:67:3","43:67:4"]],["düşman",["43:67:5"]],["olacaktır",["43:67:5"]]]},{"ayah_ref":"43:68","baseline_text":"Ey kullarım! Bugün size korku yoktur ve siz üzülmeyeceksiniz.","target_tokens":[["Ey",["43:68:1"]],["kullarım",["43:68:1"]],["Bugün",["43:68:5"]],["size",["43:68:4"]],["korku",["43:68:3"]],["yoktur",["43:68:2"]],["ve",["43:68:6"]],["siz",["43:68:7"]],["üzülmeyeceksiniz",["43:68:8"]]]},{"ayah_ref":"43:69","baseline_text":"Onlar ayetlerimize inanmış ve teslim olmuş kimselerdir.","target_tokens":[["Onlar",["43:69:1"]],["ayetlerimize",["43:69:3"]],["inanmış",["43:69:2"]],["ve",["43:69:4"]],["teslim",["43:69:5"]],["olmuş",["43:69:4","43:69:5"]],["kimselerdir",["43:69:1"]]]},{"ayah_ref":"43:70","baseline_text":"Siz ve eşleriniz sevinç içinde cennete girin.","target_tokens":[["Siz",["43:70:3"]],["ve",["43:70:4"]],["eşleriniz",["43:70:4"]],["sevinç",["43:70:5"]],["içinde",["43:70:5"]],["cennete",["43:70:2"]],["girin",["43:70:1"]]]},{"ayah_ref":"43:71","baseline_text":"Çevrelerinde altın tabaklar ve kadehler dolaştırılır. Orada canların istediği ve gözlerin zevk aldığı her şey vardır. Siz orada kalıcı olacaksınız.","target_tokens":[["Çevrelerinde",["43:71:2"]],["altın",["43:71:4","43:71:5"]],["tabaklar",["43:71:3"]],["ve",["43:71:6"]],["kadehler",["43:71:6"]],["dolaştırılır",["43:71:1"]],["Orada",["43:71:7"]],["canların",["43:71:10"]],["istediği",["43:71:9"]],["ve",["43:71:11"]],["gözlerin",["43:71:12"]],["zevk",["43:71:11"]],["aldığı",["43:71:11"]],["her",["43:71:8"]],["şey",["43:71:8"]],["vardır",["43:71:7","43:71:8"]],["Siz",["43:71:13"]],["orada",["43:71:14"]],["kalıcı",["43:71:15"]],["olacaksınız",["43:71:15"]]]},{"ayah_ref":"43:72","baseline_text":"İşte yaptıklarınız sayesinde size miras verilen cennet budur.","target_tokens":[["İşte",["43:72:1"]],["yaptıklarınız",["43:72:7"]],["sayesinde",["43:72:5","43:72:6","43:72:7"]],["size",["43:72:4"]],["miras",["43:72:4"]],["verilen",["43:72:3","43:72:4"]],["cennet",["43:72:2"]],["budur",["43:72:1"]]]},{"ayah_ref":"43:73","baseline_text":"Orada sizin için çok meyve vardır; onlardan yiyeceksiniz.","target_tokens":[["Orada",["43:73:2"]],["sizin",["43:73:1"]],["için",["43:73:1"]],["çok",["43:73:4"]],["meyve",["43:73:3"]],["vardır",["43:73:3"]],["onlardan",["43:73:5"]],["yiyeceksiniz",["43:73:6"]]]},{"ayah_ref":"43:74","baseline_text":"Şüphesiz suçlular cehennem azabında kalıcıdır.","target_tokens":[["Şüphesiz",["43:74:1"]],["suçlular",["43:74:2"]],["cehennem",["43:74:5"]],["azabında",["43:74:3","43:74:4"]],["kalıcıdır",["43:74:6"]]]},{"ayah_ref":"43:75","baseline_text":"Azapları hafifletilmeyecek ve orada umutsuz kalacaklar.","target_tokens":[["Azapları",["43:75:3"]],["hafifletilmeyecek",["43:75:1","43:75:2"]],["ve",["43:75:4"]],["orada",["43:75:5"]],["umutsuz",["43:75:6"]],["kalacaklar",["43:75:4","43:75:6"]]]},{"ayah_ref":"43:76","baseline_text":"Biz onlara zulmetmedik; fakat asıl zalim olanlar kendileriydi.","target_tokens":[["Biz",["43:76:2"]],["onlara",["43:76:2"]],["zulmetmedik",["43:76:1","43:76:2"]],["fakat",["43:76:3"]],["asıl",["43:76:5"]],["zalim",["43:76:6"]],["olanlar",["43:76:4","43:76:6"]],["kendileriydi",["43:76:5"]]]},{"ayah_ref":"43:77","baseline_text":"'Ey Mâlik! Rabbin canımızı alsın' diye seslenirler. O da, 'Siz burada kalacaksınız' der.","target_tokens":[["Ey",["43:77:2"]],["Mâlik",["43:77:2"]],["Rabbin",["43:77:5"]],["canımızı",["43:77:4"]],["alsın",["43:77:3"]],["diye",["43:77:1"]],["seslenirler",["43:77:1"]],["O",["43:77:6"]],["da",["43:77:6"]],["Siz",["43:77:7"]],["burada",["43:77:8"]],["kalacaksınız",["43:77:8"]],["der",["43:77:6"]]]},{"ayah_ref":"43:78","baseline_text":"Andolsun, size gerçeği getirdik; fakat çoğunuz gerçeğe karşı isteksizsiniz.","target_tokens":[["Andolsun",["43:78:1"]],["size",["43:78:2"]],["gerçeği",["43:78:3"]],["getirdik",["43:78:2"]],["fakat",["43:78:4"]],["çoğunuz",["43:78:5"]],["gerçeğe",["43:78:6"]],["karşı",["43:78:6"]],["isteksizsiniz",["43:78:7"]]]},{"ayah_ref":"43:79","baseline_text":"Yoksa bir işi kesinleştirdiler mi? O hâlde biz de kesinleştiriyoruz.","target_tokens":[["Yoksa",["43:79:1"]],["bir",["43:79:3"]],["işi",["43:79:3"]],["kesinleştirdiler",["43:79:2"]],["mi",["43:79:1"]],["O",["43:79:4"]],["hâlde",["43:79:4"]],["biz",["43:79:4"]],["de",["43:79:4"]],["kesinleştiriyoruz",["43:79:5"]]]},{"ayah_ref":"43:80","baseline_text":"Yoksa sırlarını ve gizli konuşmalarını işitmediğimizi mi sanıyorlar? Hayır; elçilerimiz yanlarında yazıyorlar.","target_tokens":[["Yoksa",["43:80:1"]],["sırlarını",["43:80:6"]],["ve",["43:80:7"]],["gizli",["43:80:7"]],["konuşmalarını",["43:80:7"]],["işitmediğimizi",["43:80:3","43:80:4","43:80:5"]],["mi",["43:80:1"]],["sanıyorlar",["43:80:2"]],["Hayır",["43:80:8"]],["elçilerimiz",["43:80:9"]],["yanlarında",["43:80:10"]],["yazıyorlar",["43:80:11"]]]},{"ayah_ref":"43:81","baseline_text":"De ki: 'Eğer Rahman'ın bir çocuğu olsaydı, ona kulluk edenlerin ilki ben olurdum.'","target_tokens":[["De",["43:81:1"]],["ki",["43:81:1"]],["Eğer",["43:81:2"]],["Rahman'ın",["43:81:4"]],["bir",["43:81:5"]],["çocuğu",["43:81:5"]],["olsaydı",["43:81:3"]],["ona",["43:81:8"]],["kulluk",["43:81:8"]],["edenlerin",["43:81:8"]],["ilki",["43:81:7"]],["ben",["43:81:6"]],["olurdum",["43:81:6"]]]},{"ayah_ref":"43:82","baseline_text":"Göklerin ve yerin Rabbi, Arş'ın Rabbi, onların yakıştırdıklarından uzaktır.","target_tokens":[["Göklerin",["43:82:3"]],["ve",["43:82:4"]],["yerin",["43:82:4"]],["Rabbi",["43:82:2"]],["Arş'ın",["43:82:6"]],["Rabbi",["43:82:5"]],["onların",["43:82:8"]],["yakıştırdıklarından",["43:82:7","43:82:8"]],["uzaktır",["43:82:1"]]]},{"ayah_ref":"43:83","baseline_text":"Bırak onları, kendilerine vadolunan günleriyle karşılaşıncaya kadar boş sözlere dalsınlar ve oynasınlar.","target_tokens":[["Bırak",["43:83:1"]],["onları",["43:83:1"]],["kendilerine",["43:83:8"]],["vadolunan",["43:83:7","43:83:8"]],["günleriyle",["43:83:6"]],["karşılaşıncaya",["43:83:4","43:83:5"]],["kadar",["43:83:4"]],["boş",["43:83:2"]],["sözlere",["43:83:2"]],["dalsınlar",["43:83:2"]],["ve",["43:83:3"]],["oynasınlar",["43:83:3"]]]},{"ayah_ref":"43:84","baseline_text":"Gökte ilah olan da yerde ilah olan da O'dur. O, hikmet sahibidir, her şeyi bilendir.","target_tokens":[["Gökte",["43:84:3","43:84:4"]],["ilah",["43:84:5"]],["olan",["43:84:2"]],["da",["43:84:1"]],["yerde",["43:84:6","43:84:7"]],["ilah",["43:84:8"]],["olan",["43:84:2"]],["da",["43:84:1"]],["O'dur",["43:84:1"]],["O",["43:84:9"]],["hikmet",["43:84:10"]],["sahibidir",["43:84:10"]],["her",["43:84:11"]],["şeyi",["43:84:11"]],["bilendir",["43:84:11"]]]},{"ayah_ref":"43:85","baseline_text":"Göklerin, yerin ve ikisinin arasındakilerin hükümranlığı kendisine ait olan ne yücedir! Kıyamet saatinin bilgisi O'nun katındadır ve yalnız O'na döndürüleceksiniz.","target_tokens":[["Göklerin",["43:85:5"]],["yerin",["43:85:6"]],["ve",["43:85:7"]],["ikisinin",["43:85:8"]],["arasındakilerin",["43:85:7","43:85:8"]],["hükümranlığı",["43:85:4"]],["kendisine",["43:85:3"]],["ait",["43:85:3"]],["olan",["43:85:2"]],["ne",["43:85:1"]],["yücedir",["43:85:1"]],["Kıyamet",["43:85:11"]],["saatinin",["43:85:11"]],["bilgisi",["43:85:10"]],["O'nun",["43:85:9"]],["katındadır",["43:85:9"]],["ve",["43:85:12"]],["yalnız",["43:85:12"]],["O'na",["43:85:12"]],["döndürüleceksiniz",["43:85:13"]]]},{"ayah_ref":"43:86","baseline_text":"O'ndan başka yalvardıkları kimseler şefaate sahip değildir. Ancak bilerek gerçeğe tanıklık edenler bunun dışındadır.","target_tokens":[["O'ndan",["43:86:5","43:86:6"]],["başka",["43:86:5","43:86:6"]],["yalvardıkları",["43:86:4"]],["kimseler",["43:86:3"]],["şefaate",["43:86:7"]],["sahip",["43:86:2","43:86:7"]],["değildir",["43:86:1"]],["Ancak",["43:86:8"]],["bilerek",["43:86:12","43:86:13"]],["gerçeğe",["43:86:11"]],["tanıklık",["43:86:10"]],["edenler",["43:86:9"]],["bunun",["43:86:8"]],["dışındadır",["43:86:8"]]]},{"ayah_ref":"43:87","baseline_text":"Onlara kendilerini kimin yarattığını sorsan mutlaka 'Allah' derler. Öyleyse nasıl döndürülüyorlar?","target_tokens":[["Onlara",["43:87:2"]],["kendilerini",["43:87:4"]],["kimin",["43:87:3"]],["yarattığını",["43:87:4"]],["sorsan",["43:87:1","43:87:2"]],["mutlaka",["43:87:1","43:87:5"]],["Allah",["43:87:6"]],["derler",["43:87:5"]],["Öyleyse",["43:87:7"]],["nasıl",["43:87:7"]],["döndürülüyorlar",["43:87:8"]]]},{"ayah_ref":"43:88","baseline_text":"Bir de onun şu sözü: 'Rabbim! Bunlar inanmayan bir topluluktur.'","target_tokens":[["Bir",["43:88:1"]],["de",["43:88:1"]],["onun",["43:88:1"]],["şu",["43:88:1"]],["sözü",["43:88:1"]],["Rabbim",["43:88:2"]],["Bunlar",["43:88:3","43:88:4"]],["inanmayan",["43:88:6","43:88:7"]],["bir",["43:88:5"]],["topluluktur",["43:88:5"]]]},{"ayah_ref":"43:89","baseline_text":"Onlardan yüz çevir ve 'Selam' de. Yakında bilecekler.","target_tokens":[["Onlardan",["43:89:2"]],["yüz",["43:89:1"]],["çevir",["43:89:1"]],["ve",["43:89:3"]],["Selam",["43:89:4"]],["de",["43:89:3"]],["Yakında",["43:89:5"]],["bilecekler",["43:89:6"]]]}]}

recek",["43:27:5"]]]},{"ayah_ref":"43:28","baseline_text":"Bunu, ardından gelenler dönsünler diye soyunda kalıcı bir söz yaptı.","target_tokens":[["Bunu",["43:28:1"]],["ardından",["43:28:5"]],["gelenler",["43:28:5"]],["dönsünler",["43:28:7"]],["diye",["43:28:6"]],["soyunda",["43:28:4","43:28:5"]],["kalıcı",["43:28:3"]],["bir",["43:28:2"]],["söz",["43:28:2"]],["yaptı",["43:28:1"]]]},{"ayah_ref":"43:29","baseline_text":"Dahası, gerçek ve apaçık bir elçi kendilerine gelinceye kadar bunları ve atalarını yararlandırdım.","target_tokens":[["Dahası",["43:29:1"]],["gerçek",["43:29:7"]],["ve",["43:29:8"]],["apaçık",["43:29:9"]],["bir",["43:29:8"]],["elçi",["43:29:8"]],["kendilerine",["43:29:6"]],["gelinceye",["43:29:5","43:29:6"]],["kadar",["43:29:5"]],["bunları",["43:29:3"]],["ve",["43:29:4"]],["atalarını",["43:29:4"]],["yararlandırdım",["43:29:2"]]]},{"ayah_ref":"43:30","baseline_text":"Fakat gerçek onlara gelince, 'Bu bir büyüdür ve biz onu inkâr ediyoruz' dediler.","target_tokens":[["Fakat",["43:30:1"]],["gerçek",["43:30:3"]],["onlara",["43:30:2"]],["gelince",["43:30:1","43:30:2"]],["Bu",["43:30:5"]],["bir",["43:30:6"]],["büyüdür",["43:30:6"]],["ve",["43:30:7"]],["biz",["43:30:7"]],["onu",["43:30:8"]],["inkâr",["43:30:9"]],["ediyoruz",["43:30:9"]],["dediler",["43:30:4"]]]},{"ayah_ref":"43:31","baseline_text":"Bir de, 'Bu Kur'an iki şehirden büyük bir adama indirilmeli değil miydi?' dediler.","target_tokens":[["Bir",["43:31:1"]],["de",["43:31:1"]],["Bu",["43:31:4"]],["Kur'an",["43:31:5"]],["iki",["43:31:9"]],["şehirden",["43:31:8","43:31:9"]],["büyük",["43:31:10"]],["bir",["43:31:7"]],["adama",["43:31:6","43:31:7"]],["indirilmeli",["43:31:3"]],["değil",["43:31:2"]],["miydi",["43:31:2"]],["dediler",["43:31:1"]]]},{"ayah_ref":"43:32","baseline_text":"Rabbinin rahmetini onlar mı bölüştürüyor? Dünya hayatındaki geçimlerini aralarında biz bölüştürdük. Birbirlerini hizmetlerinde kullansınlar diye kimini kiminden derecelerle üstün kıldık. Rabbinin rahmeti onların biriktirdikleri
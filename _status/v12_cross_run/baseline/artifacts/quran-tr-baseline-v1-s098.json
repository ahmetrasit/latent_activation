{"language":"tr","ayat":[{"ayah_ref":"98:1","baseline_text":"Kitap ehlinden inkâr edenler ve Allah'a ortak koşanlar, kendilerine açık kanıt gelinceye kadar ayrılacak değillerdi.","target_tokens":[["Kitap",["98:1:7"]],["ehlinden",["98:1:5","98:1:6","98:1:7"]],["inkâr",["98:1:4"]],["edenler",["98:1:3","98:1:4"]],["ve",["98:1:8"]],["Allah'a",["98:1:8"]],["ortak",["98:1:8"]],["koşanlar",["98:1:8"]],["kendilerine",["98:1:11"]],["açık",["98:1:12"]],["kanıt",["98:1:12"]],["gelinceye",["98:1:11"]],["kadar",["98:1:10"]],["ayrılacak",["98:1:9"]],["değillerdi",["98:1:1","98:1:2","98:1:9"]]]},{"ayah_ref":"98:2","baseline_text":"Allah'tan bir elçi, arındırılmış sayfalar okur.","target_tokens":[["Allah'tan",["98:2:2","98:2:3"]],["bir",["98:2:1"]],["elçi",["98:2:1"]],["arındırılmış",["98:2:6"]],["sayfalar",["98:2:5"]],["okur",["98:2:4"]]]},{"ayah_ref":"98:3","baseline_text":"Onlarda dosdoğru yazılar vardır.","target_tokens":[["Onlarda",["98:3:1"]],["dosdoğru",["98:3:3"]],["yazılar",["98:3:2"]],["vardır",["98:3:1","98:3:2","98:3:3"]]]},{"ayah_ref":"98:4","baseline_text":"Kitap verilenler ancak kendilerine açık kanıt geldikten sonra ayrılığa düştüler.","target_tokens":[["Kitap",["98:4:5"]],["verilenler",["98:4:3","98:4:4","98:4:5"]],["ancak",["98:4:1","98:4:6"]],["kendilerine",["98:4:10"]],["açık",["98:4:11"]],["kanıt",["98:4:11"]],["geldikten",["98:4:9","98:4:10"]],["sonra",["98:4:7","98:4:8"]],["ayrılığa",["98:4:2"]],["düştüler",["98:4:2"]]]},{"ayah_ref":"98:5","baseline_text":"Onlara yalnızca, dini O'na özgü kılıp doğruya yönelerek Allah'a kulluk etmeleri, namazı kılmaları ve zekâtı vermeleri emredildi. İşte doğru din budur.","target_tokens":[["Onlara",["98:5:2"]],["yalnızca",["98:5:1","98:5:3"]],["dini",["98:5:8"]],["O'na",["98:5:7"]],["özgü",["98:5:6","98:5:7","98:5:8"]],["kılıp",["98:5:6"]],["doğruya",["98:5:9"]],["yönelerek",["98:5:9"]],["Allah'a",["98:5:5"]],["kulluk",["98:5:4"]],["etmeleri",["98:5:2","98:5:4"]],["namazı",["98:5:11"]],["kılmaları",["98:5:10","98:5:11"]],["ve",["98:5:12"]],["zekâtı",["98:5:13"]],["vermeleri",["98:5:12","98:5:13"]],["emredildi",["98:5:2"]],["İşte",["98:5:14"]],["doğru",["98:5:16"]],["din",["98:5:15"]],["budur",["98:5:14","98:5:15","98:5:16"]]]},{"ayah_ref":"98:6","baseline_text":"Kuşkusuz Kitap ehlinden inkâr edenler ve Allah'a ortak koşanlar cehennem ateşindedirler; orada sürekli kalacaklardır. İşte onlar yaratılmışların en kötüleridir.","target_tokens":[["Kuşkusuz",["98:6:1"]],["Kitap",["98:6:6"]],["ehlinden",["98:6:4","98:6:5","98:6:6"]],["inkâr",["98:6:3"]],["edenler",["98:6:2","98:6:3"]],["ve",["98:6:7"]],["Allah'a",["98:6:7"]],["ortak",["98:6:7"]],["koşanlar",["98:6:7"]],["cehennem",["98:6:10"]],["ateşindedirler",["98:6:8","98:6:9"]],["orada",["98:6:12"]],["sürekli",["98:6:11"]],["kalacaklardır",["98:6:11","98:6:12"]],["İşte",["98:6:13"]],["onlar",["98:6:14"]],["yaratılmışların",["98:6:16"]],["en",["98:6:15"]],["kötüleridir",["98:6:13","98:6:14","98:6:15","98:6:16"]]]},{"ayah_ref":"98:7","baseline_text":"Kuşkusuz inanan ve iyi işler yapanlar, işte onlar yaratılmışların en iyileridir.","target_tokens":[["Kuşkusuz",["98:7:1"]],["inanan",["98:7:2","98:7:3"]],["ve",["98:7:4"]],["iyi",["98:7:5"]],["işler",["98:7:5"]],["yapanlar",["98:7:4","98:7:5"]],["işte",["98:7:6"]],["onlar",["98:7:7"]],["yaratılmışların",["98:7:9"]],["en",["98:7:8"]],["iyileridir",["98:7:6","98:7:7","98:7:8","98:7:9"]]]},{"ayah_ref":"98:8","baseline_text":"Rableri katındaki karşılıkları, altlarından ırmaklar akan Adn bahçeleridir; orada sonsuza dek kalacaklardır. Allah onlardan hoşnut olmuştur, onlar da O'ndan hoşnut olmuşlardır. Bu, Rabbinden korkan kimse içindir.","target_tokens":[["Rableri",["98:8:3"]],["katındaki",["98:8:2","98:8:3"]],["karşılıkları",["98:8:1"]],["altlarından",["98:8:7","98:8:8"]],["ırmaklar",["98:8:9"]],["akan",["98:8:6"]],["Adn",["98:8:5"]],["bahçeleridir",["98:8:4"]],["orada",["98:8:11"]],["sonsuza",["98:8:12"]],["dek",["98:8:12"]],["kalacaklardır",["98:8:10","98:8:11"]],["Allah",["98:8:14"]],["onlardan",["98:8:15"]],["hoşnut",["98:8:13"]],["olmuştur",["98:8:13"]],["onlar",["98:8:16"]],["da",["98:8:16"]],["O'ndan",["98:8:17"]],["hoşnut",["98:8:16"]],["olmuşlardır",["98:8:16"]],["Bu",["98:8:18"]],["Rabbinden",["98:8:21"]],["korkan",["98:8:20"]],["kimse",["98:8:19"]],["içindir",["98:8:18","98:8:19"]]]}]}

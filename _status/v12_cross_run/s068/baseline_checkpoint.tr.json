  "language": "tr",
  "ayat": [
    {"ayah_ref":"68:1","baseline_text":"Nûn. Kaleme ve yazdıklarına ant olsun.","target_tokens":[["Nûn",["68:1:1"]],["Kaleme",["68:1:2"]],["ve",["68:1:3"]],["yazdıklarına",["68:1:3","68:1:4"]],["ant",["68:1:2"]],["olsun",["68:1:2"]]]},
    {"ayah_ref":"68:2","baseline_text":"Sen Rabbinin nimeti sayesinde deli değilsin.","target_tokens":[["Sen",["68:2:2"]],["Rabbinin",["68:2:4"]],["nimeti",["68:2:3"]],["sayesinde",["68:2:3","68:2:4"]],["deli",["68:2:5"]],["değilsin",["68:2:1","68:2:2","68:2:5"]]]},
    {"ayah_ref":"68:3","baseline_text":"Ve şüphesiz senin için tükenmeyen bir ödül vardır.","target_tokens":[["Ve",["68:3:1"]],["şüphesiz",["68:3:1"]],["senin",["68:3:2"]],["için",["68:3:2"]],["tükenmeyen",["68:3:4","68:3:5"]],["bir",["68:3:3"]],["ödül",["68:3:3"]],["vardır",["68:3:1","68:3:2","68:3:3"]]]},
    {"ayah_ref":"68:4","baseline_text":"Ve sen gerçekten yüce bir ahlaka sahipsin.","target_tokens":[["Ve",["68:4:1"]],["sen",["68:4:1"]],["gerçekten",["68:4:1","68:4:2"]],["yüce",["68:4:4"]],["bir",["68:4:3"]],["ahlaka",["68:4:3"]],["sahipsin",["68:4:1","68:4:2","68:4:3"]]]},
    {"ayah_ref":"68:5","baseline_text":"Yakında sen göreceksin, onlar da görecekler.","target_tokens":[["Yakında",["68:5:1"]],["sen",["68:5:1"]],["göreceksin",["68:5:1"]],["onlar",["68:5:2"]],["da",["68:5:2"]],["görecekler",["68:5:2"]]]},
    {"ayah_ref":"68:6","baseline_text":"Hanginizin deli olduğunu.","target_tokens":[["Hanginizin",["68:6:1"]],["deli",["68:6:2"]],["olduğunu",["68:6:1","68:6:2"]]]},
    {"ayah_ref":"68:7","baseline_text":"Şüphesiz Rabbin, kendi yolundan kimin saptığını en iyi bilendir; doğru yolda olanları da en iyi bilen O'dur.","target_tokens":[["Şüphesiz",["68:7:1"]],["Rabbin",["68:7:2"]],["kendi",["68:7:8"]],["yolundan",["68:7:7","68:7:8"]],["kimin",["68:7:5"]],["saptığını",["68:7:6"]],["en",["68:7:4"]],["iyi",["68:7:4"]],["bilendir",["68:7:3","68:7:4"]],["doğru",["68:7:11"]],["yolda",["68:7:11"]],["olanları",["68:7:11"]],["da",["68:7:9"]],["en",["68:7:10"]],["iyi",["68:7:10"]],["bilen",["68:7:10"]],["O'dur",["68:7:9","68:7:10"]]]},
    {"ayah_ref":"68:8","baseline_text":"Öyleyse yalanlayanlara uyma.","target_tokens":[["Öyleyse",["68:8:1"]],["yalanlayanlara",["68:8:3"]],["uyma",["68:8:1","68:8:2"]]]},
    {"ayah_ref":"68:9","baseline_text":"Onlar senin ödün vermeni isterler; böylece kendileri de ödün verirler.","target_tokens":[["Onlar",["68:9:1"]],["senin",["68:9:3"]],["ödün",["68:9:3"]],["vermeni",["68:9:3"]],["isterler",["68:9:1","68:9:2"]],["böylece",["68:9:4"]],["kendileri",["68:9:4"]],["de",["68:9:4"]],["ödün",["68:9:4"]],["verirler",["68:9:4"]]]},
    {"ayah_ref":"68:10","baseline_text":"Sürekli yemin eden her aşağılık kişiye uyma.","target_tokens":[["Sürekli",["68:10:4"]],["yemin",["68:10:4"]],["eden",["68:10:4"]],["her",["68:10:3"]],["aşağılık",["68:10:5"]],["kişiye",["68:10:3","68:10:4","68:10:5"]],["uyma",["68:10:1","68:10:2"]]]},
    {"ayah_ref":"68:11","baseline_text":"Durmadan ayıplayan, laf taşıyıp dolaşan,","target_tokens":[["Durmadan",["68:11:1"]],["ayıplayan",["68:11:1"]],["laf",["68:11:3"]],["taşıyıp",["68:11:2","68:11:3"]],["dolaşan",["68:11:2"]]]},
    {"ayah_ref":"68:12","baseline_text":"İyiliğe engel olan, sınırı aşan, günaha düşkün,","target_tokens":[["İyiliğe",["68:12:2"]],["engel",["68:12:1"]],["olan",["68:12:1"]],["sınırı",["68:12:3"]],["aşan",["68:12:3"]],["günaha",["68:12:4"]],["düşkün",["68:12:4"]]]},
    {"ayah_ref":"68:13","baseline_text":"Kaba ve bütün bunların ardından bir de soysuz olana.","target_tokens":[["Kaba",["68:13:1"]],["ve",["68:13:2","68:13:3"]],["bütün",["68:13:3"]],["bunların",["68:13:3"]],["ardından",["68:13:2"]],["bir",["68:13:4"]],["de",["68:13:3"]],["soysuz",["68:13:4"]],["olana",["68:13:1","68:13:4"]]]},
    {"ayah_ref":"68:14","baseline_text":"Malı ve oğulları var diye.","target_tokens":[["Malı",["68:14:4"]],["ve",["68:14:5"]],["oğulları",["68:14:5"]],["var",["68:14:2","68:14:3"]],["diye",["68:14:1","68:14:2"]]]},
    {"ayah_ref":"68:15","baseline_text":"Ayetlerimiz ona okunduğunda, 'Öncekilerin masalları,' der.","target_tokens":[["Ayetlerimiz",["68:15:4"]],["ona",["68:15:3"]],["okunduğunda",["68:15:1","68:15:2"]],["Öncekilerin",["68:15:7"]],["masalları",["68:15:6","68:15:7"]],["der",["68:15:5"]]]},
    {"ayah_ref":"68:16","baseline_text":"Onu burnunun üzerine damgalayacağız.","target_tokens":[["Onu",["68:16:1"]],["burnunun",["68:16:3"]],["üzerine",["68:16:2","68:16:3"]],["damgalayacağız",["68:16:1"]]]},
    {"ayah_ref":"68:17","baseline_text":"Bahçe sahiplerini sınadığımız gibi onları da sınadık. Hani sabah erkenden bahçenin ürününü mutlaka devşireceklerine yemin etmişlerdi.","target_tokens":[["Bahçe",["68:17:6"]],["sahiplerini",["68:17:5"]],["sınadığımız",["68:17:4"]],["gibi",["68:17:3","68:17:4"]],["onları",["68:17:2"]],["da",["68:17:3"]],["sınadık",["68:17:1","68:17:2"]],["Hani",["68:17:7"]],["sabah",["68:17:10"]],["erkenden",["68:17:10"]],["bahçenin",["68:17:6","68:17:9"]],["ürününü",["68:17:9"]],["mutlaka",["68:17:9"]],["devşireceklerine",["68:17:9"]],["yemin",["68:17:8"]],["etmişlerdi",["68:17:8"]]]},
    {"ayah_ref":"68:18","baseline_text":"Ama hiçbir istisna koymamışlardı.","target_tokens":[["Ama",["68:18:1"]],["hiçbir",["68:18:1","68:18:2"]],["istisna",["68:18:2"]],["koymamışlardı",["68:18:2"]]]},
    {"ayah_ref":"68:19","baseline_text":"Onlar uyurken Rabbin tarafından gelen bir felaket bahçeyi sarıp geçti.","target_tokens":[["Onlar",["68:19:6"]],["uyurken",["68:19:6","68:19:7"]],["Rabbin",["68:19:5"]],["tarafından",["68:19:4","68:19:5"]],["gelen",["68:19:3","68:19:4"]],["bir",["68:19:3"]],["felaket",["68:19:3"]],["bahçeyi",["68:19:2"]],["sarıp",["68:19:1","68:19:2","68:19:3"]],["geçti",["68:19:1"]]]},
    {"ayah_ref":"68:20","baseline_text":"Böylece bahçe, biçilmiş bir yer gibi oldu.","target_tokens":[["Böylece",["68:20:1"]],["bahçe",["68:20:1"]],["biçilmiş",["68:20:2"]],["bir",["68:20:2"]],["yer",["68:20:2"]],["gibi",["68:20:2"]],["oldu",["68:20:1"]]]},
    {"ayah_ref":"68:21","baseline_text":"Sabah olunca birbirlerine seslendiler:","target_tokens":[["Sabah",["68:21:2"]],["olunca",["68:21:2"]],["birbirlerine",["68:21:1"]],["seslendiler",["68:21:1"]]]},
    {"ayah_ref":"68:22","baseline_text":"'Ürünü devşirecekseniz erkenden ekinliğinize gidin.'","target_tokens":[["Ürünü",["68:22:4","68:22:7"]],["devşirecekseniz",["68:22:1","68:22:5","68:22:6","68:22:7"]],["erkenden",["68:22:2"]],["ekinliğinize",["68:22:3","68:22:4"]],["gidin",["68:22:2"]]]},
    {"ayah_ref":"68:23","baseline_text":"Böylece yola koyuldular; birbirleriyle fısıldaşıyorlardı.","target_tokens":[["Böylece",["68:23:1"]],["yola",["68:23:1"]],["koyuldular",["68:23:1"]],["birbirleriyle",["68:23:2","68:23:3"]],["fısıldaşıyorlardı",["68:23:2","68:23:3"]]]},
    {"ayah_ref":"68:24","baseline_text":"'Bugün bahçeye, yanınıza hiçbir yoksul girmesin.'","target_tokens":[["Bugün",["68:24:4"]],["bahçeye",["68:24:3"]],["yanınıza",["68:24:5"]],["hiçbir",["68:24:2","68:24:6"]],["yoksul",["68:24:6"]],["girmesin",["68:24:1","68:24:2","68:24:3"]]]},
    {"ayah_ref":"68:25","baseline_text":"Erkenden, engellemeye kararlı ve buna güçleri yeter halde gittiler.","target_tokens":[["Erkenden",["68:25:1"]],["engellemeye",["68:25:3"]],["kararlı",["68:25:3"]],["ve",["68:25:3","68:25:4"]],["buna",["68:25:2","68:25:3"]],["güçleri",["68:25:4"]],["yeter",["68:25:4"]],["halde",["68:25:2","68:25:4"]],["gittiler",["68:25:1"]]]},
    {"ayah_ref":"68:26","baseline_text":"Bahçeyi görünce, 'Biz kesinlikle yolu şaşırdık,' dediler.","target_tokens":[["Bahçeyi",["68:26:2"]],["görünce",["68:26:1","68:26:2"]],["Biz",["68:26:4"]],["kesinlikle",["68:26:4","68:26:5"]],["yolu",["68:26:5"]],["şaşırdık",["68:26:5"]],["dediler",["68:26:3"]]]},
    {"ayah_ref":"68:27","baseline_text":"'Hayır, biz mahrum bırakılmışız.'","target_tokens":[["Hayır",["68:27:1"]],["biz",["68:27:2"]],["mahrum",["68:27:3"]],["bırakılmışız",["68:27:3"]]]},
    {"ayah_ref":"68:28","baseline_text":"İçlerinde en ölçülü olanı, 'Size, yüceltseniz ya demedim mi?' dedi.","target_tokens":[["İçlerinde",["68:28:2"]],["en",["68:28:2"]],["ölçülü",["68:28:2"]],["olanı",["68:28:2"]],["Size",["68:28:5"]],["yüceltseniz",["68:28:7"]],["ya",["68:28:6","68:28:7"]],["demedim",["68:28:3","68:28:4"]],["mi",["68:28:3"]],["dedi",["68:28:1"]]]},
    {"ayah_ref":"68:29","baseline_text":"'Rabbimiz eksiklikten uzaktır! Gerçekten biz haksızlık edenlerdik,' dediler.","target_tokens":[["Rabbimiz",["68:29:3"]],["eksiklikten",["68:29:2","68:29:3"]],["uzaktır",["68:29:2"]],["Gerçekten",["68:29:4"]],["biz",["68:29:4"]],["haksızlık",["68:29:6"]],["edenlerdik",["68:29:5","68:29:6"]],["dediler",["68:29:1"]]]},
    {"ayah_ref":"68:30","baseline_text":"Ardından birbirlerine dönüp birbirlerini kınamaya başladılar.","target_tokens":[["Ardından",["68:30:1"]],["birbirlerine",["68:30:2","68:30:3","68:30:4"]],["dönüp",["68:30:1","68:30:2","68:30:3"]],["birbirlerini",["68:30:2","68:30:4","68:30:5"]],["kınamaya",["68:30:5"]],["başladılar",["68:30:1","68:30:5"]]]},
    {"ayah_ref":"68:31","baseline_text":"'Yazıklar olsun bize! Gerçekten biz azgınlık edenlerdik,' dediler.","target_tokens":[["Yazıklar",["68:31:2"]],["olsun",["68:31:2"]],["bize",["68:31:2"]],["Gerçekten",["68:31:3"]],["biz",["68:31:3"]],["azgınlık",["68:31:5"]],["edenlerdik",["68:31:4","68:31:5"]],["dediler",["68:31:1"]]]},
    {"ayah_ref":"68:32","baseline_text":"'Belki Rabbimiz bize onun yerine daha iyisini verir. Gerçekten biz Rabbimize gönülden yöneliyoruz.'","target_tokens":[["Belki",["68:32:1"]],["Rabbimiz",["68:32:2"]],["bize",["68:32:4"]],["onun",["68:32:6"]],["yerine",["68:32:6"]],["daha",["68:32:5"]],["iyisini",["68:32:5"]],["verir",["68:32:3","68:32:4"]],["Gerçekten",["68:32:7"]],["biz",["68:32:7"]],["Rabbimize",["68:32:8","68:32:9"]],["gönülden",["68:32:10"]],["yöneliyoruz",["68:32:10"]]]},
    {"ayah_ref":"68:33","baseline_text":"Azap işte böyledir; ahiretin azabı ise elbette daha büyüktür. Eğer bilselerdi.","target_tokens":[["Azap",["68:33:2"]],["işte",["68:33:1"]],["böyledir",["68:33:1"]],["ahiretin",["68:33:4"]],["azabı",["68:33:3"]],["ise",["68:33:3"]],["elbette",["68:33:3"]],["daha",["68:33:5"]],["büyüktür",["68:33:5"]],["Eğer",["68:33:6"]],["bilselerdi",["68:33:7","68:33:8"]]]},
    {"ayah_ref":"68:34","baseline_text":"Allah'a karşı gelmekten sakınanlar için Rableri katında nimetlerle dolu bahçeler vardır.","target_tokens":[["Allah'a",["68:34:2"]],["karşı",["68:34:2"]],["gelmekten",["68:34:2"]],["sakınanlar",["68:34:2"]],["için",["68:34:2"]],["Rableri",["68:34:4"]],["katında",["68:34:3","68:34:4"]],["nimetlerle",["68:34:6"]],["dolu",["68:34:5","68:34:6"]],["bahçeler",["68:34:5"]],["vardır",["68:34:1","68:34:2","68:34:5"]]]},
    {"ayah_ref":"68:35","baseline_text":"Teslim olanlarla suç işleyenleri bir mi tutacağız?","target_tokens":[["Teslim",["68:35:2"]],["olanlarla",["68:35:2"]],["suç",["68:35:3"]],["işleyenleri",["68:35:3"]],["bir",["68:35:1","68:35:2","68:35:3"]],["mi",["68:35:1"]],["tutacağız",["68:35:1"]]]},
    {"ayah_ref":"68:36","baseline_text":"Size ne oluyor? Nasıl hüküm veriyorsunuz?","target_tokens":[["Size",["68:36:2"]],["ne",["68:36:1"]],["oluyor",["68:36:1","68:36:2"]],["Nasıl",["68:36:3"]],["hüküm",["68:36:4"]],["veriyorsunuz",["68:36:4"]]]},
    {"ayah_ref":"68:37","baseline_text":"Yoksa içinde okuyup öğrendiğiniz bir kitabınız mı var?","target_tokens":[["Yoksa",["68:37:1"]],["içinde",["68:37:4"]],["okuyup",["68:37:5"]],["öğrendiğiniz",["68:37:5"]],["bir",["68:37:3"]],["kitabınız",["68:37:2","68:37:3"]],["mı",["68:37:1"]],["var",["68:37:2"]]]},
    {"ayah_ref":"68:38","baseline_text":"Onda seçtiğiniz ne varsa kesinlikle sizindir.","target_tokens":[["Onda",["68:38:3"]],["seçtiğiniz",["68:38:5"]],["ne",["68:38:4","68:38:5"]],["varsa",["68:38:4"]],["kesinlikle",["68:38:1","68:38:4"]],["sizindir",["68:38:2","68:38:4"]]]},
    {"ayah_ref":"68:39","baseline_text":"Yoksa üzerimizde sizin için kıyamet gününe kadar geçerli yeminler mi var; hükmettiğiniz ne varsa kesinlikle sizin olacak diye?","target_tokens":[["Yoksa",["68:39:1"]],["üzerimizde",["68:39:4"]],["sizin",["68:39:2"]],["için",["68:39:2"]],["kıyamet",["68:39:8"]],["gününe",["68:39:7","68:39:8"]],["kadar",["68:39:6"]],["geçerli",["68:39:5","68:39:6"]],["yeminler",["68:39:3"]],["mi",["68:39:1"]],["var",["68:39:2","68:39:3"]],["hükmettiğiniz",["68:39:12"]],["ne",["68:39:11"]],["varsa",["68:39:11"]],["kesinlikle",["68:39:9","68:39:11"]],["sizin",["68:39:10"]],["olacak",["68:39:10","68:39:11","68:39:12"]],["diye",["68:39:9"]]]},
    {"ayah_ref":"68:40","baseline_text":"Onlara sor: İçlerinden hangisi buna kefildir?","target_tokens":[["Onlara",["68:40:1"]],["sor",["68:40:1"]],["İçlerinden",["68:40:2"]],["hangisi",["68:40:2"]],["buna",["68:40:3"]],["kefildir",["68:40:4"]]]},
    {"ayah_ref":"68:41","baseline_text":"Yoksa onların ortakları mı var? Doğru söylüyorlarsa ortaklarını getirsinler.","target_tokens":[["Yoksa",["68:41:1"]],["onların",["68:41:2"]],["ortakları",["68:41:3"]],["mı",["68:41:1"]],["var",["68:41:2","68:41:3"]],["Doğru",["68:41:8"]],["söylüyorlarsa",["68:41:6","68:41:7","68:41:8"]],["ortaklarını",["68:41:5"]],["getirsinler",["68:41:4"]]]},
    {"ayah_ref":"68:42","baseline_text":"Bir bacağın açılacağı, onların da secdeye çağrılacakları fakat güç yetiremeyecekleri gün.","target_tokens":[["Bir",["68:42:4"]],["bacağın",["68:42:3","68:42:4"]],["açılacağı",["68:42:2"]],["onların",["68:42:5"]],["da",["68:42:5"]],["secdeye",["68:42:6","68:42:7"]],["çağrılacakları",["68:42:5"]],["fakat",["68:42:8"]],["güç",["68:42:9"]],["yetiremeyecekleri",["68:42:8","68:42:9"]],["gün",["68:42:1"]]]},
    {"ayah_ref":"68:43","baseline_text":"Bakışları yere eğilmiş, onları aşağılanma kaplamış olacaktır. Oysa sapasağlamken secdeye çağrılıyorlardı.","target_tokens":[["Bakışları",["68:43:2"]],["yere",["68:43:1","68:43:2"]],["eğilmiş",["68:43:1"]],["onları",["68:43:3"]],["aşağılanma",["68:43:4"]],["kaplamış",["68:43:3"]],["olacaktır",["68:43:3","68:43:4"]],["Oysa",["68:43:5"]],["sapasağlamken",["68:43:6","68:43:10","68:43:11"]],["secdeye",["68:43:8","68:43:9"]],["çağrılıyorlardı",["68:43:7"]]]},
    {"ayah_ref":"68:44","baseline_text":"Bu sözü yalanlayanları bana bırak. Onları bilmedikleri bir yönden yavaş yavaş ilerleteceğiz.","target_tokens":[["Bu",["68:44:4"]],["sözü",["68:44:5"]],["yalanlayanları",["68:44:2","68:44:3"]],["bana",["68:44:1"]],["bırak",["68:44:1"]],["Onları",["68:44:6"]],["bilmedikleri",["68:44:9","68:44:10"]],["bir",["68:44:8"]],["yönden",["68:44:7","68:44:8"]],["yavaş",["68:44:6"]],["yavaş",["68:44:6"]],["ilerleteceğiz",["68:44:6"]]]},
    {"ayah_ref":"68:45","baseline_text":"Onlara süre tanıyorum. Şüphesiz benim planım sağlamdır.","target_tokens":[["Onlara",["68:45:2"]],["süre",["68:45:1"]],["tanıyorum",["68:45:1"]],["Şüphesiz",["68:45:3"]],["benim",["68:45:4"]],["planım",["68:45:4"]],["sağlamdır",["68:45:5"]]]},
    {"ayah_ref":"68:46","baseline_text":"Yoksa sen onlardan bir ücret istiyorsun da onlar ağır bir borcun yükü altında mı kalıyorlar?","target_tokens":[["Yoksa",["68:46:1"]],["sen",["68:46:2"]],["onlardan",["68:46:2"]],["bir",["68:46:3"]],["ücret",["68:46:3"]],["istiyorsun",["68:46:2"]],["da",["68:46:4"]],["onlar",["68:46:4"]],["ağır",["68:46:7"]],["bir",["68:46:6"]],["borcun",["68:46:5","68:46:6"]],["yükü",["68:46:7"]],["altında",["68:46:5","68:46:7"]],["mı",["68:46:1"]],["kalıyorlar",["68:46:7"]]]},
    {"ayah_ref":"68:47","baseline_text":"Yoksa görünmeyenin bilgisine onlar mı sahip de yazıp duruyorlar?","target_tokens":[["Yoksa",["68:47:1"]],["görünmeyenin",["68:47:3"]],["bilgisine",["68:47:3"]],["onlar",["68:47:2"]],["mı",["68:47:1"]],["sahip",["68:47:2","68:47:3"]],["de",["68:47:4"]],["yazıp",["68:47:5"]],["duruyorlar",["68:47:4","68:47:5"]]]},
    {"ayah_ref":"68:48","baseline_text":"Öyleyse Rabbinin hükmüne sabret; balık sahibine benzeme. Hani o, bunalmış halde seslenmişti.","target_tokens":[["Öyleyse",["68:48:1"]],["Rabbinin",["68:48:3"]],["hükmüne",["68:48:2"]],["sabret",["68:48:1"]],["balık",["68:48:7"]],["sahibine",["68:48:6"]],["benzeme",["68:48:4","68:48:5","68:48:6"]],["Hani",["68:48:8"]],["o",["68:48:10"]],["bunalmış",["68:48:11"]],["halde",["68:48:10","68:48:11"]],["seslenmişti",["68:48:9"]]]},
    {"ayah_ref":"68:49","baseline_text":"Rabbinden gelen bir nimet ona yetişmeseydi, kınanmış halde açık araziye atılacaktı.","target_tokens":[["Rabbinden",["68:49:6"]],["gelen",["68:49:5","68:49:6"]],["bir",["68:49:4"]],["nimet",["68:49:4"]],["ona",["68:49:3"]],["yetişmeseydi",["68:49:1","68:49:2","68:49:3"]],["kınanmış",["68:49:10"]],["halde",["68:49:9","68:49:10"]],["açık",["68:49:8"]],["araziye",["68:49:8"]],["atılacaktı",["68:49:7"]]]},
    {"ayah_ref":"68:50","baseline_text":"Fakat Rabbi onu seçti ve onu iyi kimselerden yaptı.","target_tokens":[["Fakat",["68:50:1"]],["Rabbi",["68:50:2"]],["onu",["68:50:1"]],["seçti",["68:50:1"]],["ve",["68:50:3"]],["onu",["68:50:3"]],["iyi",["68:50:5"]],["kimselerden",["68:50:4","68:50:5"]],["yaptı",["68:50:3"]]]},
    {"ayah_ref":"68:51","baseline_text":"İnkâr edenler öğüdü duyduklarında bakışlarıyla neredeyse seni devirecekler ve 'O kesinlikle delidir,' diyecekler.","target_tokens":[["İnkâr",["68:51:4"]],["edenler",["68:51:3","68:51:4"]],["öğüdü",["68:51:9"]],["duyduklarında",["68:51:7","68:51:8"]],["bakışlarıyla",["68:51:6"]],["neredeyse",["68:51:1","68:51:2"]],["seni",["68:51:5"]],["devirecekler",["68:51:5"]],["ve",["68:51:10"]],["O",["68:51:11"]],["kesinlikle",["68:51:11","68:51:12"]],["delidir",["68:51:12"]],["diyecekler",["68:51:10"]]]},
    {"ayah_ref":"68:52","baseline_text":"Oysa o, bütün varlıklar için yalnızca bir öğüttür.","target_tokens":[["Oysa",["68:52:1"]],["o",["68:52:2"]],["bütün",["68:52:5"]],["varlıklar",["68:52:5"]],["için",["68:52:5"]],["yalnızca",["68:52:3"]],["bir",["68:52:4"]],["öğüttür",["68:52:4"]]]}

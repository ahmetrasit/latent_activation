{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent-activation.local/cold-reader-response.schema.json",
  "title": "Cold reader staged response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reader_id",
    "focus_ref",
    "stage",
    "revealed_refs",
    "models",
    "surprise_reading"
  ],
  "properties": {
    "reader_id": {"type": "string"},
    "focus_ref": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
    "stage": {"type": "integer", "minimum": 0},
    "revealed_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
      "minItems": 1
    },
    "models": {
      "type": "array",
      "items": {"$ref": "#/$defs/model"}
    },
    "surprise_reading": {"type": "string"},
    "discarded_or_unchanged": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "status",
        "confidence",
        "mechanism",
        "activation_trace",
        "structural_cues",
        "abductive_moves",
        "changed_reading",
        "minimal_triggers",
        "ablation"
      ],
      "properties": {
        "model_id": {"type": "string"},
        "status": {
          "enum": ["provisional", "new", "strengthened", "weakened", "revised", "discarded"]
        },
        "confidence": {"enum": ["strong", "medium", "exploratory"]},
        "mechanism": {"type": "string"},
        "activation_trace": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["root", "branch_id", "literal_contribution", "assigned_role"],
            "properties": {
              "root": {"type": "string"},
              "branch_id": {"type": "string", "pattern": "^B[0-9]{3}$"},
              "literal_contribution": {"type": "string"},
              "assigned_role": {"type": "string"}
            }
          }
        },
        "structural_cues": {
          "type": "array",
          "items": {"type": "string"}
        },
        "abductive_moves": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assumption", "why_invoked", "causal_direction", "alternatives"],
            "properties": {
              "assumption": {"type": "string"},
              "why_invoked": {"type": "string"},
              "causal_direction": {"type": "string"},
              "alternatives": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          }
        },
        "changed_reading": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before", "after"],
          "properties": {
            "before": {"type": "string"},
            "after": {"type": "string"}
          }
        },
        "minimal_triggers": {
          "type": "array",
          "items": {"type": "string"}
        },
        "ablation": {"type": "string"}
      }
    }
  }
}
